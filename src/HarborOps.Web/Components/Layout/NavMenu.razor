@inject IJSRuntime JS
@inject CurrentUserAuthorizationState AuthorizationState
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@implements IDisposable

<header class="app-topbar">
	<a class="app-logo" href="/">
		<svg viewBox="0 0 190 50" class="logo-svg logo-dark" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="starGradDark" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="rgba(255,255,255,1)" />
					<stop offset="60%" stop-color="rgba(186,220,255,0.95)" />
					<stop offset="100%" stop-color="rgba(96,165,250,0.85)" />
				</linearGradient>
			</defs>
			<path transform="translate(95,13)"
				  d="M0,-12 L0.84,-2.03 L5.3,-5.3 L2.03,-0.84 L12,0 L2.03,0.84 L5.3,5.3 L0.84,2.03 L0,12 L-0.84,2.03 L-5.3,5.3 L-2.03,0.84 L-12,0 L-2.03,-0.84 L-5.3,-5.3 L-0.84,-2.03 Z"
				  fill="url(#starGradDark)" />
			<text x="95" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" letter-spacing="1">
				<tspan font-weight="600" fill="rgba(255,255,255,0.97)">Harbor</tspan><tspan font-weight="400" fill="rgba(147,197,253,0.9)">Ops</tspan>
			</text>
		</svg>

		<svg viewBox="0 0 190 50" class="logo-svg logo-light" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="starGradLight" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="rgba(37,99,235,1)" />
					<stop offset="60%" stop-color="rgba(29,78,216,0.95)" />
					<stop offset="100%" stop-color="rgba(30,64,175,0.9)" />
				</linearGradient>
			</defs>
			<path transform="translate(95,13)"
				  d="M0,-12 L0.84,-2.03 L5.3,-5.3 L2.03,-0.84 L12,0 L2.03,0.84 L5.3,5.3 L0.84,2.03 L0,12 L-0.84,2.03 L-5.3,5.3 L-2.03,0.84 L-12,0 L-2.03,-0.84 L-5.3,-5.3 L-0.84,-2.03 Z"
				  fill="url(#starGradLight)" />
			<text x="95" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" letter-spacing="1">
				<tspan font-weight="600" fill="rgba(15,23,42,0.92)">Harbor</tspan><tspan font-weight="400" fill="rgba(37,99,235,0.95)">Ops</tspan>
			</text>
		</svg>
	</a>

	<div class="app-topbar-right">
		<div class="notifications-menu">
			<button class="icon-btn" type="button" title="Notifications" aria-expanded="@showNotifications" @onclick="ToggleNotifications">
				<span class="bi bi-bell"></span>
				@if (HasCriticalAlerts)
				{
					<span class="icon-dot"></span>
				}
			</button>
			@if (showNotifications)
			{
				<div class="notifications-dropdown" role="status">
					<div class="notifications-heading">
						<strong>Notifications</strong>
						<span>All caught up</span>
					</div>
					<div class="notifications-empty">
						<span class="bi bi-bell-slash" aria-hidden="true"></span>
						<p><strong>No notifications yet</strong><small>Operational updates and alerts will appear here.</small></p>
					</div>
				</div>
			}
		</div>
		<div class="divider hide-on-mobile"></div>

		<AuthorizeView>
			<Authorized Context="authenticationState">
				<div class="profile-menu">
					<button class="profile-btn" type="button" title="Account menu" aria-expanded="@showAccountMenu" @onclick="ToggleAccountMenu">
						<div class="avatar">@authenticationState.User.Identity?.Name?[0]</div>
					</button>
					@if (showAccountMenu)
					{
						<div class="account-dropdown" role="menu">
							<div class="account-summary">
								<span>Signed in as</span>
								<strong>@authenticationState.User.Identity?.Name</strong>
							</div>
							<a href="/profile" role="menuitem" @onclick="CloseTopbarMenus"><span class="bi bi-person"></span> My Profile</a>
							<a href="/settings" role="menuitem" @onclick="CloseTopbarMenus"><span class="bi bi-gear"></span> Settings</a>
							<button type="button" role="menuitem" @onclick="OpenLogoutConfirmation"><span class="bi bi-box-arrow-right"></span> Sign out</button>
						</div>
					}
				</div>
			</Authorized>
			<NotAuthorized>
				<a class="profile-btn" href="/login"><span class="bi bi-box-arrow-in-right"></span><span class="profile-name hide-on-mobile">Sign in</span></a>
			</NotAuthorized>
		</AuthorizeView>

		<button class="hamburger-btn" @onclick="ToggleMobileMenu" aria-label="Toggle menu">
			<span class="bi @(mobileMenuOpen ? "bi-x-lg" : "bi-list")"></span>
		</button>
	</div>
</header>

@if (showAccountMenu || showNotifications)
{
	<div class="topbar-menu-backdrop" aria-hidden="true" @onclick="CloseTopbarMenus"></div>
}

<aside class="app-sidebar @(mobileMenuOpen ? "open" : string.Empty)">
	<nav class="sidebar-nav">
		<div class="nav-pills">
			<NavLink class="nav-pill" href="" title="Dashboard" Match="NavLinkMatch.All" ActiveClass="active" @onclick="CloseMobileMenu">
				<span class="bi bi-grid-1x2-fill"></span> <span class="nav-pill-label">Dashboard</span><span class="nav-pill-tooltip">Dashboard</span>
			</NavLink>
			@if (AuthorizationState.CanAccessFleet)
			{
				<NavLink class="nav-pill" href="fleet" title="Fleet" ActiveClass="active" @onclick="CloseMobileMenu">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon"><path d="M12 10.189V14"></path><path d="M12 2v3"></path><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"></path><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-8.188-3.639a2 2 0 0 0-1.624 0L3 14a11.6 11.6 0 0 0 2.81 7.76"></path><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"></path></svg>
					<span class="nav-pill-label">Fleet</span><span class="nav-pill-tooltip">Fleet</span>
				</NavLink>
			}
			@if (AuthorizationState.CanAccessCrew)
			{
				<NavLink class="nav-pill" href="crew" title="Crew" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-people-fill"></span> <span class="nav-pill-label">Crew</span><span class="nav-pill-tooltip">Crew</span></NavLink>
			}
			@if (AuthorizationState.CanAccessVoyages)
			{
				<NavLink class="nav-pill" href="voyages" title="Voyages" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-signpost-split-fill"></span> <span class="nav-pill-label">Voyages</span><span class="nav-pill-tooltip">Voyages</span></NavLink>
			}
			@if (AuthorizationState.CanAccessCargo)
			{
				<NavLink class="nav-pill" href="cargo" title="Cargo" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-box-seam-fill"></span> <span class="nav-pill-label">Cargo</span><span class="nav-pill-tooltip">Cargo</span></NavLink>
			}
			@if (AuthorizationState.CanAccessMaintenance)
			{
				<NavLink class="nav-pill" href="maintenance" title="Maintenance" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-tools"></span> <span class="nav-pill-label">Maintenance</span><span class="nav-pill-tooltip">Maintenance</span></NavLink>
			}
			@if (AuthorizationState.CanAccessCompliance)
			{
				<NavLink class="nav-pill" href="compliance" title="Compliance" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-shield-check"></span> <span class="nav-pill-label">Compliance</span><span class="nav-pill-tooltip">Compliance</span></NavLink>
			}
			@if (AuthorizationState.CanAccessDocuments)
			{
				<NavLink class="nav-pill" href="documents" title="Documents" ActiveClass="active" @onclick="CloseMobileMenu"><span class="bi bi-file-earmark-text-fill"></span> <span class="nav-pill-label">Documents</span><span class="nav-pill-tooltip">Documents</span></NavLink>
			}
			@if (AuthorizationState.CanAccessReports)
			{
				<NavLink class="nav-pill" href="reports" title="Reports" ActiveClass="active" @onclick="CloseMobileMenu">
					<span class="bi bi-bar-chart-fill"></span> <span class="nav-pill-label">Reports</span><span class="nav-pill-tooltip">Reports</span>
				</NavLink>
			}
			@if (AuthorizationState.CanManageAdministration)
			{
				<NavLink class="nav-pill" href="administration" title="Administration" ActiveClass="active" @onclick="CloseMobileMenu">
					<span class="bi bi-person-gear"></span> <span class="nav-pill-label">Administration</span><span class="nav-pill-tooltip">Administration</span>
				</NavLink>
			}
		</div>
	</nav>
</aside>

<button class="mobile-scroll-top" type="button" aria-label="Back to top" title="Back to top" @onclick="ScrollToTopAsync">
	<span class="bi bi-chevron-up" aria-hidden="true"></span>
</button>

@if (mobileMenuOpen)
{
	<div class="mobile-backdrop" @onclick="CloseMobileMenu"></div>
}

@if (showLogoutConfirmation)
{
	<div class="logout-modal-backdrop" @onclick="() => showLogoutConfirmation = false">
		<div class="logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-title" @onclick:stopPropagation="true">
			<span class="bi bi-box-arrow-right logout-modal-icon" aria-hidden="true"></span>
			<h2 id="logout-title">Sign out?</h2>
			<p>You will need to sign in again to access HarborOps.</p>
			<div class="logout-modal-actions">
				<button type="button" class="logout-cancel" @onclick="() => showLogoutConfirmation = false">Cancel</button>
				<form method="post" action="/session/logout">
					<input type="hidden" name="@antiforgeryToken.FormFieldName" value="@antiforgeryToken.RequestToken" />
					<button type="submit" class="logout-confirm">Sign out</button>
				</form>
			</div>
		</div>
	</div>
}

@code {
	private bool HasCriticalAlerts => false;
	private bool mobileMenuOpen = false;
	private bool showLogoutConfirmation;
	private bool showAccountMenu;
	private bool showNotifications;

	private Microsoft.AspNetCore.Antiforgery.AntiforgeryTokenSet antiforgeryToken = default!;

	protected override void OnInitialized()
	{
		AuthorizationState.Changed += StateHasChanged;
		var httpContext = HttpContextAccessor.HttpContext;
		if (httpContext is not null)
		{
			antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("headerScrollInterop.initialize");
		}
	}

	private Task ScrollToTopAsync() => JS.InvokeVoidAsync("scrollInterop.toTop").AsTask();

	private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
	private void CloseMobileMenu() => mobileMenuOpen = false;
	private void ToggleNotifications()
	{
		showNotifications = !showNotifications;
		showAccountMenu = false;
	}

	private void ToggleAccountMenu()
	{
		showAccountMenu = !showAccountMenu;
		showNotifications = false;
	}

	private void CloseTopbarMenus()
	{
		showAccountMenu = false;
		showNotifications = false;
	}

	private void OpenLogoutConfirmation() { showAccountMenu = false; showLogoutConfirmation = true; }

	public void Dispose()
	{
		AuthorizationState.Changed -= StateHasChanged;
	}
}
