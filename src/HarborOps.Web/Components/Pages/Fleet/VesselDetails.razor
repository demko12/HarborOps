@page "/fleet/{VesselId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessFleet")]
@using HarborOps.Web.Api.Fleet
@implements IDisposable
@inject FleetApiClient FleetApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>@(details?.Name ?? "Vessel") | HarborOps</PageTitle>

<section class="vessel-details-page">
	@if (isLoading)
	{
		<LoadingState Message="Loading vessel..." />
	}
	else if (notFound)
	{
		<EmptyState Title="Vessel not found" Message="This vessel does not exist or may have been removed." />
	}
	else if (loadFailure is not null)
	{
		<ApiErrorState Title="@loadFailure.Title" Message="@loadFailure.Message" OnRetry="LoadDetailsAsync" />
	}
	else if (details is not null)
	{
		<header class="vessel-details-header">
			<div>
				<nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="@FleetHref">Fleet operations</a><span aria-hidden="true">/</span><span>Vessel details</span></nav>
				<div class="vessel-title-row">
					<div>
						<h1>@details.Name</h1>
						<p>IMO @details.ImoNumber &middot; @details.VesselTypeName &middot; @details.FlagState</p>
					</div>
				</div>
			</div>
			<dl class="vessel-header-summary">
				<div><dt>Fleet</dt><dd>@(details.FleetName ?? "Unassigned")</dd></div>
				<div><dt>Lifecycle</dt><dd>@(details.LifecycleStage ?? "—")</dd></div>
				<div><dt>Updated</dt><dd>@FormatTimestamp(details.UpdatedAtUtc)</dd></div>
			</dl>
		</header>

		@if (registrySuccessMessage is not null || specificationsSuccessMessage is not null)
		{
			<div class="vessel-edit-flash" role="status">@(registrySuccessMessage ?? specificationsSuccessMessage)</div>
		}

		<div class="vessel-overview-grid">
			<section class="vessel-details-card vessel-operational-card" aria-labelledby="vessel-operational-title">
				<div class="vessel-card-heading">
					<div><p>Operational overview</p><h2 id="vessel-operational-title">Vessel status</h2></div>
					<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-activity"></span></span>
				</div>
				<div class="vessel-operational-state">
					<span class="vessel-status-orb @GetStatusClass(details.CurrentStatus)" aria-hidden="true"><span class="bi @GetStatusIcon(details.CurrentStatus)"></span></span>
					<div><strong>@details.CurrentStatus</strong><p>Current reported operating state</p></div>
				</div>
				<dl class="vessel-operational-facts">
					<div><dt>Fleet</dt><dd>@(details.FleetName ?? "Unassigned")</dd></div>
					<div><dt>Registry</dt><dd>@(details.PortOfRegistry ?? "—")</dd></div>
					<div><dt>Class</dt><dd>@(details.ClassificationSociety ?? "—")</dd></div>
				</dl>
			</section>

			<section class="vessel-details-card vessel-identity-card" aria-labelledby="vessel-identity-title">
				<div class="vessel-card-heading">
					<div><p>Registration</p><h2 id="vessel-identity-title">Vessel identity</h2></div>
					@if (CanManageFleet)
					{
						<button type="button" class="vessel-card-edit" @onclick="BeginRegistryEdit"><span class="bi bi-pencil" aria-hidden="true"></span>Edit</button>
					}
					else
					{
						<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-water"></span></span>
					}
				</div>
				<dl>
					<div><dt>Name</dt><dd>@details.Name</dd></div>
					<div><dt>IMO number</dt><dd>@details.ImoNumber</dd></div>
					<div><dt>MMSI</dt><dd>@(details.Mmsi ?? "—")</dd></div>
					<div><dt>Call sign</dt><dd>@(details.CallSign ?? "—")</dd></div>
					<div><dt>Flag state</dt><dd>@details.FlagState</dd></div>
					<div><dt>Vessel type</dt><dd>@details.VesselTypeName</dd></div>
					<div><dt>Port of registry</dt><dd>@(details.PortOfRegistry ?? "—")</dd></div>
					<div><dt>Classification society</dt><dd>@(details.ClassificationSociety ?? "—")</dd></div>
					<div><dt>Lifecycle stage</dt><dd>@(details.LifecycleStage ?? "—")</dd></div>
					<div><dt>MSMD identifier</dt><dd>@(details.MsmdId ?? "—")</dd></div>
				</dl>
			</section>

			<section class="vessel-details-card vessel-specifications-card" aria-labelledby="vessel-specs-title">
				<div class="vessel-card-heading">
					<div><p>Technical profile</p><h2 id="vessel-specs-title">Specifications</h2></div>
					@if (CanManageFleet)
					{
						<button type="button" class="vessel-card-edit" @onclick="BeginSpecificationsEdit"><span class="bi bi-pencil" aria-hidden="true"></span>Edit</button>
					}
					else
					{
						<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-rulers"></span></span>
					}
				</div>
				<dl>
					<div><dt>DWT</dt><dd>@FormatMeasurement(details.Dwt)</dd></div>
					<div><dt>GT</dt><dd>@FormatMeasurement(details.Gt)</dd></div>
					<div><dt>LOA</dt><dd>@FormatMeasurement(details.Loa)</dd></div>
					<div><dt>Beam</dt><dd>@FormatMeasurement(details.Beam)</dd></div>
					<div><dt>Draft</dt><dd>@FormatMeasurement(details.Draft)</dd></div>
				</dl>
			</section>

			<section class="vessel-details-card vessel-assignment-card" aria-labelledby="vessel-assignment-title">
				<div class="vessel-card-heading">
					<div><p>Organisation</p><h2 id="vessel-assignment-title">Fleet assignment</h2></div>
					<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-diagram-3"></span></span>
				</div>
				@if (details.FleetId is null)
				{
					<p class="vessel-assignment-value vessel-details-muted">Unassigned</p>
				}
				else
				{
					<p class="vessel-assignment-value"><strong>@details.FleetName</strong></p>
				}
				<p class="vessel-assignment-note">@details.FlagState &middot; @details.VesselTypeName</p>
				@if (CanManageFleet && fleets?.Items?.Count > 0)
				{
					<div class="vessel-assignment-actions">
						<select @bind="selectedFleetId" aria-label="Select fleet"><option value="">Select a fleet</option>@foreach (var fleet in fleets.Items) { <option value="@fleet.FleetId">@fleet.Name</option> }</select>
						<button type="button" @onclick="BeginAssignConfirmation" disabled="@(isAssigning || selectedFleetId is null)">@(details.FleetId is null ? "Assign" : "Reassign")</button>
						@if (details.FleetId is not null) { <button type="button" @onclick="BeginEndConfirmation" disabled="@isAssigning">Unassign</button> }
					</div>
					@if (pendingAssignmentAction is not null) { <div class="vessel-assignment-confirmation"><span>Confirm @(pendingAssignmentAction == "end" ? "unassigning this vessel" : "updating this fleet assignment")?</span><button type="button" @onclick="ConfirmAssignmentAsync">Confirm</button><button type="button" @onclick="CancelAssignmentConfirmation">Cancel</button></div> }
				}
				@if (assignmentFailure is not null) { <p class="vessel-assignment-error" role="alert">@assignmentFailure.Message</p> }
			</section>

			<section class="vessel-details-card vessel-defect-card" aria-labelledby="vessel-defect-title">
				<div class="vessel-card-heading">
					<div><p>Maintenance</p><h2 id="vessel-defect-title">Report a defect</h2></div>
					<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-exclamation-triangle"></span></span>
				</div>
				@if (CanReportDefects)
				{
					<div class="vessel-defect-content">
						<p class="vessel-assignment-note">Log a defect or fault observed on this vessel for the maintenance team to triage.</p>
						<a class="vessel-defect-action" href="@($"/maintenance/defects/report?vesselId={VesselId}")">
							<span class="bi bi-plus-circle" aria-hidden="true"></span>Report defect
						</a>
					</div>
				}
				else
				{
					<p class="vessel-details-muted">Your account does not have permission to report maintenance defects.</p>
				}
			</section>
		</div>

			@if (CanManageFleet && isEditingRegistry)
			{
				<div class="vessel-edit-modal-backdrop" @onclick="CancelRegistryEdit">
					<div class="vessel-edit-modal" role="dialog" aria-labelledby="vessel-registry-form-title" @onclick:stopPropagation="true">
						<div class="vessel-edit-modal-head">
							<div><p>Registry maintenance</p><h2 id="vessel-registry-form-title">Edit registry details</h2></div>
							<button type="button" class="vessel-edit-modal-close" aria-label="Close" @onclick="CancelRegistryEdit" disabled="@isSavingRegistry">&times;</button>
						</div>

						@if (registryFailure is { IsValidation: true, Errors.Count: > 0 })
						{
							<div class="vessel-status-alert" role="alert">
								<strong>@registryFailure.Title</strong>
								<ul>
									@foreach (var entry in registryFailure.Errors)
									{
										@foreach (var message in entry.Value)
										{
											<li>@message</li>
										}
									}
								</ul>
							</div>
						}
						else if (registryFailure is { IsConflict: true } or { IsForbidden: true })
						{
							<div class="vessel-status-alert" role="alert">
								<strong>@registryFailure.Title</strong>
								<p>@registryFailure.Message</p>
							</div>
						}
						else if (registryFailure is not null)
						{
							<ApiErrorState Title="@registryFailure.Title" Message="@registryFailure.Message" OnRetry="SubmitRegistryAsync" />
						}

						<form class="vessel-edit-form" @onsubmit="SubmitRegistryAsync" @onsubmit:preventDefault="true">
							<div class="vessel-status-field">
								<label for="vessel-registry-name">Name</label>
								<input id="vessel-registry-name" @bind="registryForm.Name" maxlength="200" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-type">Vessel type</label>
								<select id="vessel-registry-type" @bind="registryForm.VesselTypeId">
									<option value="">Select a vessel type</option>
									@foreach (var type in vesselTypes)
									{
										<option value="@type.Id">@type.Name</option>
									}
								</select>
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-mmsi">MMSI</label>
								<input id="vessel-registry-mmsi" @bind="registryForm.Mmsi" maxlength="20" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-callsign">Call sign</label>
								<input id="vessel-registry-callsign" @bind="registryForm.CallSign" maxlength="20" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-flag">Flag state</label>
								<input id="vessel-registry-flag" @bind="registryForm.FlagState" maxlength="100" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-port">Port of registry</label>
								<input id="vessel-registry-port" @bind="registryForm.PortOfRegistry" maxlength="200" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-class">Classification society</label>
								<input id="vessel-registry-class" @bind="registryForm.ClassificationSociety" maxlength="200" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-lifecycle">Lifecycle stage</label>
								<input id="vessel-registry-lifecycle" @bind="registryForm.LifecycleStage" maxlength="50" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-registry-msmd">MSMD identifier</label>
								<input id="vessel-registry-msmd" @bind="registryForm.MsmdId" maxlength="50" />
							</div>
							<dl class="vessel-immutable-facts">
								<div><dt>IMO number</dt><dd>@details.ImoNumber</dd></div>
								<div><dt>Company ID</dt><dd>@details.CompanyId</dd></div>
							</dl>
							<p class="vessel-immutable-note">IMO number and company cannot be changed here.</p>
							<div class="vessel-edit-form-actions">
								<button type="submit" class="vessel-status-button" disabled="@isSavingRegistry">@(isSavingRegistry ? "Saving..." : "Save registry details")</button>
								<button type="button" class="vessel-edit-cancel" @onclick="CancelRegistryEdit" disabled="@isSavingRegistry">Cancel</button>
							</div>
							@if (confirmRegistryCancel)
							{
								<div class="vessel-assignment-confirmation" role="alertdialog">
									<span>Discard your unsaved registry changes?</span>
									<button type="button" @onclick="CancelRegistryEdit">Discard changes</button>
									<button type="button" @onclick="KeepEditingRegistry">Keep editing</button>
								</div>
							}
						</form>
					</div>
				</div>
			}

			@if (CanManageFleet && isEditingSpecifications)
			{
				<div class="vessel-edit-modal-backdrop" @onclick="CancelSpecificationsEdit">
					<div class="vessel-edit-modal" role="dialog" aria-labelledby="vessel-specifications-form-title" @onclick:stopPropagation="true">
						<div class="vessel-edit-modal-head">
							<div><p>Technical profile</p><h2 id="vessel-specifications-form-title">Edit specifications</h2></div>
							<button type="button" class="vessel-edit-modal-close" aria-label="Close" @onclick="CancelSpecificationsEdit" disabled="@isSavingSpecifications">&times;</button>
						</div>

						@if (specificationsFailure is { IsValidation: true, Errors.Count: > 0 })
						{
							<div class="vessel-status-alert" role="alert">
								<strong>@specificationsFailure.Title</strong>
								<ul>
									@foreach (var entry in specificationsFailure.Errors)
									{
										@foreach (var message in entry.Value)
										{
											<li>@message</li>
										}
									}
								</ul>
							</div>
						}
						else if (specificationsFailure is { IsConflict: true } or { IsForbidden: true })
						{
							<div class="vessel-status-alert" role="alert">
								<strong>@specificationsFailure.Title</strong>
								<p>@specificationsFailure.Message</p>
							</div>
						}
						else if (specificationsFailure is not null)
						{
							<ApiErrorState Title="@specificationsFailure.Title" Message="@specificationsFailure.Message" OnRetry="SubmitSpecificationsAsync" />
						}

						<form class="vessel-edit-form" @onsubmit="SubmitSpecificationsAsync" @onsubmit:preventDefault="true">
							<div class="vessel-status-field">
								<label for="vessel-spec-dwt">DWT</label>
								<input id="vessel-spec-dwt" type="number" step="any" @bind="specificationsForm.Dwt" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-spec-gt">GT</label>
								<input id="vessel-spec-gt" type="number" step="any" @bind="specificationsForm.Gt" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-spec-loa">LOA</label>
								<input id="vessel-spec-loa" type="number" step="any" @bind="specificationsForm.Loa" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-spec-beam">Beam</label>
								<input id="vessel-spec-beam" type="number" step="any" @bind="specificationsForm.Beam" />
							</div>
							<div class="vessel-status-field">
								<label for="vessel-spec-draft">Draft</label>
								<input id="vessel-spec-draft" type="number" step="any" @bind="specificationsForm.Draft" />
							</div>
							<div class="vessel-edit-form-actions">
								<button type="submit" class="vessel-status-button" disabled="@isSavingSpecifications">@(isSavingSpecifications ? "Saving..." : "Save specifications")</button>
								<button type="button" class="vessel-edit-cancel" @onclick="CancelSpecificationsEdit" disabled="@isSavingSpecifications">Cancel</button>
							</div>
							@if (confirmSpecificationsCancel)
							{
								<div class="vessel-assignment-confirmation" role="alertdialog">
									<span>Discard your unsaved specification changes?</span>
									<button type="button" @onclick="CancelSpecificationsEdit">Discard changes</button>
									<button type="button" @onclick="KeepEditingSpecifications">Keep editing</button>
								</div>
							}
						</form>
					</div>
				</div>
			}

			@if (CanManageFleet)
			{
				<section class="vessel-details-card vessel-status-form-card" aria-labelledby="vessel-status-form-title">
					<div class="vessel-card-heading vessel-status-form-heading">
						<div><p>Operational update</p><h2 id="vessel-status-form-title">Record a status change</h2></div>
					</div>

					@if (submitSuccessMessage is not null)
					{
						<div class="vessel-status-success" role="status">@submitSuccessMessage</div>
					}

					@if (submitFailure is { IsValidation: true, Errors.Count: > 0 })
					{
						<div class="vessel-status-alert" role="alert">
							<strong>@submitFailure.Title</strong>
							<ul>
								@foreach (var entry in submitFailure.Errors)
								{
									@foreach (var message in entry.Value)
									{
										<li>@message</li>
									}
								}
							</ul>
						</div>
					}
					else if (submitFailure is { IsConflict: true })
					{
						<div class="vessel-status-alert" role="alert">
							<strong>@submitFailure.Title</strong>
							<p>@submitFailure.Message</p>
						</div>
					}
					else if (submitFailure is { IsForbidden: true })
					{
						<div class="vessel-status-alert" role="alert">
							<strong>@submitFailure.Title</strong>
							<p>@submitFailure.Message</p>
						</div>
					}
					else if (submitFailure is not null)
					{
						<ApiErrorState Title="@submitFailure.Title" Message="@submitFailure.Message" OnRetry="SubmitStatusChangeAsync" />
					}

					<form class="vessel-status-form" @onsubmit="SubmitStatusChangeAsync" @onsubmit:preventDefault="true">
						<div class="vessel-status-field">
							<label for="vessel-status-select">New status</label>
							<select id="vessel-status-select" @bind="selectedStatus">
								@foreach (var option in FleetStatusOptions.All)
								{
									<option value="@option">@option</option>
								}
							</select>
						</div>
						<div class="vessel-status-field">
							<label for="vessel-status-notes">Notes (optional)</label>
							<textarea id="vessel-status-notes" @bind="notes" maxlength="1000"></textarea>
						</div>
						<button class="vessel-status-button" type="submit" disabled="@isSubmitting">
							@(isSubmitting ? "Saving..." : "Save status change")
						</button>
					</form>
				</section>
			}

			<section class="vessel-details-card vessel-details-history" aria-labelledby="vessel-history-title">
				<div class="vessel-card-heading">
					<div><p>Latest activity</p><h2 id="vessel-history-title">Status history</h2></div>
					<span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-clock-history"></span></span>
				</div>
				@if (details.StatusHistory.Count == 0)
				{
					<EmptyState Title="No status changes yet" Message="Status changes will appear here once recorded." />
				}
				else
				{
					<ul class="vessel-history-list">
						@foreach (var entry in details.StatusHistory)
						{
							<li @key="entry.Id">
								<div class="vessel-history-status">
									<span class="vessel-status @GetStatusClass(entry.Status)">@entry.Status</span>
									<span class="vessel-history-when">@entry.ChangedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
								</div>
								<div class="vessel-history-meta">
									<span>@entry.ChangedBy</span>
									@if (!string.IsNullOrWhiteSpace(entry.Notes))
									{
										<p>@entry.Notes</p>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="vessel-details-card vessel-details-history" aria-labelledby="fleet-assignment-history-title">
				<div class="vessel-card-heading"><div><p>Organisation</p><h2 id="fleet-assignment-history-title">Fleet assignment history</h2></div><span class="vessel-card-icon" aria-hidden="true"><span class="bi bi-diagram-3"></span></span></div>
				@if (assignmentHistory?.Items?.Count > 0) { <ul class="vessel-history-list">@foreach (var entry in assignmentHistory.Items) { <li><div class="vessel-history-status"><strong>@entry.FleetName</strong><span class="vessel-status @(entry.IsActive ? "vessel-status-active" : "vessel-status-neutral")">@(entry.IsActive ? "Active" : "Ended")</span></div><div class="vessel-history-meta"><span>Assigned @FormatTimestamp(entry.AssignedFromUtc) @if (entry.AssignedToUtc is not null) { <text>&middot; Ended @FormatTimestamp(entry.AssignedToUtc.Value)</text> }</span></div></li> }</ul> } else { <p class="vessel-details-muted">No fleet assignments recorded.</p> }
			</section>
	}
</section>
