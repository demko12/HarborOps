@page "/fleet/fleets"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessFleet")]
@using HarborOps.Web.Api.Fleet
@implements IDisposable
@inject FleetApiClient FleetApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Fleets | HarborOps</PageTitle>
<section class="fleet-directory-page">
    <header class="fleet-directory-header"><nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/fleet">Fleet operations</a><span aria-hidden="true">/</span><span aria-current="page">Manage fleets</span></nav><h1>Fleet directory</h1><p>Create fleets, review their active vessels, and keep the operating structure current.</p></header>
    <FleetNavigation />
    @if (directory is not null && !isLoading && failure is null)
    {
        <section class="fleet-directory-summary" aria-label="Fleet structure overview">
            <article><div><span>Matching fleets</span><strong>@directory.TotalCount</strong><small>Across the current search</small></div><span class="bi bi-diagram-3" aria-hidden="true"></span></article>
            <article><div><span>Active vessels</span><strong>@directory.Items.Sum(fleet => fleet.ActiveVesselCount)</strong><small>Across the fleets shown below</small></div><span class="fleet-directory-summary-vessel" aria-hidden="true"><VesselIcon /></span></article>
            <article><div><span>Fleets without active vessels</span><strong>@directory.Items.Count(fleet => fleet.ActiveVesselCount == 0)</strong><small>Among the fleets shown below</small></div><span class="bi bi-inbox" aria-hidden="true"></span></article>
        </section>
    }

    @if (CanManage) { <section class="fleet-directory-create"><div class="fleet-directory-section-heading"><div><p class="fleet-directory-eyebrow">Fleet management</p><h2>Create a fleet</h2></div><span class="fleet-directory-icon bi bi-diagram-3" aria-hidden="true"></span></div><form @onsubmit="CreateAsync" @onsubmit:preventDefault="true"><div class="fleet-directory-field"><label for="fleet-name">Name</label><input id="fleet-name" @bind="newFleetName" maxlength="200" placeholder="e.g. Atlantic Operations Fleet" /></div><div class="fleet-directory-field"><label for="fleet-description">Description</label><input id="fleet-description" @bind="newFleetDescription" maxlength="1000" placeholder="Describe this fleet's operating scope" /></div><button type="submit" disabled="@isCreating">@(isCreating ? "Creating..." : "Create fleet")</button></form>@if (createFailure is not null) { <p class="fleet-directory-error" role="alert">@createFailure.Message</p> }</section> }
    <section class="fleet-directory-filter"><div class="fleet-directory-field"><label for="fleet-directory-search">Search</label><div class="fleet-directory-search-input"><span class="bi bi-search" aria-hidden="true"></span><input id="fleet-directory-search" @bind="search" @bind:after="SearchAsync" placeholder="Search fleets by name or description" /></div></div><button type="button" @onclick="ResetAsync" disabled="@isLoading">Reset</button></section>
    @if (isLoading) { <LoadingState Message="Loading fleets..." /> }
    else if (failure is not null) { <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="LoadAsync" /> }
    else if (directory is null || directory.Items.Count == 0) { <EmptyState Title="No fleets found" Message="Create a fleet or search with another term." /> }
    else { <section class="fleet-directory-results"><div class="fleet-directory-results-heading"><div><p class="fleet-directory-eyebrow">Fleet overview</p><h2>Fleet register</h2><p>@directory.TotalCount fleet@(directory.TotalCount == 1 ? string.Empty : "s") found</p></div></div><div class="fleet-directory-grid">@foreach (var fleet in directory.Items) { <a class="fleet-directory-card" href="@($"/fleet/fleets/{fleet.FleetId}")"><span class="fleet-directory-card-icon bi bi-diagram-3" aria-hidden="true"></span><div><h2>@fleet.Name</h2><p>@fleet.Description</p></div><dl><div><dt>Active vessels</dt><dd>@fleet.ActiveVesselCount</dd></div><div><dt>Created</dt><dd>@fleet.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</dd></div></dl><span class="bi bi-chevron-right" aria-hidden="true"></span></a> }</div></section> }
</section>
