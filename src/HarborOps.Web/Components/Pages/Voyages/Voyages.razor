@page "/voyages"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessVoyages")]
@using HarborOps.Web.Api.Voyages
@implements IDisposable
@inject VoyagesApiClient VoyagesApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Voyages | HarborOps</PageTitle>

<section class="voyages-page">
    <header class="voyages-header">
        <div>
            <p class="voyages-eyebrow">Voyage operations</p>
            <h1>Voyages</h1>
            <p>Scheduled voyages ordered by planned departure.</p>
        </div>
        <span class="voyages-utc" aria-label="All times are shown in UTC">UTC</span>
    </header>

    <nav class="voyages-tabs workspace-tabs" role="tablist" aria-label="Voyages workspace">
        <button type="button"
                role="tab"
                class="workspace-tab @(activeTab == VoyagesTab.Board ? "active" : null)"
                aria-selected="@AriaSelected(VoyagesTab.Board)"
                @onclick="() => SelectTab(VoyagesTab.Board)">Voyage board</button>
        <button type="button"
                role="tab"
                class="workspace-tab @(activeTab == VoyagesTab.Ports ? "active" : null)"
                aria-selected="@AriaSelected(VoyagesTab.Ports)"
                @onclick="() => SelectTab(VoyagesTab.Ports)">Ports</button>
        <button type="button"
                role="tab"
                class="workspace-tab @(activeTab == VoyagesTab.Berths ? "active" : null)"
                aria-selected="@AriaSelected(VoyagesTab.Berths)"
                @onclick="() => SelectTab(VoyagesTab.Berths)">Berths</button>
        <button type="button"
                role="tab"
                class="workspace-tab @(activeTab == VoyagesTab.Routes ? "active" : null)"
                aria-selected="@AriaSelected(VoyagesTab.Routes)"
                @onclick="() => SelectTab(VoyagesTab.Routes)">Routes</button>
    </nav>

    @if (activeTab == VoyagesTab.Ports)
    {
        <section class="voyages-summary-scoped" aria-label="Port summary">
            <article class="voyages-kpi">
                <div>
                    <p class="voyages-kpi-label">Ports</p>
                    <p class="voyages-kpi-value">@FormatCount(portsKpiCount)</p>
                    <p class="voyages-kpi-note">Registered in directory</p>
                </div>
                <span class="voyages-kpi-icon kpi-icon-planned" aria-hidden="true"><span class="bi bi-geo-alt-fill"></span></span>
            </article>
        </section>
    }

    @if (activeTab == VoyagesTab.Berths)
    {
        <section class="voyages-summary-scoped" aria-label="Berth summary">
            <article class="voyages-kpi">
                <div>
                    <p class="voyages-kpi-label">Berths</p>
                    <p class="voyages-kpi-value">@FormatCount(berthsKpiCount)</p>
                    <p class="voyages-kpi-note">Across all ports</p>
                </div>
                <span class="voyages-kpi-icon kpi-icon-progress" aria-hidden="true"><span class="bi bi-bounding-box"></span></span>
            </article>
        </section>
    }

    @if (activeTab == VoyagesTab.Routes)
    {
        <section class="voyages-summary-scoped" aria-label="Route summary">
            <article class="voyages-kpi">
                <div>
                    <p class="voyages-kpi-label">Routes</p>
                    <p class="voyages-kpi-value">@FormatCount(routesKpiCount)</p>
                    <p class="voyages-kpi-note">Active in the directory</p>
                </div>
                <span class="voyages-kpi-icon kpi-icon-completed" aria-hidden="true"><span class="bi bi-diagram-3-fill"></span></span>
            </article>
            <article class="voyages-kpi">
                <div>
                    <p class="voyages-kpi-label">Avg. route distance</p>
                    <p class="voyages-kpi-value">@FormatAvgDistance(avgRouteDistanceKpi)</p>
                    <p class="voyages-kpi-note">Mean of registered routes</p>
                </div>
                <span class="voyages-kpi-icon kpi-icon-delayed" aria-hidden="true"><span class="bi bi-rulers"></span></span>
            </article>
        </section>
    }

    @if (activeTab == VoyagesTab.Ports)
    {
        <PortsPanel />
    }

    @if (activeTab == VoyagesTab.Berths)
    {
        <BerthsPanel />
    }

    @if (activeTab == VoyagesTab.Routes)
    {
        <RoutesPanel />
    }

    @if (activeTab == VoyagesTab.Board)
    {
    <div class="voyages-tabpanel" role="tabpanel">

    <section class="voyages-summary" aria-label="Voyage summary">
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">Planned</p>
                <p class="voyages-kpi-value">@FormatCount(StatusCount(PlannedStatus))</p>
                <p class="voyages-kpi-note">@FormatDate(appliedFrom) &ndash; @FormatDate(appliedTo)</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-planned" aria-hidden="true"><span class="bi bi-calendar-check"></span></span>
        </article>
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">In progress</p>
                <p class="voyages-kpi-value">@FormatCount(StatusCount(InProgressStatus))</p>
                <p class="voyages-kpi-note">Departed, not yet arrived</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-progress" aria-hidden="true"><span class="bi bi-arrow-right-circle"></span></span>
        </article>
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">Completed</p>
                <p class="voyages-kpi-value">@FormatCount(StatusCount(CompletedStatus))</p>
                <p class="voyages-kpi-note">Arrival recorded</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-completed" aria-hidden="true"><span class="bi bi-check2-circle"></span></span>
        </article>
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">@DelayedStatus</p>
                <p class="voyages-kpi-value">@MissingValue</p>
                <p class="voyages-kpi-note">Not tracked yet</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-delayed" aria-hidden="true"><span class="bi bi-hourglass-split"></span></span>
        </article>
    </section>

    <div class="voyages-filters">
        <div class="filter-field filter-field-grow">
            <label for="voyages-search">Search</label>
            <div class="voyages-input-shell">
                <span class="bi bi-search" aria-hidden="true"></span>
                <input id="voyages-search" @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFiltersAsync"
                       placeholder="Voyage number" aria-label="Search voyages by voyage number" />
            </div>
        </div>
        <div class="filter-field">
            <label for="voyages-from">From</label>
            <input id="voyages-from" type="date" @bind="fromDate" @bind:after="ApplyFiltersAsync" />
        </div>
        <div class="filter-field">
            <label for="voyages-to">To</label>
            <input id="voyages-to" type="date" @bind="toDate" @bind:after="ApplyFiltersAsync" />
        </div>
        <div class="filter-field">
            <label for="voyages-status">Status</label>
            <select id="voyages-status" @bind="statusFilter" @bind:after="ApplyFiltersAsync">
                <option value="">All statuses</option>
                @foreach (var option in StatusOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="voyages-page-size">Per page</label>
            <select id="voyages-page-size" @bind="pageSize" @bind:after="ApplyFiltersAsync">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <button class="voyages-reset" type="button" @onclick="ResetFiltersAsync" disabled="@isLoading">Reset</button>
    </div>

    @if (failure is { IsValidation: true, Errors.Count: > 0 })
    {
        <div class="voyages-validation" role="alert">
            <strong>@failure.Title</strong>
            <ul>
                @foreach (var entry in failure.Errors)
                {
                    @foreach (var message in entry.Value)
                    {
                        <li>@message</li>
                    }
                }
            </ul>
        </div>
    }

    <section class="voyages-card" aria-labelledby="voyages-list-title">
        <div class="voyages-card-heading">
            <div>
                <h2 id="voyages-list-title">Voyage schedule</h2>
                <p>@totalCount voyages found</p>
            </div>
            <div class="voyages-card-tools">
                @if (CanManageVoyages)
                {
                    <a class="voyages-schedule-button" href="/voyages/schedule">
                        <span aria-hidden="true">+</span> Schedule voyage
                    </a>
                }
                <span class="voyages-card-icon" aria-hidden="true"><span class="bi bi-signpost-split-fill"></span></span>
            </div>
        </div>

        @if (actionSuccess is not null)
        {
            <div class="voyages-action-success" role="status">@actionSuccess</div>
        }

        @if (actionFailure is not null)
        {
            <div class="voyages-action-failure" role="alert">
                <strong>@actionFailure.Title</strong>
                @if (actionFailure.Errors.Count > 0)
                {
                    <ul>
                        @foreach (var entry in actionFailure.Errors)
                        {
                            @foreach (var message in entry.Value)
                            {
                                <li>@message</li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <p>@actionFailure.Message</p>
                }
            </div>
        }

        @if (isLoading)
        {
            <LoadingState Message="Loading voyages..." />
        }
        else if (failure is not null)
        {
            <ApiErrorState Title="@FailureTitle(failure)"
                           Message="@FailureMessage(failure)"
                           RetryLabel="Retry"
                           OnRetry="LoadAsync" />
        }
        else if (voyages.Count == 0)
        {
            <EmptyState Title="No voyages in this window"
                        Message="Widen the date range or clear the status filter." />

            @if (CanManageVoyages)
            {
                <div class="voyages-empty-action">
                    <a class="voyages-schedule-button" href="/voyages/schedule">
                        <span aria-hidden="true">+</span> Schedule voyage
                    </a>
                </div>
            }
        }
        else
        {
            <div class="voyages-table-scroll">
                <table class="voyages-table">
                    <thead>
                        <tr>
                            <th scope="col">Voyage</th>
                            <th scope="col" class="col-vessel">Vessel</th>
                            <th scope="col">Route</th>
                            <th scope="col">Status</th>
                            <th scope="col">Planned</th>
                            <th scope="col" class="col-actual">Actual</th>
                            @if (CanManageVoyages)
                            {
                                <th scope="col">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var utcNow = DateTime.UtcNow;
                        }
                        @foreach (var voyage in voyages)
                        {
                            var isImminent = IsImminentDeparture(voyage.PlannedDeparture, utcNow);

                            <tr @key="voyage.VoyageId"
                                class="@(isImminent ? "imminent" : null)"
                                title="@(isImminent ? "Departs within 24 hours" : null)">
                                <td class="voyage-number">@voyage.VoyageNumber</td>
                                <td class="voyage-vessel col-vessel" title="@voyage.VesselId">@FormatVesselReference(voyage.VesselId)</td>
                                <td class="voyage-route">@FormatRoute(voyage.DeparturePortCode, voyage.ArrivalPortCode)</td>
                                <td>
                                    <span class="voyage-status @StatusModifier(voyage.Status)">@voyage.Status</span>
                                    <span class="voyage-steps @StatusModifier(voyage.Status)"
                                          role="img"
                                          aria-label="@($"Step {StatusStep(voyage.Status)} of 3")">
                                        @for (var step = 1; step <= 3; step++)
                                        {
                                            <i class="@(step <= StatusStep(voyage.Status) ? "on" : null)"></i>
                                        }
                                    </span>
                                </td>
                                <td class="voyage-stamps">
                                    <span><b>DEP</b>@FormatUtc(voyage.PlannedDeparture)</span>
                                    <span><b>ARR</b>@FormatUtc(voyage.PlannedArrival)</span>
                                </td>
                                <td class="voyage-stamps col-actual">
                                    <span class="@(voyage.ActualDeparture is null ? "missing" : null)"><b>DEP</b>@FormatUtc(voyage.ActualDeparture)</span>
                                    <span class="@(voyage.ActualArrival is null ? "missing" : null)"><b>ARR</b>@FormatUtc(voyage.ActualArrival)</span>
                                </td>
                                @if (CanManageVoyages)
                                {
                                    <td class="voyage-actions">
                                        @if (actionVoyageId == voyage.VoyageId)
                                        {
                                            <div class="voyage-action-form" @onkeydown="HandleActionKeyDown">
                                                <label for="voyage-action-date">@ActionLabel(actionKind!, actionVoyageNumber)</label>
                                                <div class="voyage-action-stamp">
                                                    <input id="voyage-action-date" type="date" @bind="actionDate"
                                                           @ref="actionDateInput"
                                                           min="@(actionMinDate is { } earliest ? FormatIsoDate(earliest) : null)"
                                                           max="@FormatIsoDate(actionMaxDate)" />
                                                    <input id="voyage-action-time" type="time" @bind="actionTime"
                                                           aria-label="Time in UTC" />
                                                </div>
                                                <div class="voyage-action-buttons">
                                                    <button class="voyages-button" type="button"
                                                            @onclick="ConfirmActionAsync" disabled="@isActionSubmitting">
                                                        @(isActionSubmitting ? "Saving..." : "Confirm")
                                                    </button>
                                                    <button class="voyages-reset" type="button"
                                                            @onclick="CancelAction" disabled="@isActionSubmitting">Cancel</button>
                                                </div>
                                            </div>
                                        }
                                        else if (CanDepart(voyage.Status))
                                        {
                                            <button class="voyages-row-action" type="button"
                                                    @onclick="() => BeginAction(voyage, DepartAction)">Depart</button>
                                        }
                                        else if (CanArrive(voyage.Status))
                                        {
                                            <button class="voyages-row-action" type="button"
                                                    @onclick="() => BeginAction(voyage, ArriveAction)">Arrive</button>
                                        }
                                        else
                                        {
                                            <span class="voyage-actions-none" aria-hidden="true">@MissingValue</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="voyages-pagination">
                <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount voyages</span>
                <div>
                    <button type="button" @onclick="GoToPreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
                    <span class="voyages-page-indicator">Page @pageNumber of @TotalPages</span>
                    <button type="button" @onclick="GoToNextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
                </div>
            </div>
        }
    </section>

    </div>
    }
</section>
