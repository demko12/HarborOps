@page "/voyages/{VoyageId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessVoyages")]
@using HarborOps.Web.Api.Voyages
@implements IDisposable
@inject VoyagesApiClient VoyagesApi
@inject CurrentUserAuthorizationState AuthorizationState
@inject IJSRuntime JS

<PageTitle>Voyage timeline | HarborOps</PageTitle>

<section class="timeline-page">
    <header class="timeline-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="@BoardHref">Voyages</a><span aria-hidden="true">/</span><span>Timeline</span></nav>
            <h1>Voyage timeline</h1>
            <p class="timeline-voyage-cell">
                <code class="timeline-voyage" title="@VoyageId">@VoyageId</code>
                <button type="button"
                        class="timeline-copy"
                        title="@(voyageIdCopied ? "Copied" : "Copy voyage ID")"
                        aria-label="Copy voyage ID"
                        @onclick="CopyVoyageIdAsync">
                    <span class="bi @(voyageIdCopied ? "bi-check2" : "bi-clipboard")" aria-hidden="true"></span>
                </button>
            </p>
        </div>
        <span class="timeline-utc" aria-label="All times are shown in UTC">UTC</span>
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Loading the voyage timeline..." />
    }
    else if (failure is { IsNotFound: true })
    {
        <EmptyState Title="Voyage not found"
                    Message="This voyage is no longer available. Return to the board to pick another one." />
    }
    else if (failure is { IsForbidden: true })
    {
        <EmptyState Title="You cannot view this voyage"
                    Message="Your account does not carry a voyages permission. Ask an administrator for access." />
    }
    else if (failure is not null)
    {
        <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
    }
    else if (itinerary is not null)
    {
        <section class="timeline-summary" aria-label="Timeline summary">
            <article class="timeline-kpi">
                <div>
                    <p class="timeline-kpi-label">Stops</p>
                    <p class="timeline-kpi-value">@itinerary.Stops.Count</p>
                    <p class="timeline-kpi-note">@CompletedStopCount(itinerary) departed</p>
                </div>
                <span class="timeline-kpi-icon kpi-icon-stops" aria-hidden="true"><span class="bi bi-geo-alt-fill"></span></span>
            </article>
            <article class="timeline-kpi">
                <div>
                    <p class="timeline-kpi-label">Total delay</p>
                    <p class="timeline-kpi-value">@TotalDelayMinutes(itinerary) min</p>
                    <p class="timeline-kpi-note">@itinerary.Delays.Count recorded</p>
                </div>
                <span class="timeline-kpi-icon kpi-icon-delay" aria-hidden="true"><span class="bi bi-hourglass-split"></span></span>
            </article>
        </section>

        <section class="timeline-card timeline-route-map" aria-labelledby="timeline-route-map-title">
            <div class="timeline-card-heading">
                <div>
                    <p class="timeline-eyebrow">Voyage plan</p>
                    <h2 id="timeline-route-map-title">Route map</h2>
                </div>
                <div class="timeline-map-actions">
                    <span class="timeline-count">@MappedStops.Count / @itinerary.Stops.Count mapped stops</span>
                    @if (MappedStops.Count >= 2)
                    {
                        <button class="timeline-map-reset" type="button" @onclick="FitRouteMapAsync"><span class="bi bi-arrows-fullscreen" aria-hidden="true"></span> Fit route</button>
                    }
                </div>
            </div>
            @if (MappedStops.Count < 2)
            {
                <p class="timeline-route-empty">Add coordinates to at least two itinerary ports to show the route.</p>
            }
            else
            {
                <div class="timeline-map-shell" aria-label="Planned route across @MappedStops.Count port calls">
                    <div class="timeline-map" @ref="routeMapElement" aria-label="Interactive world route map"></div>
                    <div class="timeline-map-caption">
                        <span><span class="bi bi-signpost-split" aria-hidden="true"></span> Schematic route · port call sequence</span>
                        <span class="timeline-map-status-key"><i class="planned" aria-hidden="true"></i> Planned <i class="arrived" aria-hidden="true"></i> Arrived <i class="departed" aria-hidden="true"></i> Departed</span>
                    </div>
                </div>
                <ol class="timeline-map-legend" aria-label="Mapped ports in itinerary order">
                    @foreach (var stop in MappedStops)
                    {
                        <li>
                            <span class="timeline-map-legend-marker @StatusModifier(stop.Status)">@stop.StopOrder</span>
                            <span><strong>@stop.PortName</strong><small>@stop.PortCountry · @stop.Status</small></span>
                        </li>
                    }
                </ol>
            }
        </section>

        @if (actionSuccess is not null)
        {
            <div class="timeline-action-success" role="status">@actionSuccess</div>
        }

        <section class="timeline-card" aria-labelledby="timeline-stops-title">
            <div class="timeline-card-heading">
                <h2 id="timeline-stops-title">Port calls</h2>
                <span class="timeline-count">@itinerary.Stops.Count stops</span>
            </div>

            @if (itinerary.Stops.Count == 0)
            {
                <EmptyState Title="No itinerary planned"
                            Message="Plan an itinerary for this voyage to start executing port calls." />

                @if (CanManageVoyages)
                {
                    <div class="timeline-plan-itinerary-actions">
                        <button class="timeline-submit" type="button" @onclick="OpenItineraryModal">Plan itinerary</button>
                    </div>
                }
            }
            else
            {
                <div class="timeline-table-scroll">
                    <table class="timeline-table">
                        <caption class="visually-hidden">Port calls in itinerary order</caption>
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Port</th>
                                <th scope="col">Berth</th>
                                <th scope="col">Status</th>
                                <th scope="col">Estimates</th>
                                <th scope="col">Actual</th>
                                <th scope="col">Clearance</th>
                                @if (CanManageVoyages)
                                {
                                    <th scope="col">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stop in itinerary.Stops)
                            {
                                <tr @key="stop.StopId">
                                    <td class="timeline-num">@stop.StopOrder</td>
                                    <td>
                                        <span class="timeline-port-name">@stop.PortName</span>
                                        <span class="timeline-port-country">@stop.PortCountry@(stop.UnLocode is null ? null : $" · {stop.UnLocode}")</span>
                                    </td>
                                    <td>
                                        <span class="timeline-berth-name">@(stop.BerthName ?? MissingValue)</span>
                                        <span class="timeline-berth-state">@BerthState(stop)</span>
                                    </td>
                                    <td>
                                        <span class="timeline-status @StatusModifier(stop.Status)">@stop.Status</span>
                                    </td>
                                    <td class="timeline-stamps">
                                        @{
                                            var revisedStop = RevisedStop(stop.StopId);
                                        }
                                        <span class="@(revisedStop is null ? null : "superseded")"><b>ETA</b>@FormatUtc(stop.Eta)</span>
                                        <span class="@(revisedStop is null ? null : "superseded")"><b>ETD</b>@FormatUtc(stop.Etd)</span>
                                        @if (revisedStop is not null)
                                        {
                                            <span class="timeline-revised"><b>Revised ETA</b>@FormatUtc(revisedStop.RevisedEta)</span>
                                            <span class="timeline-revised"><b>Revised ETD</b>@FormatUtc(revisedStop.RevisedEtd)</span>
                                        }
                                    </td>
                                    <td class="timeline-stamps">
                                        <span class="@(stop.Ata is null ? "missing" : null)"><b>ATA</b>@FormatUtc(stop.Ata)</span>
                                        <span class="@(stop.Atd is null ? "missing" : null)"><b>ATD</b>@FormatUtc(stop.Atd)</span>
                                        @if (ActivitySummaryLabel(stop) is { } activitySummary)
                                        {
                                            <span class="timeline-activity-summary @ActivitySummaryModifier(stop)"
                                                  data-testid="timeline-activity-summary">
                                                @activitySummary
                                            </span>
                                        }
                                        <button type="button"
                                                class="timeline-activity-toggle"
                                                data-testid="timeline-activity-toggle"
                                                aria-expanded="@(activityStopId == stop.StopId ? "true" : "false")"
                                                @onclick="() => ToggleActivityLog(stop)">
                                            <span class="bi bi-list-check" aria-hidden="true"></span>
                                            @(activityStopId == stop.StopId ? "Hide activity log" : "Activity log")
                                        </button>
                                    </td>
                                    <td class="timeline-clearance">
                                        <span class="timeline-clearance-status @ClearanceStatusModifier(stop)"
                                              data-testid="timeline-clearance-status">
                                            @ClearanceStatusLabel(stop)
                                        </span>
                                        <span class="timeline-clearance-progress" data-testid="timeline-clearance-progress">
                                            @ClearanceProgressLabel(stop)
                                        </span>
                                        @if (stop.ClearanceOverdueRequiredItemCount > 0)
                                        {
                                            <span class="timeline-clearance-overdue" data-testid="timeline-clearance-overdue">
                                                @stop.ClearanceOverdueRequiredItemCount overdue
                                            </span>
                                        }
                                        <button type="button"
                                                class="timeline-clearance-toggle"
                                                data-testid="timeline-clearance-toggle"
                                                aria-expanded="@(clearanceStopId == stop.StopId ? "true" : "false")"
                                                @onclick="() => ToggleClearance(stop)">
                                            @(clearanceStopId == stop.StopId ? "Hide clearance" : "View clearance")
                                        </button>
                                    </td>
                                    @if (CanManageVoyages)
                                    {
                                        <td class="timeline-actions">
                                            @if (activeStopId == stop.StopId && activeActionKind == BerthActionKind)
                                            {
                                                <div class="timeline-action-form" @onkeydown="args => CancelAction(args)">
                                                    <label for="timeline-berth-select">@(stop.BerthId is null ? "Assign berth" : "Reschedule berth")</label>
                                                    <div class="timeline-allocation-grid">
                                                        <BerthPicker InputId="timeline-berth-select"
                                                                     PortId="@(activeStopPortId ?? stop.PortId)"
                                                                     Value="selectedBerthId"
                                                                     ValueChanged="value => selectedBerthId = value" />
                                                        <div class="timeline-action-stamp">
                                                            <input id="timeline-berth-arrival-date" type="date" aria-label="Planned arrival date" @bind="berthArrivalDate" />
                                                            <input id="timeline-berth-arrival-time" type="time" aria-label="Planned arrival time" @bind="berthArrivalTime" />
                                                        </div>
                                                        <div class="timeline-action-stamp">
                                                            <input id="timeline-berth-departure-date" type="date" aria-label="Planned departure date" @bind="berthDepartureDate" />
                                                            <input id="timeline-berth-departure-time" type="time" aria-label="Planned departure time" @bind="berthDepartureTime" />
                                                        </div>
                                                        <input id="timeline-berth-reason" aria-label="Reason for rescheduling" @bind="berthReason" placeholder="Reason for rescheduling" />
                                                    </div>
                                                    @if (isLoadingBerthAvailability)
                                                    {
                                                        <p class="timeline-availability-note" role="status">Finding compatible berths…</p>
                                                    }
                                                    else if (berthAvailabilityFailure is not null)
                                                    {
                                                        <div class="timeline-inline-error" role="alert">@berthAvailabilityFailure.Message <button type="button" class="timeline-inline-retry" @onclick="() => LoadBerthAllocationContextAsync(stop)">Retry</button></div>
                                                    }
                                                    else if (berthAvailability is not null)
                                                    {
                                                        <div class="timeline-alternatives" aria-label="Compatible berth alternatives">
                                                            @foreach (var berth in berthAvailability.Berths ?? [])
                                                            {
                                                                <button type="button" class="timeline-alternative @(berth.IsAvailableForRequestedWindow ? "available" : "conflict")" @onclick="() => UseAlternative(berth)">
                                                                    <strong>@berth.BerthName</strong>
                                                                    <span>@(berth.IsAvailableForRequestedWindow ? "Available for requested window" : berth.NearestAvailableFromUtc is { } availableFrom ? $"Next free {FormatUtc(availableFrom)}" : "No free window within 31 days")</span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    @if (berthAllocationHistory is { Changes.Count: > 0 })
                                                    {
                                                        <details class="timeline-allocation-history">
                                                            <summary>Allocation history (@berthAllocationHistory.Changes.Count)</summary>
                                                            @foreach (var change in berthAllocationHistory.Changes)
                                                            {
                                                                <p><strong>@(change.PreviousBerthName ?? MissingValue) → @change.NewBerthName</strong><span>@FormatUtc(change.ChangedAtUtc) · @change.Reason</span></p>
                                                            }
                                                        </details>
                                                    }
                                                    @if (actionFailure is not null)
                                                    {
                                                        <p class="timeline-inline-error" role="alert">@(actionFailure.Errors.Count > 0 ? string.Join(" ", actionFailure.Errors.SelectMany(entry => entry.Value)) : actionFailure.Message)</p>
                                                    }
                                                    <div class="timeline-action-buttons">
                                                        <button class="timeline-button" type="button" @onclick="ConfirmBerthAsync" disabled="@(isActionSubmitting || selectedBerthId is null || (IsReschedulingActiveStop && string.IsNullOrWhiteSpace(berthReason)))">
                                                            @(isActionSubmitting ? "Saving..." : "Confirm")
                                                        </button>
                                                        <button class="timeline-reset" type="button" @onclick="() => CancelAction(null)" disabled="@isActionSubmitting">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                            else if (activeStopId == stop.StopId && (activeActionKind == ArriveActionKind || activeActionKind == DepartActionKind))
                                            {
                                                <div class="timeline-action-form" @onkeydown="args => CancelAction(args)">
                                                    <label for="timeline-action-date">@(activeActionKind == ArriveActionKind ? "Actual arrival (UTC)" : "Actual departure (UTC)")</label>
                                                    <div class="timeline-action-stamp">
                                                        <input id="timeline-action-date" type="date" @bind="actionDate" max="@DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd")" />
                                                        <input id="timeline-action-time" type="time" @bind="actionTime" aria-label="Time in UTC" />
                                                    </div>
                                                    @if (actionFailure is not null)
                                                    {
                                                        <p class="timeline-inline-error" role="alert">@(actionFailure.Errors.Count > 0 ? string.Join(" ", actionFailure.Errors.SelectMany(entry => entry.Value)) : actionFailure.Message)</p>
                                                    }
                                                    <div class="timeline-action-buttons">
                                                        <button class="timeline-button" type="button" @onclick="ConfirmStopActionAsync" disabled="@isActionSubmitting">
                                                            @(isActionSubmitting ? "Saving..." : "Confirm")
                                                        </button>
                                                        <button class="timeline-reset" type="button" @onclick="() => CancelAction(null)" disabled="@isActionSubmitting">Cancel</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="timeline-row-actions">
                                                    @if (CanAssignBerth(stop))
                                                    {
                                                        <button class="timeline-row-action" type="button" @onclick="() => BeginBerthAction(stop)">@(stop.BerthId is null ? "Assign berth" : "Change berth")</button>
                                                    }
                                                    @if (CanArrive(stop))
                                                    {
                                                        <button class="timeline-row-action" type="button" @onclick="() => BeginStopAction(stop, ArriveActionKind)">Arrive</button>
                                                    }
                                                    @if (CanDepart(stop))
                                                    {
                                                        <button class="timeline-row-action"
                                                                type="button"
                                                                data-testid="timeline-depart"
                                                                disabled="@IsDepartureBlockedByClearance(stop)"
                                                                title="@(IsDepartureBlockedByClearance(stop) ? DepartureBlockedExplanation(stop) : null)"
                                                                @onclick="() => BeginStopAction(stop, DepartActionKind)">
                                                            Depart
                                                        </button>
                                                        @if (IsDepartureBlockedByClearance(stop))
                                                        {
                                                            <span class="timeline-departure-blocked" data-testid="timeline-departure-blocked">
                                                                @DepartureBlockedExplanation(stop)
                                                            </span>
                                                        }
                                                    }
                                                    @if (!CanAssignBerth(stop) && !CanArrive(stop) && !CanDepart(stop))
                                                    {
                                                        <span class="timeline-actions-none" aria-hidden="true">@MissingValue</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>

                                @if (clearanceStopId == stop.StopId)
                                {
                                    <tr class="timeline-clearance-row">
                                        <td colspan="@(CanManageVoyages ? 8 : 7)">
                                            <PortCallClearancePanel VoyageId="VoyageId"
                                                                    VesselId="itinerary.VesselId"
                                                                    StopId="stop.StopId"
                                                                    StopStatus="@stop.Status"
                                                                    StopDepartedAtUtc="stop.Atd"
                                                                    OnChanged="LoadAsync"
                                                                    OnClose="CloseClearance" />
                                        </td>
                                    </tr>
                                }

                                @if (activityStopId == stop.StopId)
                                {
                                    <tr class="timeline-clearance-row" data-testid="timeline-activity-row">
                                        <td colspan="@(CanManageVoyages ? 8 : 7)">
                                            <PortCallActivityPanel VoyageId="VoyageId"
                                                                   StopId="stop.StopId"
                                                                   OnChanged="RefreshItineraryAsync"
                                                                   OnClose="CloseActivityLog" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="timeline-card" aria-labelledby="timeline-delays-title">
            <div class="timeline-card-heading">
                <h2 id="timeline-delays-title">Delays</h2>
                <span class="timeline-count">@itinerary.Delays.Count recorded</span>
            </div>

            @if (CanManageVoyages)
            {
                <div class="timeline-delay-form">
                    @if (delayFailure is not null)
                    {
                        <div class="timeline-form-error" role="alert">
                            <strong>@delayFailure.Title</strong>
                            @if (delayFailure.Errors.Count > 0)
                            {
                                <ul>
                                    @foreach (var entry in delayFailure.Errors)
                                    {
                                        @foreach (var message in entry.Value)
                                        {
                                            <li>@message</li>
                                        }
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>@delayFailure.Message</p>
                            }
                        </div>
                    }

                    @if (delaySuccess is not null)
                    {
                        <div class="timeline-action-success" role="status">@delaySuccess</div>
                    }

                    <div class="timeline-form-grid">
                        <div class="timeline-field">
                            <label for="delay-reason">Reason</label>
                            <input id="delay-reason" @bind="delayReason" placeholder="Port congestion" />
                        </div>
                        <div class="timeline-field">
                            <label for="delay-duration">Duration (minutes)</label>
                            <input id="delay-duration" type="number" min="1" @bind="delayDurationMinutes" />
                        </div>
                        <div class="timeline-field">
                            <label for="delay-stop">Applies to</label>
                            <select id="delay-stop" @bind="delayStopSelection">
                                <option value="">Voyage-level</option>
                                @foreach (var stop in itinerary.Stops)
                                {
                                    <option value="@stop.StopId">Stop @stop.StopOrder — @stop.PortName</option>
                                }
                            </select>
                        </div>
                        <div class="timeline-field timeline-field-wide">
                            <label for="delay-description">Description (optional)</label>
                            <input id="delay-description" @bind="delayDescription" placeholder="Additional context" />
                        </div>
                    </div>

                    <div class="timeline-form-actions">
                        <button class="timeline-submit" type="button" @onclick="SubmitDelayAsync" disabled="@isSubmittingDelay">
                            @(isSubmittingDelay ? "Recording..." : "Record delay")
                        </button>
                    </div>
                </div>
            }

            @if (itinerary.Delays.Count == 0)
            {
                <EmptyState Title="No delays recorded"
                            Message="Delays reported for this voyage or its stops will appear here." />
            }
            else
            {
                <div class="timeline-table-scroll">
                    <table class="timeline-table">
                        <caption class="visually-hidden">Delays recorded for this voyage</caption>
                        <thead>
                            <tr>
                                <th scope="col">Reason</th>
                                <th scope="col">Applies to</th>
                                <th scope="col">Duration</th>
                                <th scope="col">Recorded (UTC)</th>
                                <th scope="col">Description</th>
                                <th scope="col">Downstream impact</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var delay in itinerary.Delays)
                            {
                                <tr @key="delay.DelayId">
                                    <td>@delay.Reason</td>
                                    <td>@DelaySourceLabel(itinerary, delay)</td>
                                    <td class="timeline-num">@delay.Duration min</td>
                                    <td>@FormatUtc(delay.CreatedAt)</td>
                                    <td>@(delay.Description ?? MissingValue)</td>
                                    <td class="timeline-actions">
                                        @if (IsDelayApplied(delay.DelayId))
                                        {
                                            <span class="timeline-impact-applied">Applied</span>
                                        }
                                        else if (CanManageVoyages)
                                        {
                                            <button class="timeline-row-action"
                                                    type="button"
                                                    disabled="@(isLoadingImpact || isApplyingImpact)"
                                                    @onclick="() => BeginImpactAsync(delay)">
                                                Assess impact
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="timeline-actions-none" aria-hidden="true">@MissingValue</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (impactDelayId is not null)
        {
            <section class="timeline-card timeline-impact" aria-labelledby="timeline-impact-title">
                <div class="timeline-card-heading">
                    <h2 id="timeline-impact-title">Delay impact</h2>
                    @if (impactPreview is not null)
                    {
                        <span class="timeline-count">@impactPreview.Stops.Count stops affected</span>
                    }
                </div>

                @if (isLoadingImpact)
                {
                    <LoadingState Message="Assessing the downstream impact..." />
                }
                else
                {
                    @if (impactFailure is not null)
                    {
                        <div class="timeline-form-error" role="alert">
                            <strong>@impactFailure.Title</strong>
                            @if (impactFailure.Errors.Count > 0)
                            {
                                <ul>
                                    @foreach (var entry in impactFailure.Errors)
                                    {
                                        @foreach (var message in entry.Value)
                                        {
                                            <li>@message</li>
                                        }
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>@impactFailure.Message</p>
                            }
                        </div>
                    }

                    @if (impactPreview is null)
                    {
                        <div class="timeline-form-actions">
                            <button class="timeline-reset" type="button" @onclick="CancelImpact">Close</button>
                        </div>
                    }
                    else
                    {
                        <dl class="timeline-impact-summary">
                            <div>
                                <dt>Recorded delay</dt>
                                <dd>@impactPreview.DelayMinutes min</dd>
                            </div>
                            <div>
                                <dt>Planned arrival</dt>
                                <dd>@FormatUtc(impactPreview.PlannedArrival)</dd>
                            </div>
                            <div>
                                <dt>Proposed arrival</dt>
                                <dd>@FormatUtc(impactPreview.ProposedArrival) (@FormatDelta(impactPreview.PlannedArrivalDeltaMinutes))</dd>
                            </div>
                        </dl>

                        @if (impactPreview.Warnings.Count > 0)
                        {
                            <div class="timeline-impact-warnings" role="alert">
                                <strong>Berth conflicts</strong>
                                <ul>
                                    @foreach (var warning in impactPreview.Warnings)
                                    {
                                        <li @key="@($"{warning.StopId}-{warning.BerthId}-{warning.ConflictStart:O}")">
                                            Stop @warning.StopOrder overlaps berth @warning.BerthName between @FormatUtc(warning.ConflictStart) and @FormatUtc(warning.ConflictEnd).
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (impactPreview.Stops.Count == 0)
                        {
                            <EmptyState Title="No downstream stops"
                                        Message="This delay does not move any remaining port call." />
                            <div class="timeline-form-actions">
                                <button class="timeline-reset" type="button" @onclick="CancelImpact">Close</button>
                            </div>
                        }
                        else
                        {
                            <div class="timeline-table-scroll">
                                <table class="timeline-table">
                                    <caption class="visually-hidden">Proposed estimate changes per stop</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Port</th>
                                            <th scope="col">Current</th>
                                            <th scope="col">Proposed</th>
                                            <th scope="col">Shift</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stop in impactPreview.Stops)
                                        {
                                            <tr @key="stop.StopId">
                                                <td class="timeline-num">@stop.StopOrder</td>
                                                <td>@stop.PortName</td>
                                                <td class="timeline-stamps">
                                                    <span><b>ETA</b>@FormatUtc(stop.CurrentEta)</span>
                                                    <span><b>ETD</b>@FormatUtc(stop.CurrentEtd)</span>
                                                </td>
                                                <td class="timeline-stamps">
                                                    <span class="timeline-revised"><b>ETA</b>@FormatUtc(stop.ProposedEta)</span>
                                                    <span class="timeline-revised"><b>ETD</b>@FormatUtc(stop.ProposedEtd)</span>
                                                </td>
                                                <td class="timeline-stamps">
                                                    <span><b>ETA</b>@FormatDelta(stop.EtaDeltaMinutes)</span>
                                                    <span><b>ETD</b>@FormatDelta(stop.EtdDeltaMinutes)</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="timeline-form-grid">
                                <div class="timeline-field timeline-field-wide">
                                    <label for="impact-reason">Reason</label>
                                    <input id="impact-reason" @bind="impactReason" placeholder="Downstream schedule revised after port congestion" />
                                </div>
                            </div>

                            <div class="timeline-form-actions">
                                <button class="timeline-submit" type="button" @onclick="ApplyImpactAsync" disabled="@isApplyingImpact">
                                    @(isApplyingImpact ? "Publishing..." : "Publish revised estimates")
                                </button>
                                <button class="timeline-reset" type="button" @onclick="CancelImpact" disabled="@isApplyingImpact">Cancel</button>
                            </div>
                        }
                    }
                }
            </section>
        }

        <section class="timeline-card" aria-labelledby="timeline-revisions-title">
            <div class="timeline-card-heading">
                <h2 id="timeline-revisions-title">Estimate revisions</h2>
                <span class="timeline-count">@(estimateRevisions?.Revisions.Count ?? 0) published</span>
            </div>

            @if (impactSuccess is not null)
            {
                <div class="timeline-action-success" role="status">@impactSuccess</div>
            }

            @if (alertFailure is not null)
            {
                <div class="timeline-form-error" role="alert">
                    <strong>@alertFailure.Title</strong>
                    <p>@alertFailure.Message</p>
                </div>
            }

            @if (estimateRevisionsFailure is not null)
            {
                <ApiErrorState Title="@estimateRevisionsFailure.Title"
                               Message="@estimateRevisionsFailure.Message"
                               OnRetry="LoadEstimateRevisionsAsync" />
            }
            else if (estimateRevisions is null || estimateRevisions.Revisions.Count == 0)
            {
                <EmptyState Title="No revised estimates"
                            Message="Applying a delay impact publishes revised ETAs and ETDs here." />
            }
            else
            {
                <ol class="timeline-schedule-changes">
                    @foreach (var revision in estimateRevisions.Revisions)
                    {
                        <li class="timeline-schedule-change" @key="revision.RevisionBatchId">
                            <div class="timeline-schedule-change-heading">
                                <span class="timeline-status amended">Estimates revised</span>
                                <span class="timeline-schedule-change-time">@FormatUtc(revision.RevisedAtUtc)</span>
                                <code class="timeline-schedule-change-actor" title="@revision.RevisedByUserId">@FormatActor(revision.RevisedByUserId)</code>
                                @if (revision.AlertCreated)
                                {
                                    <span class="timeline-alert-state sent">Alert sent</span>
                                }
                                else
                                {
                                    <span class="timeline-alert-state failed">Alert not sent</span>
                                    @if (CanManageVoyages)
                                    {
                                        <button class="timeline-row-action"
                                                type="button"
                                                disabled="@(retryingRevisionBatchId == revision.RevisionBatchId)"
                                                @onclick="() => RetryAlertAsync(revision.RevisionBatchId)">
                                            @(retryingRevisionBatchId == revision.RevisionBatchId ? "Resending..." : "Retry alert")
                                        </button>
                                    }
                                }
                            </div>
                            <p class="timeline-schedule-change-reason">@revision.Reason</p>
                            <ul class="timeline-schedule-change-fields">
                                @foreach (var change in revision.Changes)
                                {
                                    <li @key="change.StopId">
                                        <span class="timeline-schedule-change-label">Stop @change.StopOrder — @change.PortName</span>
                                        <span class="timeline-schedule-change-old">@FormatUtc(change.PreviousEta) → @FormatUtc(change.PreviousEtd)</span>
                                        <span class="timeline-schedule-change-arrow" aria-hidden="true">→</span>
                                        <span class="timeline-schedule-change-new">@FormatUtc(change.NewEta) → @FormatUtc(change.NewEtd)</span>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ol>
            }
        </section>

        <section class="timeline-card" aria-labelledby="timeline-schedule-title">
            <div class="timeline-card-heading">
                <h2 id="timeline-schedule-title">Schedule</h2>
                @if (schedule is not null)
                {
                    <span class="timeline-status @VoyageStatusModifier(schedule.Voyage.Status)">@schedule.Voyage.Status</span>
                }
            </div>

            @if (scheduleFailure is { IsForbidden: true })
            {
                <EmptyState Title="You cannot view schedule changes"
                            Message="Your account does not carry a voyages read permission. Ask an administrator for access." />
            }
            else if (scheduleFailure is not null)
            {
                <ApiErrorState Title="@scheduleFailure.Title"
                               Message="@scheduleFailure.Message"
                               RetryLabel="Retry"
                               OnRetry="LoadScheduleAsync" />
            }
            else if (schedule is not null)
            {
                <dl class="timeline-schedule-grid">
                    <div>
                        <dt>Voyage number</dt>
                        <dd>@schedule.Voyage.VoyageNumber</dd>
                    </div>
                    <div>
                        <dt>Departure port</dt>
                        <dd>@(schedule.Voyage.DeparturePortName ?? MissingValue)</dd>
                    </div>
                    <div>
                        <dt>Arrival port</dt>
                        <dd>@(schedule.Voyage.ArrivalPortName ?? MissingValue)</dd>
                    </div>
                    <div>
                        <dt>Route</dt>
                        <dd>@(schedule.Voyage.RouteName ?? MissingValue)</dd>
                    </div>
                    <div>
                        <dt>Planned departure (UTC)</dt>
                        <dd>@FormatUtc(schedule.Voyage.PlannedDeparture)</dd>
                    </div>
                    <div>
                        <dt>Planned arrival (UTC)</dt>
                        <dd>@FormatUtc(schedule.Voyage.PlannedArrival)</dd>
                    </div>
                </dl>

                @if (scheduleSuccess is not null)
                {
                    <div class="timeline-action-success" role="status">@scheduleSuccess</div>
                }

                @if (CanManageVoyages && CanAmendSchedule(schedule.Voyage.Status))
                {
                    <div class="timeline-schedule-actions">
                        <button class="timeline-submit timeline-schedule-amend" type="button" @onclick="OpenAmendModal">Amend schedule</button>
                        <button class="timeline-reset timeline-schedule-cancel" type="button" @onclick="OpenCancelModal">Cancel voyage</button>
                    </div>
                }

                <div class="timeline-card-heading timeline-schedule-history-heading">
                    <h3 id="timeline-schedule-history-title">Schedule changes</h3>
                    <span class="timeline-count">@schedule.Changes.Count recorded</span>
                </div>

                @if (schedule.Changes.Count == 0)
                {
                    <EmptyState Title="No schedule changes"
                                Message="Amendments and cancellations recorded for this voyage will appear here." />
                }
                else
                {
                    <ol class="timeline-schedule-changes">
                        @foreach (var change in schedule.Changes)
                        {
                            <li class="timeline-schedule-change" @key="change.ChangeId">
                                <div class="timeline-schedule-change-heading">
                                    <span class="timeline-status @ChangeTypeModifier(change.ChangeType)">@change.ChangeType</span>
                                    <span class="timeline-schedule-change-time">@FormatUtc(change.ChangedAtUtc)</span>
                                    <code class="timeline-schedule-change-actor" title="@change.ChangedByUserId">@FormatActor(change.ChangedByUserId)</code>
                                </div>
                                <p class="timeline-schedule-change-reason">@change.Reason</p>
                                @{
                                    var changedFields = ChangedFields(change);
                                }
                                @if (changedFields.Count == 0)
                                {
                                    <p class="timeline-schedule-change-empty">No field values changed.</p>
                                }
                                else
                                {
                                    <ul class="timeline-schedule-change-fields">
                                        @foreach (var field in changedFields)
                                        {
                                            <li @key="field.Label">
                                                <span class="timeline-schedule-change-label">@field.Label</span>
                                                <span class="timeline-schedule-change-old">@field.PreviousValue</span>
                                                <span class="timeline-schedule-change-arrow" aria-hidden="true">→</span>
                                                <span class="timeline-schedule-change-new">@field.NewValue</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ol>
                }
            }
        </section>
    }

    @if (isAmendModalOpen && schedule is not null)
    {
        <div class="voyages-modal-backdrop" role="presentation" @onclick="CloseAmendModal">
            <section class="voyages-form-card voyages-modal timeline-amend-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="amend-modal-title"
                     @onclick:stopPropagation="true">
                <div class="voyages-modal-header">
                    <div>
                        <h2 id="amend-modal-title">Amend schedule</h2>
                        <p>Revise @schedule.Voyage.VoyageNumber. A reason is required and kept in the audit trail.</p>
                    </div>
                    <button type="button"
                            class="voyages-modal-close"
                            aria-label="Close amend schedule dialog"
                            @onclick="CloseAmendModal">&times;</button>
                </div>

                @if (amendFailure is not null)
                {
                    <div class="timeline-form-error" role="alert">
                        <strong>@amendFailure.Title</strong>
                        @if (amendFailure.Errors.Count > 0)
                        {
                            <ul>
                                @foreach (var entry in amendFailure.Errors)
                                {
                                    @foreach (var message in entry.Value)
                                    {
                                        <li>@message</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@amendFailure.Message</p>
                        }
                    </div>
                }

                <div class="timeline-form-grid">
                    <div class="timeline-itinerary-field">
                        <label for="amend-departure-port">Departure port</label>
                        <PortPicker InputId="amend-departure-port"
                                    Value="amendDeparturePortId"
                                    ValueChanged="value => amendDeparturePortId = value" />
                    </div>
                    <div class="timeline-itinerary-field">
                        <label for="amend-arrival-port">Arrival port</label>
                        <PortPicker InputId="amend-arrival-port"
                                    Value="amendArrivalPortId"
                                    ValueChanged="value => amendArrivalPortId = value" />
                    </div>
                    <div class="timeline-itinerary-field">
                        <label for="amend-departure-date">Planned departure (UTC)</label>
                        <div class="timeline-itinerary-stamp">
                            <input id="amend-departure-date" type="date" @bind="amendDepartureDate" />
                            <input id="amend-departure-time" type="time" @bind="amendDepartureTime" aria-label="Planned departure time UTC" />
                        </div>
                    </div>
                    <div class="timeline-itinerary-field">
                        <label for="amend-arrival-date">Planned arrival (UTC)</label>
                        <div class="timeline-itinerary-stamp">
                            <input id="amend-arrival-date" type="date" @bind="amendArrivalDate" />
                            <input id="amend-arrival-time" type="time" @bind="amendArrivalTime" aria-label="Planned arrival time UTC" />
                        </div>
                    </div>
                    <div class="timeline-itinerary-field timeline-field-wide">
                        <label for="amend-route">Route (optional)</label>
                        <RoutePicker InputId="amend-route" Value="amendRouteId" ValueChanged="value => amendRouteId = value" />
                    </div>
                    <div class="timeline-itinerary-field timeline-field-wide">
                        <label for="amend-reason">Reason</label>
                        <input id="amend-reason" @bind="amendReason" placeholder="Berth window moved by the terminal" />
                    </div>
                </div>

                <div class="timeline-form-actions">
                    <button class="timeline-submit" type="button" @onclick="SubmitAmendAsync" disabled="@isSubmittingAmend">
                        @(isSubmittingAmend ? "Saving..." : "Save amendment")
                    </button>
                    <button class="timeline-reset" type="button" @onclick="CloseAmendModal" disabled="@isSubmittingAmend">Cancel</button>
                </div>
            </section>
        </div>
    }

    @if (isCancelModalOpen && schedule is not null)
    {
        <div class="voyages-modal-backdrop" role="presentation" @onclick="CloseCancelModal">
            <section class="voyages-form-card voyages-modal timeline-cancel-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="cancel-modal-title"
                     @onclick:stopPropagation="true">
                <div class="voyages-modal-header">
                    <div>
                        <h2 id="cancel-modal-title">Cancel voyage</h2>
                        <p>@schedule.Voyage.VoyageNumber stays on record with its itinerary, stops and delays. A reason is required.</p>
                    </div>
                    <button type="button"
                            class="voyages-modal-close"
                            aria-label="Close cancel voyage dialog"
                            @onclick="CloseCancelModal">&times;</button>
                </div>

                @if (cancelFailure is not null)
                {
                    <div class="timeline-form-error" role="alert">
                        <strong>@cancelFailure.Title</strong>
                        @if (cancelFailure.Errors.Count > 0)
                        {
                            <ul>
                                @foreach (var entry in cancelFailure.Errors)
                                {
                                    @foreach (var message in entry.Value)
                                    {
                                        <li>@message</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@cancelFailure.Message</p>
                        }
                    </div>
                }

                <div class="timeline-itinerary-field">
                    <label for="cancel-reason">Reason</label>
                    <input id="cancel-reason" @bind="cancelReason" placeholder="Cargo booking cancelled" />
                </div>

                <div class="timeline-form-actions">
                    <button class="timeline-submit timeline-danger" type="button" @onclick="SubmitCancelAsync" disabled="@isSubmittingCancel">
                        @(isSubmittingCancel ? "Cancelling..." : "Confirm cancellation")
                    </button>
                    <button class="timeline-reset" type="button" @onclick="CloseCancelModal" disabled="@isSubmittingCancel">Keep voyage</button>
                </div>
            </section>
        </div>
    }

    @if (isItineraryModalOpen)
    {
        <div class="voyages-modal-backdrop" role="presentation" @onclick="CloseItineraryModal">
            <section class="voyages-form-card voyages-modal timeline-itinerary-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="itinerary-modal-title"
                     @onclick:stopPropagation="true">
                <div class="voyages-modal-header">
                    <div>
                        <h2 id="itinerary-modal-title">Plan itinerary</h2>
                        <p>Choose a managed route, or add stops manually.</p>
                    </div>
                    <button type="button"
                            class="voyages-modal-close"
                            aria-label="Close plan itinerary dialog"
                            @onclick="CloseItineraryModal">&times;</button>
                </div>

                @if (itineraryFailure is not null)
                {
                    <div class="timeline-form-error" role="alert">
                        <strong>@itineraryFailure.Title</strong>
                        @if (itineraryFailure.Errors.Count > 0)
                        {
                            <ul>
                                @foreach (var entry in itineraryFailure.Errors)
                                {
                                    @foreach (var message in entry.Value)
                                    {
                                        <li>@message</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p>@itineraryFailure.Message</p>
                        }
                    </div>
                }

                <div class="timeline-itinerary-field">
                    <label for="itinerary-route">Route (optional)</label>
                    <RoutePicker InputId="itinerary-route" Value="selectedRouteId" ValueChanged="OnRouteSelectedAsync" />
                </div>

                <div class="timeline-itinerary-builder">
                    @for (var index = 0; index < itineraryStops.Count; index++)
                    {
                        var stopIndex = index;
                        var stop = itineraryStops[stopIndex];

                        <div class="timeline-itinerary-stop" @key="stop">
                            <span class="timeline-itinerary-order" aria-hidden="true">@(stopIndex + 1)</span>

                            <div class="timeline-itinerary-stop-fields">
                                <div class="timeline-itinerary-stop-row">
                                    @if (stop.IsRouteCovered)
                                    {
                                        <div class="timeline-itinerary-field">
                                            <span class="timeline-itinerary-readonly-label">Port</span>
                                            <span class="timeline-itinerary-readonly">@stop.PortLabel</span>
                                        </div>
                                        <div class="timeline-itinerary-field">
                                            <span class="timeline-itinerary-readonly-label">Distance (nm)</span>
                                            <span class="timeline-itinerary-readonly">@stop.DistanceFromPrevious</span>
                                        </div>
                                        <div class="timeline-itinerary-field">
                                            <span class="timeline-itinerary-readonly-label">Duration (h)</span>
                                            <span class="timeline-itinerary-readonly">@stop.EstimatedDurationFromPrevious</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-itinerary-field">
                                            <label for="@($"itinerary-stop-port-{stopIndex}")">Port</label>
                                            <PortPicker InputId="@($"itinerary-stop-port-{stopIndex}")"
                                                        Value="stop.PortId"
                                                        ValueChanged="value => stop.PortId = value" />
                                        </div>
                                        <div class="timeline-itinerary-field">
                                            <label for="@($"itinerary-stop-distance-{stopIndex}")">Distance from previous (nm)</label>
                                            <input id="@($"itinerary-stop-distance-{stopIndex}")" type="number" step="0.01"
                                                   value="@(stopIndex == 0 ? 0m : stop.DistanceFromPrevious)"
                                                   disabled="@(stopIndex == 0)"
                                                   @onchange="args => stop.DistanceFromPrevious = decimal.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var distance) ? distance : null" />
                                        </div>
                                        <div class="timeline-itinerary-field">
                                            <label for="@($"itinerary-stop-duration-{stopIndex}")">Duration from previous (h)</label>
                                            <input id="@($"itinerary-stop-duration-{stopIndex}")" type="number" step="1"
                                                   value="@(stopIndex == 0 ? 0 : stop.EstimatedDurationFromPrevious)"
                                                   disabled="@(stopIndex == 0)"
                                                   @onchange="args => stop.EstimatedDurationFromPrevious = int.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var duration) ? duration : null" />
                                        </div>
                                    }
                                </div>

                                <div class="timeline-itinerary-stop-row timeline-itinerary-stop-row-dates">
                                    <div class="timeline-itinerary-field">
                                        <label for="@($"itinerary-stop-eta-date-{stopIndex}")">ETA (UTC)</label>
                                        <div class="timeline-itinerary-stamp">
                                            <input id="@($"itinerary-stop-eta-date-{stopIndex}")" type="date" @bind="stop.EtaDate" />
                                            <input id="@($"itinerary-stop-eta-time-{stopIndex}")" type="time" @bind="stop.EtaTime" aria-label="@($"Stop {stopIndex + 1} ETA time UTC")" />
                                        </div>
                                    </div>
                                    <div class="timeline-itinerary-field">
                                        <label for="@($"itinerary-stop-etd-date-{stopIndex}")">ETD (UTC)</label>
                                        <div class="timeline-itinerary-stamp">
                                            <input id="@($"itinerary-stop-etd-date-{stopIndex}")" type="date" @bind="stop.EtdDate" />
                                            <input id="@($"itinerary-stop-etd-time-{stopIndex}")" type="time" @bind="stop.EtdTime" aria-label="@($"Stop {stopIndex + 1} ETD time UTC")" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!stop.IsRouteCovered)
                            {
                                <button type="button" class="timeline-itinerary-remove"
                                        aria-label="@($"Remove stop {stopIndex + 1}")"
                                        disabled="@(itineraryStops.Count <= MinimumItineraryStops)"
                                        @onclick="() => RemoveItineraryStop(stopIndex)">&times;</button>
                            }
                        </div>
                    }

                    <button type="button" class="timeline-itinerary-add" @onclick="AddItineraryStop">Add stop</button>
                </div>

                <div class="timeline-form-actions">
                    <button class="timeline-submit" type="button" @onclick="SubmitItineraryAsync" disabled="@isSubmittingItinerary">
                        @(isSubmittingItinerary ? "Planning..." : "Plan itinerary")
                    </button>
                    <button class="timeline-reset" type="button" @onclick="CloseItineraryModal" disabled="@isSubmittingItinerary">Cancel</button>
                </div>
            </section>
        </div>
    }
</section>
