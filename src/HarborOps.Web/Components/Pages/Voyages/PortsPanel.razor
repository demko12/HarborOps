@using HarborOps.Web.Api.Voyages
@implements IDisposable
@inject VoyagesApiClient VoyagesApi
@inject CurrentUserAuthorizationState AuthorizationState

<div class="ports-panel" role="tabpanel" aria-label="Port directory">
    <div class="voyages-filters" role="search">
        <div class="filter-field">
            <label for="ports-search">Search</label>
            <input id="ports-search" @bind="searchFilter" @bind:event="oninput" @bind:after="ApplyFiltersAsync"
                   placeholder="Name, city or UN/LOCODE" />
        </div>
        <div class="filter-field">
            <label for="ports-country">Country</label>
            <input id="ports-country" @bind="countryFilter" @bind:event="oninput" @bind:after="ApplyFiltersAsync"
                   placeholder="e.g. Montenegro" />
        </div>
        <div class="filter-field">
            <label for="ports-page-size">Per page</label>
            <select id="ports-page-size" @bind="pageSize" @bind:after="ApplyFiltersAsync">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <button class="voyages-reset" type="button" @onclick="ClearFiltersAsync" disabled="@isLoading">Reset</button>
    </div>

    @if (registerSuccessMessage is not null)
    {
        <div class="voyages-action-success" role="status">@registerSuccessMessage</div>
    }

    <section class="voyages-card" aria-labelledby="ports-list-title">
        <div class="voyages-card-heading">
            <div>
                <h2 id="ports-list-title">Port directory</h2>
                <p>@totalCount ports found</p>
            </div>
            <div class="voyages-card-tools">
                @if (CanManage)
                {
                    <button class="voyages-schedule-button" type="button" @onclick="OpenRegisterForm">
                        <span aria-hidden="true">+</span> Register port
                    </button>
                }
                <span class="voyages-card-icon" aria-hidden="true"><span class="bi bi-geo-alt-fill"></span></span>
            </div>
        </div>

        @if (isLoading)
        {
            <LoadingState Message="Loading ports..." />
        }
        else if (failure is not null)
        {
            <ApiErrorState Title="@failure.Title" Message="@failure.Message" RetryLabel="Retry" OnRetry="RetryAsync" />
        }
        else if (rows.Count == 0)
        {
            <EmptyState Title="No ports match your filters"
                        Message="Clear the search and country filters, or register the first port." />
        }
        else
        {
            <div class="voyages-table-scroll">
                <table class="voyages-table ports-table">
                    <caption class="visually-hidden">Registered ports, ordered by name</caption>
                    <thead>
                        <tr>
                            <th scope="col">Port</th>
                            <th scope="col">Country</th>
                            <th scope="col">City</th>
                            <th scope="col">UN/LOCODE</th>
                            <th scope="col">Coordinates</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.PortId">
                                <td><span class="master-data-title">@row.Name</span></td>
                                <td>@row.Country</td>
                                <td class="master-data-muted">@MasterDataFormat.OptionalText(row.City)</td>
                                <td class="master-data-code">@MasterDataFormat.OptionalText(row.UnLocode)</td>
                                <td class="master-data-muted">@MasterDataFormat.Coordinates(row.Latitude, row.Longitude)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="voyages-pagination">
                <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount ports</span>
                <div>
                    <button type="button" @onclick="PreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
                    <span class="voyages-page-indicator">Page @pageNumber of @TotalPages</span>
                    <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
                </div>
            </div>
        }
    </section>

    @if (isRegisterFormOpen)
    {
        <div class="voyages-modal-backdrop" role="presentation" @onclick="CloseRegisterForm">
            <section class="voyages-form-card voyages-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="port-register-title"
                     @onclick:stopPropagation="true">
                <div class="voyages-modal-header">
                    <h2 id="port-register-title">Register port</h2>
                    <button type="button"
                            class="voyages-modal-close"
                            aria-label="Close register port dialog"
                            disabled="@isRegistering"
                            @onclick="CloseRegisterForm">&times;</button>
                </div>

                <form class="voyages-form ports-form" @onsubmit="SubmitRegisterAsync" @onsubmit:preventDefault="true">
                    @if (registerFailure is { IsValidation: true, Errors.Count: > 0 })
                    {
                        <div class="voyages-validation" role="alert">
                            <strong>Please correct the following before saving</strong>
                            <ul>
                                @foreach (var entry in registerFailure.Errors)
                                {
                                    @foreach (var message in entry.Value)
                                    {
                                        <li>@message</li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                    else if (registerFailure is not null)
                    {
                        <div class="voyages-action-failure" role="alert">
                            <strong>@registerFailure.Title</strong>
                            @if (registerFailure.Errors.Count > 0)
                            {
                                <ul>
                                    @foreach (var entry in registerFailure.Errors)
                                    {
                                        @foreach (var message in entry.Value)
                                        {
                                            <li>@message</li>
                                        }
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>@registerFailure.Message</p>
                            }
                        </div>
                    }

                    <div class="voyages-form-grid">
                        <div class="filter-field">
                            <label for="port-name">Name <span class="required-marker" aria-hidden="true">*</span></label>
                            <input id="port-name" @bind="registerModel.Name" maxlength="200" />
                        </div>
                        <div class="filter-field">
                            <label for="port-country">Country <span class="required-marker" aria-hidden="true">*</span></label>
                            <input id="port-country" @bind="registerModel.Country" maxlength="100" />
                        </div>
                        <div class="filter-field">
                            <label for="port-city">City</label>
                            <input id="port-city" @bind="registerModel.City" maxlength="100" />
                        </div>
                        <div class="filter-field">
                            <label for="port-un-locode">UN/LOCODE</label>
                            <input id="port-un-locode" @bind="registerModel.UnLocode" maxlength="5" placeholder="e.g. MEBAR" />
                        </div>
                        <div class="filter-field">
                            <label for="port-latitude">Latitude</label>
                            <input id="port-latitude" type="number" step="0.000001" @bind="registerModel.Latitude" />
                        </div>
                        <div class="filter-field">
                            <label for="port-longitude">Longitude</label>
                            <input id="port-longitude" type="number" step="0.000001" @bind="registerModel.Longitude" />
                        </div>
                    </div>

                    <div class="voyages-form-actions">
                        <button type="submit" class="voyages-button ports-submit" disabled="@isRegistering">
                            @(isRegistering ? "Registering..." : "Register port")
                        </button>
                        <button type="button" class="voyages-reset" @onclick="CloseRegisterForm" disabled="@isRegistering">Cancel</button>
                    </div>
                </form>
            </section>
        </div>
    }
</div>
