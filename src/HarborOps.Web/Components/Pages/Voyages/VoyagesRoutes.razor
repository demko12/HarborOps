@page "/voyages/routes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessVoyages")]
@using HarborOps.Web.Api.Voyages
@implements IDisposable
@inject VoyagesApiClient VoyagesApi

<PageTitle>Routes | HarborOps</PageTitle>

<section class="voyages-page">
    <header class="voyages-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/voyages">Voyage operations</a><span aria-hidden="true">/</span><span>Routes</span></nav>
            <h1>Routes</h1>
            <p>Register and review the routes your voyages follow.</p>
        </div>
        <span class="voyages-utc" aria-label="All times are shown in UTC">UTC</span>
    </header>

    <VoyagesNavigation />

    <section class="voyages-summary-scoped" aria-label="Route summary">
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">Routes</p>
                <p class="voyages-kpi-value">@Voyages.FormatCount(routesKpiCount)</p>
                <p class="voyages-kpi-note">Active in the directory</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-completed" aria-hidden="true"><span class="bi bi-diagram-3-fill"></span></span>
        </article>
        <article class="voyages-kpi">
            <div>
                <p class="voyages-kpi-label">Avg. route distance</p>
                <p class="voyages-kpi-value">@FormatAvgDistance(avgRouteDistanceKpi)</p>
                <p class="voyages-kpi-note">Mean of registered routes</p>
            </div>
            <span class="voyages-kpi-icon kpi-icon-delayed" aria-hidden="true"><span class="bi bi-rulers"></span></span>
        </article>
    </section>

    <RoutesPanel />
</section>
