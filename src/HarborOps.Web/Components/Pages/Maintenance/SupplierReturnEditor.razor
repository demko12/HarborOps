@using HarborOps.Web.Api.Maintenance
@using HarborOps.Web.Components.Shared
@implements IDisposable
@inject MaintenanceApiClient MaintenanceApi
@inject CurrentUserAuthorizationState AuthorizationState

<section class="maintenance-card supplier-return-editor" aria-labelledby="supplier-return-editor-title">
	<div class="maintenance-card-heading">
		<div>
			<h2 id="supplier-return-editor-title">@(IsNew ? "New supplier return" : "Supplier return")</h2>
			<p>
				@if (details is { } loaded)
				{
					<span class="stocktake-status @MaintenanceFormat.StocktakeStatusModifier(loaded.Status)">@loaded.Status</span>
					<span class="maintenance-muted">
						@MaintenanceFormat.PurchaseOrderReference(loaded.PurchaseOrderId) &middot; @loaded.SupplierName
						&middot; started @MaintenanceFormat.CreatedUtc(loaded.CreatedUtc)
					</span>
				}
				else if (purchaseOrder is { } order)
				{
					<span class="maintenance-muted">
						@MaintenanceFormat.PurchaseOrderReference(order.PurchaseOrderId) &middot; @order.SupplierName
					</span>
				}
			</p>
		</div>
		<button type="button" class="maintenance-reset" @onclick="CloseAsync">Back to returns</button>
	</div>

	@if (isLoading)
	{
		<LoadingState Message="Loading the supplier return..." />
	}
	else if (failure is { IsForbidden: true })
	{
		<EmptyState Title="You cannot view this supplier return"
					Message="Your account does not carry a maintenance permission. Ask an administrator for access." />
	}
	else if (failure is not null)
	{
		<ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="ReloadAsync" />
	}
	else if (IsNew && !IsOrderReceived)
	{
		<EmptyState Title="This purchase order cannot be returned"
					Message="Only purchase orders with received goods can carry supplier returns." />
	}
	else
	{
		@if (!string.IsNullOrWhiteSpace(successMessage))
		{
			<div class="maintenance-toast stocktake-success" role="status" aria-live="polite">@successMessage</div>
		}

		@if (actionFailure is { IsValidation: true })
		{
			<div class="stocktake-blockers stocktake-validation" role="alert">
				<h3>Fix before saving</h3>
				<ul>
					@foreach (var error in ValidationMessages)
					{
						<li @key="error">
							<span class="stocktake-blocker-code">@error.Label</span>
							<span>@error.Message</span>
						</li>
					}
				</ul>
			</div>
		}
		else if (actionFailure is { IsConflict: true })
		{
			<div class="maintenance-conflict" role="alert">
				<strong>@actionFailure.Title</strong> @actionFailure.Message
				The return was reloaded with the latest data.
			</div>
		}
		else if (actionFailure is not null)
		{
			<ApiErrorState Title="@actionFailure.Title" Message="@actionFailure.Message" OnRetry="ReloadAsync" />
		}

		@if (IsDraft && Blockers.Count > 0)
		{
			<div class="stocktake-blockers" role="status" aria-live="polite">
				<h3>Resolve before posting</h3>
				<ul>
					@foreach (var blocker in Blockers)
					{
						<li @key="blocker">
							<span class="stocktake-blocker-code">@MaintenanceFormat.SupplierReturnBlockerLabel(blocker.Code)</span>
							<span>@blocker.Message</span>
							@if (blocker.ReservingWorkOrderIds.Count > 0)
							{
								<span class="maintenance-muted">
									Work orders:
									@foreach (var workOrderId in blocker.ReservingWorkOrderIds)
									{
										<a class="stocktake-link" href="@($"/maintenance/work-orders/{workOrderId}")">@workOrderId</a>
									}
								</span>
							}
						</li>
					}
				</ul>
			</div>
		}

		@if (CanEdit)
		{
			<div class="filter-field supplier-return-notes">
				<label for="supplier-return-notes">Notes</label>
				<input id="supplier-return-notes"
					   type="text"
					   maxlength="1000"
					   placeholder="RMA number or supplier reference"
					   @bind="notes"
					   disabled="@isActing" />
			</div>
		}
		else if (details is { Notes: { } savedNotes })
		{
			<p class="maintenance-muted">Notes: @savedNotes</p>
		}

		<div class="maintenance-table-scroll">
			<table class="maintenance-table stocktake-lines-table supplier-return-lines-table">
				<caption class="visually-hidden">Supplier return lines</caption>
				<thead>
					<tr>
						<th scope="col">Part</th>
						<th scope="col">Part number</th>
						<th scope="col" class="numeric">Received</th>
						<th scope="col" class="numeric">Returned before</th>
						<th scope="col" class="numeric">Remaining</th>
						<th scope="col" class="numeric">On hand</th>
						<th scope="col" class="numeric">Reserved</th>
						<th scope="col" class="numeric">Return</th>
						<th scope="col">Reason</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var line in Lines)
					{
						var editable = EditorFor(line.PurchaseOrderLineId);

						<tr @key="line.PurchaseOrderLineId" class="@(IsBlocked(line) ? "stocktake-line-stale" : null)">
							<td><span class="maintenance-title">@line.Name</span></td>
							<td class="maintenance-muted">@line.PartNumber</td>
							<td class="numeric">@MaintenanceFormat.Quantity(line.ReceivedQuantity) @line.UnitAbbreviation</td>
							<td class="numeric">@Optional(line.PreviouslyReturnedQuantity)</td>
							<td class="numeric">@Optional(line.RemainingReturnableQuantity)</td>
							<td class="numeric">@Optional(line.OnHandQuantity)</td>
							<td class="numeric">@Optional(line.ReservedQuantity)</td>
							<td class="numeric">
								@if (CanEdit)
								{
									<input type="number"
										   step="0.001"
										   min="0.001"
										   inputmode="decimal"
										   placeholder="Not returned"
										   aria-label="@($"Return quantity for {line.Name}")"
										   @bind="editable.Quantity"
										   disabled="@isActing" />
								}
								else
								{
									@Optional(line.Quantity)
								}
							</td>
							<td>
								@if (CanEdit)
								{
									<input type="text"
										   maxlength="500"
										   aria-label="@($"Return reason for {line.Name}")"
										   @bind="editable.Reason"
										   disabled="@isActing" />
								}
								else
								{
									@MaintenanceFormat.OptionalText(line.Reason)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		@if (CanEdit && preview is { Items.Count: > 0 })
		{
			<div class="maintenance-table-scroll">
				<table class="maintenance-table supplier-return-preview-table">
					<caption>Stock after posting, per part</caption>
					<thead>
						<tr>
							<th scope="col">Part</th>
							<th scope="col" class="numeric">On hand</th>
							<th scope="col" class="numeric">Reserved</th>
							<th scope="col" class="numeric">Available</th>
							<th scope="col" class="numeric">Return</th>
							<th scope="col" class="numeric">After posting</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in preview.Items)
						{
							<tr @key="item.InventoryItemId">
								<td><span class="maintenance-title">@item.Name</span> <span class="maintenance-muted">@item.PartNumber</span></td>
								<td class="numeric">@MaintenanceFormat.Quantity(item.OnHandQuantity)</td>
								<td class="numeric">@MaintenanceFormat.Quantity(item.ReservedQuantity)</td>
								<td class="numeric">@MaintenanceFormat.Quantity(item.AvailableQuantity)</td>
								<td class="numeric">@MaintenanceFormat.Quantity(item.ReturnQuantity)</td>
								<td class="numeric">@MaintenanceFormat.Quantity(item.QuantityAfter)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		@if (CanEdit)
		{
			<div class="maintenance-form-actions stocktake-actions">
				<button type="button" class="maintenance-button" disabled="@isActing" @onclick="SaveAndCheckAsync">
					@(isActing ? "Working..." : IsNew ? "Create draft" : "Save and check")
				</button>
				@if (!IsNew)
				{
					<button type="button"
							class="maintenance-button stocktake-post"
							disabled="@(isActing || !CanPost)"
							@onclick="AskToPost">
						Post return
					</button>
					<button type="button" class="maintenance-reset" disabled="@isActing" @onclick="OpenCancelForm">
						Cancel return
					</button>
				}
			</div>
			<p class="maintenance-muted stocktake-hint">
				Leave the quantity empty for parts that stay on board. Saving checks the return against what is still
				returnable and against stock reserved for maintenance.
				@if (!IsNew && IsDirty)
				{
					<strong>Save your changes before posting.</strong>
				}
			</p>
		}
		else if (details is { } history && !IsDraft)
		{
			<div class="stocktake-history">
				<h3>History</h3>
				<dl class="stocktake-facts">
					<dt>Status</dt>
					<dd>@history.Status</dd>
					@if (history.PostedUtc is { } postedUtc)
					{
						<dt>Posted</dt>
						<dd>@MaintenanceFormat.CountedUtc(postedUtc)</dd>
					}
					@if (history.CancelledUtc is { } cancelledUtc)
					{
						<dt>Cancelled</dt>
						<dd>@MaintenanceFormat.CountedUtc(cancelledUtc)</dd>
						<dt>Reason</dt>
						<dd>@MaintenanceFormat.OptionalText(history.CancellationReason)</dd>
					}
				</dl>

				@if (history.Movements.Count > 0)
				{
					<div class="maintenance-table-scroll">
						<table class="maintenance-table stocktake-adjustments-table">
							<caption class="visually-hidden">Posted stock movements</caption>
							<thead>
								<tr>
									<th scope="col">Part</th>
									<th scope="col" class="numeric">Before</th>
									<th scope="col" class="numeric">After</th>
									<th scope="col" class="numeric">Delta</th>
									<th scope="col">Reason</th>
									<th scope="col">Posted at</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var movement in history.Movements)
								{
									<tr @key="movement.MovementId">
										<td>@PartNumberForMovement(movement)</td>
										<td class="numeric">@MaintenanceFormat.Quantity(movement.QuantityBefore)</td>
										<td class="numeric">@MaintenanceFormat.Quantity(movement.QuantityAfter)</td>
										<td class="numeric">
											<span class="stocktake-variance @MaintenanceFormat.VarianceModifier(movement.QuantityDelta)">
												@MaintenanceFormat.Variance(movement.QuantityDelta)
											</span>
										</td>
										<td>@movement.Reason</td>
										<td class="maintenance-muted">@MaintenanceFormat.CountedUtc(movement.MovedUtc)</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				else
				{
					<EmptyState Title="No stock was changed"
								Message="This return was cancelled before it was posted." />
				}
			</div>
		}

		@if (isPostConfirmOpen && preview is { } confirm)
		{
			<div class="maintenance-modal-backdrop" @onclick="DismissPostConfirmation">
				<section class="maintenance-modal maintenance-modal-narrow"
						 role="alertdialog"
						 aria-modal="true"
						 aria-labelledby="supplier-return-post-confirm-title"
						 @onclick:stopPropagation="true">
					<div class="maintenance-modal-header">
						<h2 id="supplier-return-post-confirm-title">Confirm posting</h2>
						<button type="button"
								class="maintenance-modal-close"
								aria-label="Close confirmation dialog"
								disabled="@isActing"
								@onclick="DismissPostConfirmation">
							&times;
						</button>
					</div>
					<p>
						Posting removes @MaintenanceFormat.Quantity(ReturnTotal) unit(s) across @confirm.Items.Count
						part@(confirm.Items.Count == 1 ? null : "s") from stock on hand. The purchase order, its received
						totals, and maintenance reservations stay unchanged. A posted return cannot be edited or reversed.
					</p>
					<ul class="supplier-return-confirm-items">
						@foreach (var item in confirm.Items)
						{
							<li @key="item.InventoryItemId">
								@item.PartNumber: @MaintenanceFormat.Quantity(item.OnHandQuantity) &rarr; @MaintenanceFormat.Quantity(item.QuantityAfter)
							</li>
						}
					</ul>
					<div class="maintenance-form-actions">
						<button type="button" class="maintenance-button" disabled="@isActing" @onclick="PostAsync">
							@(isActing ? "Posting..." : "Yes, post")
						</button>
						<button type="button" class="maintenance-reset" disabled="@isActing" @onclick="DismissPostConfirmation">
							Keep as draft
						</button>
					</div>
				</section>
			</div>
		}

		@if (isCancelFormOpen)
		{
			<div class="maintenance-modal-backdrop" @onclick="DismissCancelForm">
				<section class="maintenance-modal maintenance-modal-narrow"
						 role="dialog"
						 aria-modal="true"
						 aria-labelledby="supplier-return-cancel-title"
						 @onclick:stopPropagation="true">
					<div class="maintenance-modal-header">
						<h2 id="supplier-return-cancel-title">Cancel supplier return</h2>
						<button type="button"
								class="maintenance-modal-close"
								aria-label="Close cancel dialog"
								disabled="@isActing"
								@onclick="DismissCancelForm">
							&times;
						</button>
					</div>
					<form class="maintenance-form" @onsubmit="CancelReturnAsync" @onsubmit:preventDefault="true">
						<div class="filter-field">
							<label for="supplier-return-cancel-reason">Reason <span class="required-marker" aria-hidden="true">*</span></label>
							<input id="supplier-return-cancel-reason" type="text" maxlength="500" @bind="cancelReason" disabled="@isActing" />
						</div>
						<div class="maintenance-form-actions">
							<button type="submit" class="maintenance-button" disabled="@(isActing || string.IsNullOrWhiteSpace(cancelReason))">
								@(isActing ? "Cancelling..." : "Cancel return")
							</button>
							<button type="button" class="maintenance-reset" disabled="@isActing" @onclick="DismissCancelForm">Keep draft</button>
						</div>
					</form>
				</section>
			</div>
		}
	}
</section>
