@page "/maintenance"
@implements IDisposable
@inject MaintenanceWorkOrderBoard Board
@using HarborOps.Web.Api.Maintenance
@using HarborOps.Web.Features.Maintenance

<PageTitle>Maintenance - HarborOps</PageTitle>

<section class="maintenance-intro">
	<p class="maintenance-eyebrow">Maintenance</p>
	<h1>Work orders</h1>
	<p>Review due work, create work orders, and record completion.</p>
</section>

<section class="filters-bar" aria-label="Filters">
	<div class="filter-field">
		<label for="vessel-filter">Vessel ID</label>
		<input id="vessel-filter" @bind="vesselIdFilterText" placeholder="e.g. 3fa85f64-..." />
	</div>
	<div class="filter-field">
		<label for="status-filter">Status</label>
		<select id="status-filter" @bind="Board.StatusFilter">
			<option value="">All</option>
			<option value="Open">Open</option>
			<option value="InProgress">In progress</option>
			<option value="Completed">Completed</option>
			<option value="Canceled">Canceled</option>
		</select>
	</div>
	<div class="filter-field">
		<label for="priority-filter">Priority</label>
		<select id="priority-filter" @bind="Board.PriorityFilter">
			<option value="">All</option>
			<option value="Low">Low</option>
			<option value="Medium">Medium</option>
			<option value="High">High</option>
			<option value="Critical">Critical</option>
		</select>
	</div>
	<div class="filter-field">
		<label for="overdue-filter">Due status</label>
		<select id="overdue-filter" @bind="overdueFilterText">
			<option value="">All</option>
			<option value="true">Overdue only</option>
			<option value="false">Not overdue</option>
		</select>
	</div>
	<div class="filter-actions">
		<button type="button" class="btn btn-primary btn-sm" @onclick="ApplyFiltersAsync">Apply filters</button>
		<button type="button" class="btn btn-outline-light btn-sm" @onclick="ClearFiltersAsync">Clear</button>
	</div>
</section>

@if (Board.LoadState == BoardLoadState.ValidationFailed && Board.FilterValidationErrors is not null)
{
	<div class="filter-validation" role="alert">
		<strong>These filters aren't valid.</strong>
		<ul>
			@foreach (var error in Board.FilterValidationErrors.SelectMany(entry => entry.Value))
			{
				<li>@error</li>
			}
		</ul>
	</div>
}

@if (createSuccessMessage is not null)
{
	<div class="success-banner" role="status">@createSuccessMessage</div>
}
@if (completionSuccessMessage is not null)
{
	<div class="success-banner" role="status">@completionSuccessMessage</div>
}
@if (Board.CompletionConflictMessage is not null)
{
	<div class="conflict-banner" role="alert">@Board.CompletionConflictMessage</div>
}

<section class="board-section" aria-label="Work orders">
	@if (Board.LoadState == BoardLoadState.Loading)
	{
		<LoadingState Message="Loading work orders..." />
	}
	else if (Board.LoadState == BoardLoadState.Error)
	{
		<ApiErrorState Title="Unable to load work orders"
					   Message="@(Board.ErrorMessage ?? "Something went wrong.")"
					   RetryLabel="Retry"
					   OnRetry="RetryAsync" />
	}
	else if (Board.LoadState == BoardLoadState.Empty)
	{
		<EmptyState Title="No work orders" Message="No work orders match the current filters." />
	}
	else if (Board.LoadState == BoardLoadState.Loaded)
	{
		<table class="work-order-table">
			<thead>
				<tr>
					<th>Title</th>
					<th>Vessel</th>
					<th>Priority</th>
					<th>Status</th>
					<th>Due</th>
					<th>Assigned engineer</th>
					<th>Created</th>
					<th>Completed</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var row in Board.Rows)
				{
					<tr class="@(row.IsOverdue ? "row-overdue" : null)">
						<td>
							<strong>@row.Title</strong>
							@if (!string.IsNullOrWhiteSpace(row.Description))
							{
								<div class="row-description">@row.Description</div>
							}
						</td>
						<td>@row.VesselDisplayName</td>
						<td>
							<span class="badge-priority priority-@row.Priority.ToLowerInvariant()">
								@row.Priority
								@if (row.IsCritical)
								{
									<span class="bi bi-exclamation-triangle-fill" aria-hidden="true"></span>
								}
							</span>
						</td>
						<td><span class="badge-status status-@row.Status.ToLowerInvariant()">@row.Status</span></td>
						<td>
							@row.DueUtc.ToString("yyyy-MM-dd HH:mm")
							@if (row.IsOverdue)
							{
								<span class="badge-overdue">Overdue</span>
							}
						</td>
						<td>@(row.AssignedEngineerId?.ToString() ?? "Unassigned")</td>
						<td>@row.CreatedUtc.ToString("yyyy-MM-dd")</td>
						<td>@(row.CompletedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
						<td>
							@if (row.CanComplete)
							{
								<button type="button" class="btn btn-sm btn-outline-light" @onclick="() => OpenCompletionForm(row.WorkOrderId)">
									Complete
								</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>

		<div class="pagination-bar">
			<button type="button" class="btn btn-sm btn-outline-light" disabled="@(Board.PageNumber <= 1)" @onclick="PreviousPageAsync">
				Previous
			</button>
			<span>Page @Board.PageNumber of @Board.TotalPages (@Board.TotalCount total)</span>
			<button type="button" class="btn btn-sm btn-outline-light" disabled="@(Board.PageNumber >= Board.TotalPages)" @onclick="NextPageAsync">
				Next
			</button>
		</div>
	}
</section>

<section class="create-section" aria-labelledby="create-title">
	<h2 id="create-title">Create work order</h2>
	<EditForm Model="createModel" OnValidSubmit="SubmitCreateAsync">
		<div class="form-grid">
			<div class="form-field">
				<label for="create-vessel">Vessel ID</label>
				<input id="create-vessel" @bind="createModel.VesselId" placeholder="Vessel GUID" />
			</div>
			<div class="form-field">
				<label for="create-title-input">Title</label>
				<input id="create-title-input" @bind="createModel.Title" maxlength="200" />
			</div>
			<div class="form-field form-field-wide">
				<label for="create-description">Description</label>
				<textarea id="create-description" @bind="createModel.Description" maxlength="2000"></textarea>
			</div>
			<div class="form-field">
				<label for="create-priority">Priority</label>
				<select id="create-priority" @bind="createModel.Priority">
					<option value="">Select...</option>
					<option value="Low">Low</option>
					<option value="Medium">Medium</option>
					<option value="High">High</option>
					<option value="Critical">Critical</option>
				</select>
			</div>
			<div class="form-field">
				<label for="create-due">Due (UTC)</label>
				<input id="create-due" type="datetime-local" @bind="createModel.DueUtcLocal" />
			</div>
		</div>

		@if (Board.CreateValidationErrors is not null)
		{
			<ul class="field-errors" role="alert">
				@foreach (var error in Board.CreateValidationErrors.SelectMany(entry => entry.Value))
				{
					<li>@error</li>
				}
			</ul>
		}
		@if (Board.CreateErrorMessage is not null)
		{
			<div class="api-error-inline" role="alert">@Board.CreateErrorMessage</div>
		}

		<button type="submit" class="btn btn-primary" disabled="@Board.IsSubmittingCreate">
			@(Board.IsSubmittingCreate ? "Creating..." : "Create work order")
		</button>
	</EditForm>
</section>

@if (completingWorkOrderId is not null)
{
	<section class="completion-section" aria-labelledby="completion-title">
		<h2 id="completion-title">Complete work order</h2>
		<EditForm Model="completionModel" OnValidSubmit="SubmitCompletionAsync">
			<div class="form-grid">
				<div class="form-field">
					<label for="complete-technician">Technician ID</label>
					<input id="complete-technician" @bind="completionModel.TechnicianId" />
				</div>
				<div class="form-field">
					<label for="complete-completed-utc">Completed (UTC)</label>
					<input id="complete-completed-utc" type="datetime-local" @bind="completionModel.CompletedUtcLocal" />
				</div>
				<div class="form-field">
					<label for="complete-cost">Cost</label>
					<input id="complete-cost" type="number" step="0.01" @bind="completionModel.Cost" />
				</div>
				<div class="form-field">
					<label for="complete-labor-hours">Labor hours</label>
					<input id="complete-labor-hours" type="number" step="0.1" @bind="completionModel.LaborHours" />
				</div>
				<div class="form-field form-field-wide">
					<label for="complete-notes">Notes</label>
					<textarea id="complete-notes" @bind="completionModel.Notes" maxlength="2000"></textarea>
				</div>
			</div>

			@if (Board.CompletionValidationErrors is not null)
			{
				<ul class="field-errors" role="alert">
					@foreach (var error in Board.CompletionValidationErrors.SelectMany(entry => entry.Value))
					{
						<li>@error</li>
					}
				</ul>
			}
			@if (Board.CompletionErrorMessage is not null)
			{
				<div class="api-error-inline" role="alert">@Board.CompletionErrorMessage</div>
			}

			<div class="completion-actions">
				<button type="submit" class="btn btn-primary" disabled="@Board.IsSubmittingCompletion">
					@(Board.IsSubmittingCompletion ? "Completing..." : "Complete work order")
				</button>
				<button type="button" class="btn btn-outline-light" @onclick="CloseCompletionForm">Cancel</button>
			</div>
		</EditForm>
	</section>
}

@code {
	private CancellationTokenSource cancellation = new();
	private string? vesselIdFilterText;
	private string? overdueFilterText;
	private string? createSuccessMessage;
	private string? completionSuccessMessage;
	private Guid? completingWorkOrderId;

	private CreateWorkOrderModel createModel = new();
	private CompleteWorkOrderModel completionModel = new();

	protected override Task OnInitializedAsync() => Board.LoadAsync(cancellation.Token);

	private Task RetryAsync() => Board.LoadAsync(cancellation.Token);

	private Task ApplyFiltersAsync()
	{
		Board.VesselIdFilter = Guid.TryParse(vesselIdFilterText, out var vesselId) ? vesselId : null;
		Board.OverdueFilter = overdueFilterText switch
		{
			"true" => true,
			"false" => false,
			_ => null,
		};
		return Board.ApplyFiltersAsync(cancellation.Token);
	}

	private Task ClearFiltersAsync()
	{
		vesselIdFilterText = null;
		overdueFilterText = null;
		return Board.ClearFiltersAsync(cancellation.Token);
	}

	private Task PreviousPageAsync() => Board.GoToPageAsync(Board.PageNumber - 1, cancellation.Token);

	private Task NextPageAsync() => Board.GoToPageAsync(Board.PageNumber + 1, cancellation.Token);

	private async Task SubmitCreateAsync()
	{
		createSuccessMessage = null;

		var request = new CreateMaintenanceWorkOrderRequest
		{
			VesselId = Guid.TryParse(createModel.VesselId, out var vesselId) ? vesselId : null,
			Title = createModel.Title,
			Description = createModel.Description,
			Priority = createModel.Priority,
			DueUtc = createModel.DueUtcLocal is { } dueLocal
				? DateTime.SpecifyKind(dueLocal, DateTimeKind.Utc)
				: null,
		};

		var succeeded = await Board.CreateWorkOrderAsync(request, cancellation.Token);

		if (succeeded)
		{
			createSuccessMessage = "Work order created.";
			createModel = new CreateWorkOrderModel();
		}
		// Na neuspehu namerno ne resetujemo createModel - vrednosti ostaju u formi.
	}

	private void OpenCompletionForm(Guid workOrderId)
	{
		completingWorkOrderId = workOrderId;
		completionModel = new CompleteWorkOrderModel();
		completionSuccessMessage = null;
	}

	private void CloseCompletionForm()
	{
		completingWorkOrderId = null;
	}

	private async Task SubmitCompletionAsync()
	{
		if (completingWorkOrderId is not { } workOrderId)
		{
			return;
		}

		completionSuccessMessage = null;

		var request = new CompleteMaintenanceWorkOrderRequest
		{
			TechnicianId = Guid.TryParse(completionModel.TechnicianId, out var technicianId) ? technicianId : null,
			CompletedUtc = completionModel.CompletedUtcLocal is { } completedLocal
				? DateTime.SpecifyKind(completedLocal, DateTimeKind.Utc)
				: null,
			Notes = completionModel.Notes,
			Cost = completionModel.Cost,
			LaborHours = completionModel.LaborHours,
		};

		var succeeded = await Board.CompleteWorkOrderAsync(workOrderId, request, cancellation.Token);

		if (succeeded)
		{
			completionSuccessMessage = "Work order completed.";
			completingWorkOrderId = null;
		}
		// Na neuspehu (validacija/konflikt) forma i vrednosti ostaju otvoreni.
	}

	public void Dispose()
	{
		cancellation.Cancel();
		cancellation.Dispose();
	}

	private sealed class CreateWorkOrderModel
	{
		public string? VesselId { get; set; }
		public string? Title { get; set; }
		public string? Description { get; set; }
		public string? Priority { get; set; }
		public DateTime? DueUtcLocal { get; set; }
	}

	private sealed class CompleteWorkOrderModel
	{
		public string? TechnicianId { get; set; }
		public DateTime? CompletedUtcLocal { get; set; } = DateTime.UtcNow;
		public string? Notes { get; set; }
		public decimal? Cost { get; set; }
		public decimal? LaborHours { get; set; }
	}
}
