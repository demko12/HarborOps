@page "/not-found"
@layout MainLayout
@inject IJSRuntime JS

<PageTitle>Page not found | HarborOps</PageTitle>

<section class="not-found-page" aria-labelledby="not-found-title">
    <div class="not-found-card" role="status">
        <div class="not-found-icon" aria-hidden="true">
            <span class="bi bi-compass"></span>
        </div>
        <p class="not-found-eyebrow">Missing page</p>
        <h1 id="not-found-title">Page not found</h1>
        <p class="not-found-copy">The page you tried to open is not available. It may have been moved or renamed, or the link you followed may be out of date.</p>
        <div class="not-found-actions">
            <a class="not-found-primary" href="/">
                <span class="bi bi-grid-1x2-fill" aria-hidden="true"></span>
                Return to dashboard
            </a>
            <button class="not-found-secondary" type="button" @onclick="GoBackAsync">
                <span class="bi bi-arrow-left" aria-hidden="true"></span>
                Go back
            </button>
        </div>
        <p class="not-found-help"><span class="bi bi-info-circle" aria-hidden="true"></span> Still cannot find what you need? Contact a HarborOps administrator.</p>
    </div>
</section>

@code {
    private async Task GoBackAsync() => await JS.InvokeVoidAsync("history.back");
}
