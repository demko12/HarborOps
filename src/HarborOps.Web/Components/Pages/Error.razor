@page "/Error"
@layout MainLayout
@using System.Diagnostics
@inject NavigationManager Navigation

<PageTitle>Something went wrong | HarborOps</PageTitle>

<section class="error-page" aria-labelledby="error-title">
    <div class="error-card" role="alert">
        <div class="error-icon" aria-hidden="true">
            <span class="bi bi-exclamation-triangle"></span>
        </div>
        <p class="error-eyebrow">Unexpected problem</p>
        <h1 id="error-title">Something went wrong</h1>
        <p class="error-copy">HarborOps could not complete your last request. Nothing you were working on has been lost, and you can safely continue from the dashboard.</p>
        <div class="error-actions">
            <a class="error-primary" href="/">
                <span class="bi bi-grid-1x2-fill" aria-hidden="true"></span>
                Return to dashboard
            </a>
            <button class="error-secondary" type="button" @onclick="TryAgain">
                <span class="bi bi-arrow-clockwise" aria-hidden="true"></span>
                Try again
            </button>
        </div>
        @if (ShowRequestId)
        {
            <p class="error-reference">
                <span class="error-reference-label">Support reference</span>
                <code>@RequestId</code>
            </p>
        }
        <p class="error-help"><span class="bi bi-info-circle" aria-hidden="true"></span> If this keeps happening, contact a HarborOps administrator@(ShowRequestId ? " and include the support reference above" : string.Empty).</p>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void TryAgain() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
