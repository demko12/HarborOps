@page "/crew/{CrewMemberId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCrew")]
@using HarborOps.Web.Api.Fleet
@using HarborOps.Web.Components.Pages.Crew
@implements IDisposable
@inject CrewApiClient CrewApi
@inject FleetApiClient FleetApi
@inject CurrentUserAuthorizationState CurrentUser

<PageTitle>@(profile is null ? "Crew profile" : $"{profile.FirstName} {profile.LastName}") | HarborOps</PageTitle>

<section class="crew-profile-page">
    @if (isLoading)
    {
        <LoadingState Message="Loading crew profile..." />
    }
    else if (failure is not null)
    {
        <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="LoadProfileAsync" />
    }
    else if (profile is not null)
    {
        <div class="crew-profile-content" inert="@IsProfileEditorOpen">
        @if (profileEditorSuccess is not null)
        {
            <div class="crew-profile-form-success" role="status">@profileEditorSuccess</div>
        }
        <header class="crew-profile-header">
            <div>
                <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/crew">Crewing operations</a><span aria-hidden="true">/</span><span>Crew profile</span></nav>
                <div class="crew-profile-identity">
                    <span class="crew-profile-avatar" aria-hidden="true"><span class="bi bi-person"></span></span>
                    <div><h1>@profile.FirstName @profile.LastName</h1>
                    <p>@profile.BaseRankName &middot; @profile.Nationality &middot; IMO @profile.ImoSeafarerId</p></div>
                </div>
            </div>
            <span class="employment-status @GetEmploymentStatusClass(profile.EmploymentStatus)">@profile.EmploymentStatus</span>
        </header>

        <section class="crew-profile-highlights" aria-label="Profile overview">
            <article class="crew-profile-highlight crew-profile-highlight-active"><span class="bi bi-water" aria-hidden="true"></span><div><span>Active assignments</span><strong>@profile.Assignments.Count(item => GetAssignmentState(item).Label == "Active")</strong><small>Current vessel deployments</small></div></article>
            <article class="crew-profile-highlight crew-profile-highlight-review"><span class="bi bi-award" aria-hidden="true"></span><div><span>Certificates to review</span><strong>@profile.Certificates.Count(item => item.ExpiryDate <= currentDate.AddDays(30))</strong><small>Expired or expiring within 30 days</small></div></article>
            <article class="crew-profile-highlight"><span class="bi bi-heart-pulse" aria-hidden="true"></span><div><span>Medical fitness</span><strong class="crew-profile-highlight-text">@(isLoadingMedical ? "Loading…" : medicalFailure is not null ? "Unavailable" : CurrentFitnessDisplayState.Label)</strong><small>Latest reported assessment</small></div></article>
            <article class="crew-profile-highlight"><span class="bi bi-passport" aria-hidden="true"></span><div><span>Passport</span><strong class="crew-profile-highlight-text">@(IsPassportExpired(profile.PassportExpiry) ? "Expired" : IsPassportExpiringSoon(profile.PassportExpiry) ? "Renewal due" : "Valid")</strong><small>Expires @profile.PassportExpiry.ToString("dd MMM yyyy")</small></div></article>
        </section>

        <section class="crew-profile-summary-card" aria-labelledby="crew-profile-summary-title">
            <div class="crew-profile-card-heading">
                <h2 id="crew-profile-summary-title">Personal &amp; employment</h2>
                <div class="crew-profile-card-heading-actions">
                    @if (CanManage)
                    {
                        <button type="button" class="crew-profile-edit-toggle crew-edit-profile-toggle" @onclick="ToggleEditProfile">
                            <span class="bi bi-pencil" aria-hidden="true"></span> @(isEditingProfile ? "Cancel" : "Edit profile")
                        </button>
                    }
                    <span class="bi bi-person-vcard" aria-hidden="true"></span>
                </div>
            </div>
            <dl class="crew-profile-summary-grid">
                <div><dt>Base rank</dt><dd>@profile.BaseRankName</dd></div>
                <div><dt>Nationality</dt><dd>@profile.Nationality</dd></div>
                <div><dt>Employment status</dt><dd>@profile.EmploymentStatus</dd></div>
                <div><dt>Hire date</dt><dd>@profile.HireDate.ToString("dd MMM yyyy")</dd></div>
                <div>
                    <dt>Passport expiry</dt>
                    <dd>
                        @profile.PassportExpiry.ToString("dd MMM yyyy")
                        @if (IsPassportExpiringSoon(profile.PassportExpiry))
                        {
                            <span class="crew-profile-passport-flag @(IsPassportExpired(profile.PassportExpiry) ? "crew-profile-indicator-expired" : "crew-profile-indicator-warning")"
                                  title="@(IsPassportExpired(profile.PassportExpiry) ? "Passport has expired" : "Passport expires within 6 months")">
                                <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                            </span>
                        }
                    </dd>
                </div>
                <div class="crew-profile-sensitive">
                    <dt>CDC number</dt>
                    <dd>
                        @if (isSensitiveDataRevealed)
                        {
                            @profile.CdcNumber
                        }
                        else
                        {
                            <span class="crew-profile-masked">••••••••••</span>
                        }
                    </dd>
                </div>
                <div class="crew-profile-sensitive">
                    <dt>Date of birth</dt>
                    <dd>
                        @if (isSensitiveDataRevealed)
                        {
                            @profile.DateOfBirth.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span class="crew-profile-masked">••••••••••</span>
                        }
                    </dd>
                </div>
                <div class="crew-profile-sensitive">
                    <dt>Passport number</dt>
                    <dd>
                        @if (isSensitiveDataRevealed)
                        {
                            @profile.PassportNumber
                        }
                        else
                        {
                            <span class="crew-profile-masked">••••••••••</span>
                        }
                    </dd>
                </div>
            </dl>
            <button type="button" class="crew-profile-reveal-button" aria-pressed="@isSensitiveDataRevealed.ToString().ToLowerInvariant()" @onclick="ToggleSensitiveData">
                <span class="bi @(isSensitiveDataRevealed ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                @(isSensitiveDataRevealed ? "Hide sensitive data" : "Show sensitive data")
            </button>

        </section>

        <div class="crew-profile-workspace">
            <section class="crew-profile-card" aria-labelledby="crew-profile-assignments-title">
                <div class="crew-profile-card-heading">
                    <div>
                        <h2 id="crew-profile-assignments-title">Assignments</h2>
                        <p>@profile.Assignments.Count on record @(profile.Assignments.Count > 0 ? "· click one to view details or plan a relief" : "")</p>
                    </div>
                    <span class="bi bi-ship" aria-hidden="true"></span>
                </div>

                @if (profile.Assignments.Count == 0)
                {
                    <EmptyState Title="No assignments on record" Message="Assign this crew member to a vessel to start tracking deployments." />
                }
                else
                {
                    <div class="crew-profile-list">
                        @foreach (var assignment in profile.Assignments)
                        {
                            var state = GetAssignmentState(assignment);
                            <button type="button" class="crew-profile-row crew-profile-row-clickable" @key="assignment.AssignmentId" @onclick="() => OpenAssignmentDetailsAsync(assignment)">
                                <div class="crew-profile-row-primary">
                                    <strong>@VesselDisplayName(assignment.VesselId)</strong>
                                    <span>@assignment.RankName</span>
                                </div>
                                <div class="crew-profile-row-secondary">
                                    <span>Signed on @assignment.SignOnDate.ToString("dd MMM yyyy")</span>
                                    <span>
                                        @(assignment.ActualSignOffDate is { } actual
                                            ? $"Signed off {actual:dd MMM yyyy}"
                                            : $"Planned off {assignment.PlannedSignOffDate:dd MMM yyyy}")
                                    </span>
                                </div>
                                <span class="crew-profile-indicator @state.Class">@state.Label</span>
                            </button>
                        }
                    </div>
                }

                @if (CanManage)
                {
                    <button type="button" class="crew-profile-edit-toggle crew-register-assignment-toggle" @onclick="() => registrationEditor = ProfileRegistration.Assignment"><span class="bi bi-plus-lg" aria-hidden="true"></span> Assign to vessel</button>
                }
            </section>

            <section class="crew-profile-card" aria-labelledby="crew-profile-certificates-title">
                <div class="crew-profile-card-heading">
                    <div>
                        <h2 id="crew-profile-certificates-title">Certificates</h2>
                        <p>@profile.Certificates.Count on record @(profile.Certificates.Count > 0 ? "· click one to view details" : "")</p>
                    </div>
                    <span class="bi bi-award" aria-hidden="true"></span>
                </div>

                @if (profile.Certificates.Count == 0)
                {
                    <EmptyState Title="No certificates on record" Message="Register a certificate to start tracking qualifications." />
                }
                else
                {
                    <div class="crew-profile-list">
                        @foreach (var certificate in profile.Certificates)
                        {
                            var state = GetCertificateState(certificate.ExpiryDate);
                            <button type="button" class="crew-profile-row crew-profile-row-clickable" @key="certificate.CertificateId" @onclick="() => OpenCertificateDetails(certificate)">
                                <div class="crew-profile-row-primary">
                                    <strong>@certificate.Name</strong>
                                    <span>@certificate.Type &middot; @certificate.IssuingAuthority</span>
                                </div>
                                <div class="crew-profile-row-secondary">
                                    <span>License @certificate.LicenseNumber</span>
                                    <span>Expires @certificate.ExpiryDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <span class="crew-profile-indicator @state.Class">@state.Label</span>
                            </button>
                        }
                    </div>
                }

                @if (CanManage)
                {
                    <button type="button" class="crew-profile-edit-toggle crew-register-certificate-toggle" @onclick="() => registrationEditor = ProfileRegistration.Certificate"><span class="bi bi-plus-lg" aria-hidden="true"></span> Register certificate</button>
                }
            </section>

        </div>

        <section class="crew-profile-card crew-medical-card" aria-labelledby="crew-profile-medical-title">
            <div class="crew-profile-card-heading">
                <div>
                    <h2 id="crew-profile-medical-title">Medical fitness</h2>
                    <p>@medicalExaminations.Count exam(s) on record</p>
                </div>
                <span class="bi bi-heart-pulse" aria-hidden="true"></span>
            </div>

            @if (isLoadingMedical)
            {
                <LoadingState Message="Loading medical examinations..." />
            }
            else if (medicalFailure is not null)
            {
                <ApiErrorState Title="@medicalFailure.Title" Message="@medicalFailure.Message" OnRetry="LoadMedicalExaminationsAsync" />
            }
            else
            {
                <div class="crew-medical-current-fitness">
                    <span>Current fitness</span>
                    <span class="crew-profile-indicator @CurrentFitnessDisplayState.Class">@CurrentFitnessDisplayState.Label</span>
                </div>

                @if (medicalExaminations.Count == 0)
                {
                    <EmptyState Title="No medical examinations on record" Message="Register an examination to start tracking medical fitness." />
                }
                else
                {
                    <div class="crew-profile-list">
                        @foreach (var exam in medicalExaminations)
                        {
                            var fitnessState = GetFitnessResultState(exam.FitnessResult);
                            var statusState = GetExamStatusState(exam);
                            <article class="crew-profile-row" @key="exam.MedicalExaminationId">
                                <div class="crew-profile-row-primary">
                                    <strong>@exam.ExamType</strong>
                                    <span>@exam.Clinic</span>
                                </div>
                                <div class="crew-profile-row-secondary">
                                    <span>Examined @exam.ExamDate.ToString("dd MMM yyyy")</span>
                                    <span>Expires @exam.ExpiryDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="crew-medical-row-badges">
                                    <span class="crew-profile-indicator @fitnessState.Class">@fitnessState.Label</span>
                                    <span class="crew-profile-indicator @statusState.Class">@statusState.Label</span>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (CanManage)
                {
                    <button type="button" class="crew-profile-edit-toggle crew-register-medical-toggle" @onclick="() => registrationEditor = ProfileRegistration.Medical"><span class="bi bi-plus-lg" aria-hidden="true"></span> Register medical examination</button>
                }
            }
        </section>

        <div class="crew-profile-workspace crew-profile-administration">
        <section class="crew-profile-card" aria-labelledby="crew-profile-employment-title">
            <div class="crew-profile-card-heading">
                <div>
                    <h2 id="crew-profile-employment-title">Employment status</h2>
                    <p>@employmentHistory.Count change(s) on record</p>
                </div>
                <span class="bi bi-person-badge" aria-hidden="true"></span>
            </div>

            @if (CanManage)
            {
                <button type="button" class="crew-profile-edit-toggle crew-employment-status-toggle" @onclick="RequestEmploymentStatusChange">Change employment status</button>
            }

            @if (isLoadingEmploymentHistory)
            {
                <LoadingState Message="Loading employment history..." />
            }
            else if (employmentHistoryFailure is not null)
            {
                <ApiErrorState Title="@employmentHistoryFailure.Title" Message="@employmentHistoryFailure.Message" OnRetry="LoadEmploymentHistoryAsync" />
            }
            else if (employmentHistory.Count == 0)
            {
                <EmptyState Title="No employment status changes on record" Message="Status changes will appear here once recorded." />
            }
            else
            {
                <div class="crew-profile-list">
                    @foreach (var entry in employmentHistory)
                    {
                        <article class="crew-profile-row" @key="entry.Id">
                            <div class="crew-profile-row-primary">
                                <strong>@entry.Status</strong>
                                <span>@(string.IsNullOrWhiteSpace(entry.Notes) ? "No notes" : entry.Notes)</span>
                            </div>
                            <div class="crew-profile-row-secondary">
                                <span>@entry.ChangedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="crew-profile-card" aria-labelledby="crew-profile-availability-title">
            <div class="crew-profile-card-heading">
                <div>
                    <h2 id="crew-profile-availability-title">Availability</h2>
                    <p>@availabilityItems.Count planned unavailability period(s)</p>
                </div>
                <span class="bi bi-calendar-x" aria-hidden="true"></span>
            </div>

            @if (CanManage)
            {
                <button type="button" class="crew-profile-edit-toggle crew-availability-request-toggle" @onclick="RequestUnavailability">Request unavailability</button>
            }

            @if (isLoadingAvailability)
            {
                <LoadingState Message="Loading availability..." />
            }
            else if (availabilityFailure is not null)
            {
                <ApiErrorState Title="@availabilityFailure.Title" Message="@availabilityFailure.Message" OnRetry="LoadAvailabilityAsync" />
            }
            else if (availabilityItems.Count == 0)
            {
                <EmptyState Title="No planned unavailability on record" Message="Approved unavailability blocks new assignments and reliefs over the same dates." />
            }
            else
            {
                <div class="crew-profile-list">
                    @foreach (var item in availabilityItems)
                    {
                        var isExpanded = expandedAvailabilityIds.Contains(item.Id);
                        <article class="crew-profile-row crew-availability-profile-row" @key="item.Id">
                            <button type="button" class="crew-availability-profile-row-heading" aria-expanded="@(isExpanded ? "true" : "false")" @onclick="() => ToggleAvailabilityExpanded(item.Id)">
                                <span><strong>@AvailabilityTypeLabel(item.Type)</strong> &middot; @item.StartDate.ToString("dd MMM yyyy") &ndash; @item.EndDate.ToString("dd MMM yyyy")</span>
                                <span class="crew-availability-status @($"crew-availability-status-{item.Status.ToLowerInvariant()}")">@item.Status</span>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="crew-availability-profile-detail">
                                    <p class="crew-availability-profile-reason">@item.Reason</p>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes)) { <p class="crew-availability-profile-notes">@item.Notes</p> }

                                    @if (item.History.Count > 0)
                                    {
                                        <ol class="crew-availability-profile-history">
                                            @foreach (var entry in item.History)
                                            {
                                                <li>
                                                    <span>@entry.EventType</span>
                                                    <span>@entry.OccurredAtUtc.ToString("dd MMM yyyy HH:mm") UTC</span>
                                                    @if (!string.IsNullOrWhiteSpace(entry.Reason)) { <span class="crew-availability-profile-history-reason">@entry.Reason</span> }
                                                </li>
                                            }
                                        </ol>
                                    }

                                    @if (CanManage && item.Status is "Requested" or "Approved")
                                    {
                                        <div class="crew-availability-profile-actions">
                                            @if (item.Status == "Requested")
                                            {
                                                <button type="button" class="crew-availability-approve" disabled="@isSubmittingAvailabilityDecision" @onclick="() => ApproveAvailabilityAsync(item.Id)">Approve</button>
                                                <button type="button" class="crew-availability-reject" disabled="@isSubmittingAvailabilityDecision" @onclick="@(() => BeginAvailabilityDecision(item.Id, "reject"))">Reject</button>
                                            }
                                            <button type="button" class="crew-availability-cancel" disabled="@isSubmittingAvailabilityDecision" @onclick="@(() => BeginAvailabilityDecision(item.Id, "cancel"))">Cancel</button>
                                        </div>

                                        @if (availabilityDecisionId == item.Id)
                                        {
                                            <form class="crew-availability-decision-form" @onsubmit="SubmitAvailabilityDecisionAsync" @onsubmit:preventDefault="true">
                                                <label for="availability-decision-reason">@(availabilityDecisionKind == "reject" ? "Rejection reason" : "Cancellation reason")</label>
                                                <input id="availability-decision-reason" type="text" @bind="availabilityDecisionReason" maxlength="500" />
                                                <div class="crew-availability-decision-form-actions">
                                                    <button type="submit" class="crew-availability-decision-submit" disabled="@isSubmittingAvailabilityDecision">Confirm</button>
                                                    <button type="button" @onclick="CancelAvailabilityDecision">Keep</button>
                                                </div>
                                            </form>
                                        }

                                        @if (availabilityActionId == item.Id && availabilityActionError is not null)
                                        {
                                            <div class="crew-profile-form-error" role="alert">@availabilityActionError</div>
                                        }
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        </div>

        </div>
        @if (CanManage && IsProfileEditorOpen)
        {
            <div class="crew-assignment-modal-backdrop crew-profile-editor-backdrop" @onclick="CloseProfileEditor" @onkeydown="HandleProfileEditorKeyDown">
                <section class="crew-assignment-modal crew-profile-editor" role="dialog" aria-modal="true" aria-labelledby="crew-profile-editor-title" tabindex="-1" @ref="profileEditorElement" @onclick:stopPropagation="true">
                    <div class="crew-assignment-modal-heading">
                        <div><p class="crew-assignment-modal-eyebrow">@profile.FirstName @profile.LastName</p><h2 id="crew-profile-editor-title">@ProfileEditorTitle</h2></div>
                        <button type="button" class="crew-assignment-modal-close" aria-label="Close form" @onclick="CloseProfileEditor" disabled="@IsProfileEditorBusy"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
                    </div>
                    @if (isEditingProfile)
                    {
                        <EditCrewMemberProfileForm @ref="profileEditorForm" CrewMemberId="CrewMemberId"
                                                    FirstName="@profile.FirstName"
                                                    LastName="@profile.LastName"
                                                    DateOfBirth="profile.DateOfBirth"
                                                    Nationality="@profile.Nationality"
                                                    PassportNumber="@profile.PassportNumber"
                                                    PassportExpiry="profile.PassportExpiry"
                                                    CdcNumber="@profile.CdcNumber"
                                                    HireDate="profile.HireDate"
                                                    BaseRankId="profile.BaseRankId"
                                                    OnUpdated="OnProfileUpdatedAsync" />
                    }

                    @if (registrationEditor == ProfileRegistration.Assignment)
                    {
                        <AssignToVesselForm @ref="assignmentEditorForm" CrewMemberId="CrewMemberId" CrewMemberName="@($"{profile.FirstName} {profile.LastName}")" OnRegistered="OnAssignmentRegisteredAsync" />
                    }
                    @if (registrationEditor == ProfileRegistration.Certificate)
                    {
                        <RegisterCertificateForm @ref="certificateEditorForm" CrewMemberId="CrewMemberId" OnRegistered="OnCertificateRegisteredAsync" />
                    }
                    @if (registrationEditor == ProfileRegistration.Medical)
                    {
                        <RegisterMedicalExaminationForm @ref="medicalEditorForm" CrewMemberId="CrewMemberId" OnRegistered="OnMedicalExaminationRegisteredAsync" />
                    }
                    @if (employmentStatusActionError is not null)
                    {
                        <div class="crew-profile-form-error" role="alert">@employmentStatusActionError</div>
                    }

                    @if (isConfirmingEmploymentStatusChange)
                    {
                        <form class="crew-profile-form-grid" @onsubmit="ConfirmEmploymentStatusChangeAsync" @onsubmit:preventDefault="true">
                            <div class="crew-profile-form-field">
                                <label for="employment-status-select">New status</label>
                                <select id="employment-status-select" @bind="employmentStatusForm.Status">
                                    @foreach (var option in EmploymentStatusOptions)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            </div>
                            <div class="crew-profile-form-field crew-profile-form-field-wide">
                                <label for="employment-status-notes">Notes</label>
                                <input id="employment-status-notes" type="text" @bind="employmentStatusForm.Notes" maxlength="1000" placeholder="Optional note" />
                            </div>
                            <button type="submit" class="crew-profile-form-submit" disabled="@isSubmittingEmploymentStatus">
                                @(isSubmittingEmploymentStatus ? "Saving..." : "Confirm status change")
                            </button>
                            <button type="button" class="crew-rotation-edit-toggle" @onclick="CancelEmploymentStatusChange">Cancel</button>
                        </form>
                    }

                    @if (isRequestingUnavailability)
                    {
                        <form class="crew-profile-form-grid" @onsubmit="SubmitUnavailabilityRequestAsync" @onsubmit:preventDefault="true">
                            <div class="crew-profile-form-field">
                                <label for="availability-type">Type</label>
                                <select id="availability-type" @bind="availabilityRequestForm.Type">
                                    @foreach (var option in AvailabilityTypeOptions)
                                    {
                                        <option value="@option">@AvailabilityTypeLabel(option)</option>
                                    }
                                </select>
                            </div>
                            <div class="crew-profile-form-field">
                                <label for="availability-start">Start date</label>
                                <input id="availability-start" type="date" @bind="availabilityRequestForm.StartDate" />
                            </div>
                            <div class="crew-profile-form-field">
                                <label for="availability-end">End date</label>
                                <input id="availability-end" type="date" @bind="availabilityRequestForm.EndDate" />
                            </div>
                            <div class="crew-profile-form-field crew-profile-form-field-wide">
                                <label for="availability-reason">Reason</label>
                                <input id="availability-reason" type="text" @bind="availabilityRequestForm.Reason" maxlength="500" />
                            </div>
                            <div class="crew-profile-form-field crew-profile-form-field-wide">
                                <label for="availability-notes">Notes</label>
                                <input id="availability-notes" type="text" @bind="availabilityRequestForm.Notes" maxlength="1000" placeholder="Optional" />
                            </div>
                            <button type="submit" class="crew-profile-form-submit" disabled="@isSubmittingAvailabilityRequest">
                                @(isSubmittingAvailabilityRequest ? "Submitting..." : "Submit request")
                            </button>
                            <button type="button" class="crew-rotation-edit-toggle" @onclick="CancelUnavailabilityRequest">Cancel</button>
                        </form>

                        @if (availabilityRequestConflict is not null)
                        {
                            <div class="crew-profile-form-conflict" role="alert">@availabilityRequestConflict</div>
                        }
                        @if (availabilityRequestFieldErrors.Count > 0)
                        {
                            <ul class="crew-profile-form-field-errors" role="alert">
                                @foreach (var error in availabilityRequestFieldErrors) { <li>@error</li> }
                            </ul>
                        }
                        @if (availabilityRequestGeneralError is not null)
                        {
                            <div class="crew-profile-form-error" role="alert">@availabilityRequestGeneralError</div>
                        }
                    }

                </section>
            </div>
        }
        @if (selectedAssignment is not null)
        {
            var detailState = GetAssignmentState(selectedAssignment);
            <div class="crew-assignment-modal-backdrop" @onclick="CloseAssignmentDetails">
                <section class="crew-assignment-modal" role="dialog" aria-modal="true" aria-labelledby="crew-assignment-detail-title" @onclick:stopPropagation="true">
                    <div class="crew-assignment-modal-heading">
                        <div>
                            <p class="crew-assignment-modal-eyebrow">Crew assignment</p>
                            <h2 id="crew-assignment-detail-title">Assignment details</h2>
                        </div>
                        <button type="button" class="crew-assignment-modal-close" @onclick="CloseAssignmentDetails" aria-label="Close assignment details">
                            <span class="bi bi-x-lg" aria-hidden="true"></span>
                        </button>
                    </div>

                    <dl class="crew-assignment-modal-details">
                        <div><dt>Vessel</dt><dd>@VesselDisplayName(selectedAssignment.VesselId)</dd></div>
                        <div><dt>Rank</dt><dd>@selectedAssignment.RankName</dd></div>
                        <div><dt>Sign-on date</dt><dd>@selectedAssignment.SignOnDate.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Planned sign-off date</dt><dd>@selectedAssignment.PlannedSignOffDate.ToString("dd MMM yyyy")</dd></div>
                        @if (selectedAssignment.ActualSignOffDate is { } actualSignOff)
                        {
                            <div><dt>Actual sign-off date</dt><dd>@actualSignOff.ToString("dd MMM yyyy")</dd></div>
                        }
                        <div><dt>Status</dt><dd><span class="crew-profile-indicator @detailState.Class">@detailState.Label</span></dd></div>
                    </dl>

                    @if (assignmentActionError is not null)
                    {
                        <div class="crew-assignment-modal-error" role="alert">@assignmentActionError</div>
                    }

                    @if (!isLoadingQualification && qualificationEligibility is { Status: "NotQualified" } notQualified)
                    {
                        <div class="crew-qualification-warning" role="alert">
                            <strong>Certificate gap for this rank:</strong> missing @string.Join(", ", notQualified.MissingTypes).
                            @if (notQualified.UncoveredDates.Count > 0)
                            {
                                <span>
                                    Uncovered:
                                    @string.Join("; ", notQualified.UncoveredDates.Select(range => $"{range.RequiredType} {range.StartDate:dd MMM yyyy}–{range.EndDate:dd MMM yyyy}"))
                                </span>
                            }
                            <span>A renewal can still be arranged before activation.</span>
                        </div>
                    }

                    @if (selectedAssignment.ActualSignOffDate is null)
                    {
                        <div class="crew-rotation-section">
                            <h3>Relief planning</h3>

                            @if (isLoadingRotation)
                            {
                                <p class="crew-assignment-modal-hint">Loading rotation...</p>
                            }
                            else
                            {
                                @if (rotationLoadError is not null)
                                {
                                    <div class="crew-assignment-modal-error" role="alert">@rotationLoadError</div>
                                }

                                @if (rotationExists && selectedRotation is not null)
                                {
                                    <div class="crew-rotation-summary">
                                        <div class="crew-rotation-summary-row">
                                            <span>Relieving member</span>
                                            @if (selectedRotation.RelievingCrewMemberId is { } relievingId)
                                            {
                                                <a href="@($"/crew/{relievingId}")">@selectedRotation.RelievingCrewMemberName</a>
                                            }
                                            else
                                            {
                                                <strong>Not selected</strong>
                                            }
                                        </div>
                                        <div class="crew-rotation-summary-row"><span>Pattern</span><strong>@selectedRotation.RotationPattern</strong></div>
                                        <div class="crew-rotation-summary-row"><span>Planned relief</span><strong>@selectedRotation.PlannedReliefDate.ToString("dd MMM yyyy")</strong></div>
                                        @if (selectedRotation.IsOverdue)
                                        {
                                            <span class="crew-profile-indicator crew-profile-indicator-expired">Overdue</span>
                                        }
                                        @if (CanManage)
                                        {
                                            <button type="button" class="crew-rotation-edit-toggle" @onclick="ToggleEditRotation">
                                                @(isEditingRotation ? "Cancel" : "Edit")
                                            </button>
                                        }
                                    </div>
                                }

                                @if (rotationConflictMessage is not null)
                                {
                                    <div class="crew-profile-form-conflict" role="alert">@rotationConflictMessage</div>
                                }

                                @if (rotationGeneralError is not null)
                                {
                                    <div class="crew-profile-form-error" role="alert">@rotationGeneralError</div>
                                }

                                @if (rotationFieldErrors.Count > 0)
                                {
                                    <ul class="crew-profile-form-field-errors" role="alert">
                                        @foreach (var message in rotationFieldErrors)
                                        {
                                            <li>@message</li>
                                        }
                                    </ul>
                                }

                                @if (rotationSuccessMessage is not null)
                                {
                                    <div class="crew-profile-form-success" role="status">@rotationSuccessMessage</div>
                                }

                                @if (CanManage && (!rotationExists || isEditingRotation))
                                {
                                    <form class="crew-profile-form-grid" @onsubmit="SaveRotationAsync" @onsubmit:preventDefault="true">
                                        <div class="crew-profile-form-field crew-profile-form-field-wide">
                                            <label for="rotation-relieving-member">Relieving member</label>
                                            <RelievingMemberPicker @key="relievingMemberPickerResetToken" InputId="rotation-relieving-member" @bind-Value="rotationForm.RelievingCrewMemberId" ExcludeCrewMemberId="CrewMemberId" Placeholder="Search crew member by name..." />
                                        </div>
                                        <div class="crew-profile-form-field">
                                            <label for="rotation-pattern">Rotation pattern</label>
                                            <select id="rotation-pattern" @bind="rotationForm.RotationPattern">
                                                <option value="">Select...</option>
                                                @foreach (var option in RotationPatternOptions)
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="crew-profile-form-field">
                                            <label for="rotation-planned-relief-date">Planned relief date</label>
                                            <input id="rotation-planned-relief-date" type="date" @bind="rotationForm.PlannedReliefDate" min="@AssignToVesselForm.FormatIsoDate(selectedAssignment.SignOnDate)" />
                                        </div>
                                        <button type="submit" class="crew-profile-form-submit" disabled="@isSavingRotation">
                                            @(isSavingRotation ? "Saving..." : rotationExists ? "Update rotation" : "Plan rotation")
                                        </button>
                                    </form>
                                }

                                @if (CanManage && rotationExists && !isEditingRotation && rotationForm.RelievingCrewMemberId is not null)
                                {
                                    @if (executeRotationError is not null)
                                    {
                                        <div class="crew-assignment-modal-error" role="alert">@executeRotationError</div>
                                    }

                                    @if (isConfirmingRotationExecution)
                                    {
                                        <div class="crew-assignment-confirmation"><span>Confirm executing this relief?</span><button type="button" @onclick="ExecuteRotationAsync">Confirm</button><button type="button" @onclick="CancelRotationExecution">Cancel</button></div>
                                    }
                                    else
                                    {
                                        <button type="button" class="crew-rotation-execute" disabled="@isExecutingRotation" @onclick="RequestRotationExecution">
                                            @(isExecutingRotation ? "Executing..." : "Execute relief")
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }

                    @if (CanManage)
                    {
                        @if (selectedAssignment.Status is "Planned" or "Active")
                        {
                            <section class="crew-assignment-lifecycle-actions" aria-label="Assignment lifecycle actions">
                                <div class="crew-assignment-action-heading">
                                    <div>
                                        <p>Assignment lifecycle</p>
                                        <h3>Update assignment</h3>
                                    </div>
                                    <span>Changes are retained in the assignment history.</span>
                                </div>
                                @if (string.Equals(selectedAssignment.Status, "Planned", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="crew-assignment-activate" @onclick="RequestActivation">Activate assignment</button>
                                }
                                <div class="crew-assignment-action-row">
                                    <label>Actual sign-off date <input type="date" @bind="completionDate" min="@AssignToVesselForm.FormatIsoDate(selectedAssignment.SignOnDate)" /></label>
                                    <button type="button" @onclick="RequestCompletion">Complete assignment</button>
                                </div>
                                <div class="crew-assignment-action-row crew-assignment-cancel-row">
                                    <label>Cancellation notes <input type="text" @bind="cancellationNotes" maxlength="1000" placeholder="Optional note" /></label>
                                    <button type="button" class="crew-assignment-modal-delete" @onclick="RequestCancellation">Cancel assignment</button>
                                </div>
                            </section>

                            @if (pendingAssignmentAction is not null)
                            {
                                <div class="crew-assignment-confirmation"><span>Confirm @pendingAssignmentAction this assignment?</span><button type="button" disabled="@isProcessingAssignmentAction" @onclick="ConfirmAssignmentActionAsync">Confirm</button><button type="button" @onclick="CancelAssignmentAction">Cancel</button></div>
                            }
                        }
                        else
                        {
                            <p class="crew-assignment-modal-hint">This @selectedAssignment.Status.ToLowerInvariant() assignment is retained as operational history.</p>
                        }
                    }
                </section>
            </div>
        }

        @if (selectedCertificate is not null)
        {
            var certificateState = GetCertificateState(selectedCertificate.ExpiryDate);
            <div class="crew-assignment-modal-backdrop" @onclick="CloseCertificateDetails">
                <section class="crew-assignment-modal" role="dialog" aria-modal="true" aria-labelledby="crew-certificate-detail-title" @onclick:stopPropagation="true">
                    <div class="crew-profile-card-heading">
                        <h2 id="crew-certificate-detail-title">Certificate details</h2>
                        <button type="button" class="crew-assignment-modal-close" @onclick="CloseCertificateDetails" aria-label="Close certificate details">
                            <span class="bi bi-x-lg" aria-hidden="true"></span>
                        </button>
                    </div>

                    <dl class="crew-assignment-modal-details">
                        <div><dt>Type</dt><dd>@selectedCertificate.Type</dd></div>
                        <div><dt>Name</dt><dd>@selectedCertificate.Name</dd></div>
                        <div><dt>Issuing authority</dt><dd>@selectedCertificate.IssuingAuthority</dd></div>
                        <div><dt>License number</dt><dd>@selectedCertificate.LicenseNumber</dd></div>
                        <div><dt>Issue date</dt><dd>@selectedCertificate.IssueDate.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Expiry date</dt><dd>@selectedCertificate.ExpiryDate.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Status</dt><dd><span class="crew-profile-indicator @certificateState.Class">@certificateState.Label</span></dd></div>
                    </dl>
                </section>
            </div>
        }
    }
</section>
