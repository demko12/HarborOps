@using HarborOps.Web.Api
@using HarborOps.Web.Components.Shared
@inject CrewApiClient CrewApi

<section class="crew-profile-form" aria-labelledby="crew-assignment-form-title">
    <div class="crew-profile-form-header">
        <h3 id="crew-assignment-form-title">Assign to vessel</h3>
    </div>

    @if (conflictMessage is not null)
    {
        <div class="crew-profile-form-conflict" role="alert">@conflictMessage</div>
    }

    @if (generalError is not null)
    {
        <div class="crew-profile-form-error" role="alert">@generalError</div>
    }

    @if (unmappedErrors.Count > 0)
    {
        <ul class="crew-profile-form-field-errors" role="alert">
            @foreach (var message in unmappedErrors)
            {
                <li>@message</li>
            }
        </ul>
    }

    @if (successMessage is not null)
    {
        <div class="crew-profile-form-success" role="status">@successMessage</div>
    }

    <EditForm EditContext="editContext" OnSubmit="SubmitAsync" class="crew-profile-form-grid">
        <DataAnnotationsValidator />

        <div class="crew-profile-form-field">
            <label for="assign-vessel">Vessel</label>
            <VesselPicker @key="vesselPickerResetToken" @bind-Value="model.VesselId" Placeholder="Search vessel by name or IMO..." />
            <ValidationMessage For="() => model.VesselId" />
        </div>

        <div class="crew-profile-form-field">
            <label for="assign-rank">Rank</label>
            <InputSelect id="assign-rank" @bind-Value="model.RankId" disabled="@(isLoadingPositions || positionOptions.Count == 0)">
                <option value="">@RankPlaceholder</option>
                @foreach (var option in positionOptions)
                {
                    <option value="@option.CrewPositionId">@option.RankName (@option.Department)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => model.RankId" />
        </div>

        <div class="crew-profile-form-field">
            <label for="assign-sign-on-date">Sign-on date</label>
            <InputDate id="assign-sign-on-date" @bind-Value="model.SignOnDate" />
            <ValidationMessage For="() => model.SignOnDate" />
        </div>

        <div class="crew-profile-form-field">
            <label for="assign-planned-sign-off-date">Planned sign-off date</label>
            <InputDate id="assign-planned-sign-off-date" @bind-Value="model.PlannedSignOffDate" />
            <ValidationMessage For="() => model.PlannedSignOffDate" />
        </div>

        <button type="submit" class="crew-profile-form-submit" disabled="@isSubmitting">
            @(isSubmitting ? "Assigning..." : "Assign to vessel")
        </button>
    </EditForm>
</section>
