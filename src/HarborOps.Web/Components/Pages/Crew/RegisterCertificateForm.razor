@using HarborOps.Web.Api
@inject CrewApiClient CrewApi

<section class="crew-profile-form" aria-labelledby="crew-certificate-form-title">
    <div class="crew-profile-form-header">
        <h3 id="crew-certificate-form-title">Register certificate</h3>
    </div>

    @if (conflictMessage is not null)
    {
        <div class="crew-profile-form-conflict" role="alert">@conflictMessage</div>
    }

    @if (generalError is not null)
    {
        <div class="crew-profile-form-error" role="alert">@generalError</div>
    }

    @if (unmappedErrors.Count > 0)
    {
        <ul class="crew-profile-form-field-errors" role="alert">
            @foreach (var message in unmappedErrors)
            {
                <li>@message</li>
            }
        </ul>
    }

    @if (successMessage is not null)
    {
        <div class="crew-profile-form-success" role="status">@successMessage</div>
    }

    <EditForm EditContext="editContext" OnSubmit="SubmitAsync" class="crew-profile-form-grid">
        <DataAnnotationsValidator />

        <div class="crew-profile-form-field">
            <label for="cert-type">Type</label>
            <InputText id="cert-type" @bind-Value="model.Type" maxlength="100" />
            <ValidationMessage For="() => model.Type" />
        </div>
        <div class="crew-profile-form-field">
            <label for="cert-name">Name</label>
            <InputText id="cert-name" @bind-Value="model.Name" maxlength="200" />
            <ValidationMessage For="() => model.Name" />
        </div>
        <div class="crew-profile-form-field">
            <label for="cert-authority">Issuing authority</label>
            <InputText id="cert-authority" @bind-Value="model.IssuingAuthority" maxlength="200" />
            <ValidationMessage For="() => model.IssuingAuthority" />
        </div>
        <div class="crew-profile-form-field">
            <label for="cert-license">License number</label>
            <InputText id="cert-license" @bind-Value="model.LicenseNumber" maxlength="100" />
            <ValidationMessage For="() => model.LicenseNumber" />
        </div>
        <div class="crew-profile-form-field">
            <label for="cert-issue-date">Issue date</label>
            <InputDate id="cert-issue-date" @bind-Value="model.IssueDate" />
            <ValidationMessage For="() => model.IssueDate" />
        </div>
        <div class="crew-profile-form-field">
            <label for="cert-expiry-date">Expiry date</label>
            <InputDate id="cert-expiry-date" @bind-Value="model.ExpiryDate" />
            <ValidationMessage For="() => model.ExpiryDate" />
        </div>

        <button type="submit" class="crew-profile-form-submit" disabled="@isSubmitting">
            @(isSubmitting ? "Registering..." : "Register certificate")
        </button>
    </EditForm>
</section>
