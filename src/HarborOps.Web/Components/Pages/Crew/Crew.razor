@page "/crew"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCrew")]
@implements IDisposable
@inject CrewApiClient CrewApi

<PageTitle>Crew | HarborOps</PageTitle>

<section class="crew-page" aria-busy="@isLoading.ToString().ToLowerInvariant()">
    <header class="crew-header">
        <div>
            <p class="crew-eyebrow">Crewing operations</p>
            <h1>Your crew, connected</h1>
            <p>People, credentials, and readiness across your operations.</p>
        </div>
        <div class="crew-header-actions">
            <PrintButton Label="Print the crew roster" />
        </div>
    </header>

    <nav class="crew-links" aria-label="Crew workspace links">
        <a class="selected" href="/crew" aria-current="page"><span class="bi bi-people" aria-hidden="true"></span> Personnel</a>
        <a  href="/crew/rotations" title="View crew rotations"><span class="bi bi-arrow-left-right" aria-hidden="true"></span> Rotations</a>
        <a  href="/crew/availability" title="Manage crew availability"><span class="bi bi-calendar-x" aria-hidden="true"></span> Availability</a>
        <a  href="/crew/manning" title="Manage crew manning plans and coverage"><span class="bi bi-clipboard-check" aria-hidden="true"></span> Manning</a>
        <a  href="/crew/medical" title="View crew medical exams"><span class="bi bi-heart-pulse" aria-hidden="true"></span> Medical</a>
        <a  href="/crew/positions" title="Manage crew positions"><span class="bi bi-person-badge" aria-hidden="true"></span> Positions</a>
        <a href="/crew/qualification-policies" title="Manage crew qualification policies"><span class="bi bi-patch-check" aria-hidden="true"></span> Qualifications</a>
    </nav>

    <section class="print-only print-summary crew-print-summary">
        <h2>Personnel register</h2>
        <dl>
            <div><dt>Search</dt><dd>@(string.IsNullOrWhiteSpace(search) ? "All crew members" : search)</dd></div>
            <div><dt>Employment status</dt><dd>@(string.IsNullOrWhiteSpace(employmentStatus) ? "All statuses" : employmentStatus)</dd></div>
            <div><dt>Page</dt><dd>@(roster?.PageNumber ?? 1) of @TotalPages</dd></div>
            <div><dt>Crew members</dt><dd>@FirstRowNumber&ndash;@LastRowNumber of @(roster?.TotalCount ?? 0)</dd></div>
        </dl>
    </section>

    @if (roster is not null && !isLoading && failure is null)
    {
        <section class="crew-summary" aria-label="Crew summary">
            <article class="crew-summary-card"><div><span>Matching crew</span><strong>@(roster.TotalCount)</strong><small>Across the current filters</small></div><span class="crew-summary-icon crew-summary-blue"><span class="bi bi-people"></span></span></article>
            <article class="crew-summary-card"><div><span>Active crew</span><strong>@ActiveCrew</strong><small>On this page</small></div><span class="crew-summary-icon crew-summary-green"><span class="bi bi-person-check"></span></span></article>
            <article class="crew-summary-card"><div><span>Expired passports</span><strong>@ExpiredPassports</strong><small>Expired on this page</small></div><span class="crew-summary-icon crew-summary-red"><span class="bi bi-passport"></span></span></article>
            <article class="crew-summary-card"><div><span>Expiring in 90 days</span><strong>@PassportsExpiringSoon</strong><small>Renewals on this page</small></div><span class="crew-summary-icon crew-summary-amber"><span class="bi bi-calendar-event"></span></span></article>
        </section>
    }

    <div class="crew-workspace">
    <section class="crew-card @(cardView ? "crew-card-view" : "crew-list-view")" aria-labelledby="crew-roster-title">
        <div class="crew-card-heading"><div class="crew-register-title"><span class="crew-register-mark bi bi-people" aria-hidden="true"></span><div><h2 id="crew-roster-title">Personnel register</h2><p>@(isLoading ? "Updating roster…" : failure is not null ? "Unable to load roster" : $"{roster?.TotalCount ?? 0:N0} crew members found")</p></div></div>
            <div class="crew-view-switch" role="group" aria-label="Crew display">
                <button type="button" aria-label="Card view" aria-pressed="@cardView.ToString().ToLowerInvariant()" @onclick="() => cardView = true"><span class="bi bi-grid" aria-hidden="true"></span> Cards</button>
                <button type="button" aria-label="List view" aria-pressed="@((!cardView).ToString().ToLowerInvariant())" @onclick="() => cardView = false"><span class="bi bi-list-ul" aria-hidden="true"></span> List</button>
            </div>
        </div>
    <div class="crew-filters">
        <div class="crew-input-shell"><span class="bi bi-search" aria-hidden="true"></span><input @bind="search" @bind:event="oninput" @bind:after="SearchAsync" placeholder="Search name or IMO seafarer ID" aria-label="Search crew members" /></div>
        <div class="crew-status-select"><select @bind="employmentStatus" @bind:after="SearchAsync" aria-label="Filter by employment status"><option value="">All statuses</option><option value="Active">Active</option><option value="OnLeave">On leave</option><option value="Suspended">Suspended</option><option value="Terminated">Terminated</option></select><span class="bi bi-chevron-down" aria-hidden="true"></span></div>
        <button type="button" class="crew-reset-button" @onclick="ResetFiltersAsync" disabled="@isLoading">Reset</button>
    </div>


        @if (isLoading)
        {
            <LoadingState Message="Loading crew roster..." />
        }
        else if (failure is not null)
        {
            <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="LoadRosterAsync" />
        }
        else if (roster is null || roster.Items.Count == 0)
        {
            <EmptyState Title="No crew members found" Message="Try another name, IMO seafarer ID, or employment status." />
        }
        else
        {
            <div class="crew-list-labels" aria-hidden="true"><span></span><span>Crew member</span><span>Rank</span><span>Passport</span><span>Status</span></div>
            <div class="crew-roster-list">
                @foreach (var member in roster.Items)
                {
                    var passportState = GetPassportState(member.PassportExpiry, currentDate);
                    <a class="crew-member-row" data-status="@GetEmploymentStatusClass(member.EmploymentStatus)" href="@($"/crew/{member.CrewMemberId}")">
                        <span class="crew-avatar">@member.Name[0]</span>
                        <div class="crew-member-primary"><strong>@member.Name</strong><span class="crew-identity"><span class="crew-nationality-tag">@member.Nationality</span> IMO @member.ImoSeafarerId</span></div>
                        <div class="crew-rank"><span>Base rank</span><strong>@member.BaseRankName</strong></div>
                        <div class="crew-passport @passportState.Class"><span>Passport expiry</span><strong>@member.PassportExpiry.ToString("dd MMM yyyy")</strong>@if (passportState.IsExpired) { <small><span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Expired</small> } else if (member.PassportExpiry <= currentDate.AddDays(90)) { <small class="passport-renewal">Renew within 90 days</small> }</div>
                        <span class="employment-status @GetEmploymentStatusClass(member.EmploymentStatus)">@member.EmploymentStatus</span>
                        <span class="crew-profile-link">View profile <span class="bi bi-arrow-up-right" aria-hidden="true"></span></span>
                    </a>
                }
            </div>
            <div class="crew-pagination"><span>Showing @FirstRowNumber&ndash;@LastRowNumber of @roster.TotalCount crew members</span><div><button type="button" @onclick="PreviousPageAsync" disabled="@(roster.PageNumber <= 1)">Previous</button><span class="crew-page-indicator">Page @roster.PageNumber of @TotalPages</span><button type="button" @onclick="NextPageAsync" disabled="@(roster.PageNumber >= TotalPages)">Next</button></div></div>
        }
    </section>
    @if (roster is not null && !isLoading && failure is null)
    {
        <aside class="crew-insights" aria-label="Crew roster insights">
            <section class="crew-insight-card">
                <div class="crew-insight-heading"><h2>Rank distribution</h2><span class="bi bi-bar-chart" aria-hidden="true"></span></div>
                @if (RankDistribution.Count == 0)
                {
                    <p class="crew-insight-empty"><span class="bi bi-info-circle"></span> No rank data matches the current filters.</p>
                }
                else
                {
                    <div class="rank-distribution">
                        @foreach (var rank in RankDistribution)
                        {
                            <div class="rank-distribution-row"><div><span>@rank.Name</span><strong>@rank.Count</strong></div><span class="rank-distribution-bar"><span style="width: @rank.Percentage%"></span></span></div>
                        }
                    </div>
                }
                <p class="crew-insight-note">Based on the current roster page.</p>
            </section>
            <section class="crew-insight-card">
                <div class="crew-insight-heading"><h2>Passport attention</h2><span class="bi bi-passport" aria-hidden="true"></span></div>
                @if (PassportAttention.Count == 0)
                {
                    <p class="crew-insight-empty"><span class="bi bi-check2-circle"></span> No expired or soon-expiring passports on this page.</p>
                }
                else
                {
                    <div class="passport-attention-list">
                        @foreach (var member in PassportAttention)
                        {
                            <div><span class="bi bi-exclamation-triangle" aria-hidden="true"></span><p><strong>@member.Name</strong><small>Expires @member.PassportExpiry.ToString("dd MMM yyyy")</small></p></div>
                        }
                    </div>
                }
            </section>
        </aside>
    }
    </div>
</section>
