@page "/reports/documents-expiry"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessReports")]
@using HarborOps.Web.Api.Fleet
@using HarborOps.Web.Api.Reports
@implements IDisposable
@inject ReportsApiClient ReportsApi
@inject FleetApiClient FleetApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Documents expiry report | HarborOps</PageTitle>

<section class="reports-page">
    <header class="reports-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/reports">Reporting</a><span aria-hidden="true">/</span><span>Documents expiry</span></nav>
            <h1>Documents expiry</h1>
            <p>Review vessel documents that are expired or due to expire.</p>
        </div>
    </header>

    <ReportsNavigation />

    @if (!AuthorizationState.CanAccessDocuments)
    {
        <section class="reports-card">
            <EmptyState Title="Report not available" Message="Your account does not have permission to view the documents expiry report." />
        </section>
    }
    else
    {
        @if (filterValidationMessage is not null)
        {
            <div class="reports-validation" role="alert">
                <strong>Check the filters</strong>
                <ul>
                    <li>@filterValidationMessage</li>
                </ul>
            </div>
        }

        <div class="reports-kpis" aria-label="Report summary">
            <div class="reports-kpi"><div><span class="reports-kpi-label">Expired</span><strong>@(overview?.Expired.ToString() ?? "—")</strong><span class="reports-kpi-note">Expiry date already passed</span></div><span class="reports-kpi-icon bi bi-calendar-x" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Due within 30 days</span><strong>@(overview?.DueSoon.ToString() ?? "—")</strong><span class="reports-kpi-note">Renew before they lapse</span></div><span class="reports-kpi-icon bi bi-calendar-event" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Due in 31–90 days</span><strong>@(overview?.DueLater.ToString() ?? "—")</strong><span class="reports-kpi-note">Plan the next surveys</span></div><span class="reports-kpi-icon bi bi-calendar-range" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Matching documents</span><strong>@totalCount</strong><span class="reports-kpi-note">As of @reportAsOf.ToString("dd MMM yyyy")</span></div><span class="reports-kpi-icon bi bi-files" aria-hidden="true"></span></div>
        </div>

        @if (overview is { } summary && totalCount > 0)
        {
            <section class="reports-charts reports-charts-even" aria-label="Documents needing attention">
                <div class="reports-card reports-chart-card">
                    <div class="reports-chart-heading">
                        <div><span class="reports-section-label">Status mix</span><h2>Where the @totalCount documents stand</h2></div>
                    </div>
                    <div class="reports-ring-row">
                        <div class="reports-ring reports-status-mix" style="@StatusMixGradient(summary, totalCount)" role="img" aria-label="@($"{Percent(totalCount - summary.Expired - summary.DueSoon - summary.DueLater, totalCount)}% valid beyond 90 days")">
                            <div><strong>@Percent(totalCount - summary.Expired - summary.DueSoon - summary.DueLater, totalCount)%</strong><span>valid &gt; 90 days</span></div>
                        </div>
                        <div class="reports-ring-legend">
                            <span><span class="reports-legend-swatch mix-expired"></span>Expired<strong>@summary.Expired</strong></span>
                            <span><span class="reports-legend-swatch mix-due-soon"></span>Due within 30 days<strong>@summary.DueSoon</strong></span>
                            <span><span class="reports-legend-swatch mix-due-later"></span>Due in 31–90 days<strong>@summary.DueLater</strong></span>
                            <span><span class="reports-legend-swatch phase-cargo"></span>Valid beyond 90 days<strong>@(totalCount - summary.Expired - summary.DueSoon - summary.DueLater)</strong></span>
                        </div>
                    </div>

                    <div class="reports-type-breakdown">
                        <div class="reports-chart-heading">
                            <div><span class="reports-section-label">By document type</span><h3>Due or expired in the next 90 days</h3></div>
                        </div>
                        @if (summary.Types.Count == 0)
                        {
                            <p class="reports-muted">Nothing expires in the next 90 days.</p>
                        }
                        else
                        {
                            var widest = summary.Types.Max(type => type.Expired + type.Due);

                            <div class="reports-port-bars">
                                @foreach (var type in summary.Types)
                                {
                                    <div class="reports-port-bar">
                                        <span class="reports-port-bar-name"><span title="@type.Name">@type.Name</span></span>
                                        <span class="reports-port-bar-track">
                                            <span class="reports-port-bar-segment mix-expired" style="width: @Percent(type.Expired, widest)%"></span>
                                            <span class="reports-port-bar-segment phase-cargo" style="width: @Percent(type.Due, widest)%"></span>
                                        </span>
                                        <strong>@(type.Expired + type.Due)</strong>
                                    </div>
                                }
                            </div>
                            <div class="reports-chart-legend">
                                <span><span class="reports-legend-swatch mix-expired"></span>Expired</span>
                                <span><span class="reports-legend-swatch phase-cargo"></span>Due within 90 days</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="reports-card reports-chart-card">
                    <div class="reports-chart-heading">
                        <div><span class="reports-section-label">By vessel</span><h2>Vessels that need attention first</h2></div>
                    </div>
                    @if (summary.Vessels.Count == 0)
                    {
                        <p class="reports-muted">No vessel has an expired document or one due within 30 days.</p>
                    }
                    else
                    {
                        <div class="reports-attention-list">
                            @foreach (var vessel in summary.Vessels)
                            {
                                <div class="reports-attention-row">
                                    <div><strong>@VesselDisplayName(vessel.VesselId)</strong><span>@MostUrgentLabel(vessel.MostUrgent)</span></div>
                                    <span class="reports-status reports-status-expired">@vessel.Expired expired</span>
                                    <span class="reports-status reports-status-warning">@vessel.DueSoon due ≤ 30 d</span>
                                </div>
                            }
                        </div>
                    }
                    @if (summary.AttentionTruncated)
                    {
                        <p class="reports-muted">Based on the first @DocumentsExpiryReportPageSizeLimit documents due within 90 days.</p>
                    }
                </div>
            </section>
        }

        <section class="reports-card" aria-labelledby="reports-list-title">
            <div class="reports-card-heading">
                <div class="reports-register-heading">
                    <span class="reports-register-icon bi bi-bar-chart" aria-hidden="true"></span>
                    <div><span class="reports-section-label">Report results</span><h2 id="reports-list-title">Documents expiry register</h2><p>@totalCount records as of @reportAsOf.ToString("dd MMM yyyy")</p></div>
                </div>
                <a class="reports-download-button" href="@BuildDownloadUrl()">
                    <span class="bi bi-download" aria-hidden="true"></span> Download CSV
                </a>
            </div>

            <section class="reports-filters" aria-label="Report filters">
                <div class="filter-field">
                    <label for="reports-as-of">As of</label>
                    <input id="reports-as-of" type="date" @bind="asOfFilter" @bind:after="SearchAsync" />
                </div>
                <div class="filter-field filter-field-wide">
                    <label for="reports-vessel">Vessel</label>
                    <VesselPicker @key="vesselPickerResetToken" Value="vesselIdFilter" ValueChanged="OnVesselFilterChangedAsync" Placeholder="All vessels" />
                </div>
                <div class="filter-field">
                    <label for="reports-doc-from">From</label>
                    <input id="reports-doc-from" type="date" @bind="documentsFromFilter" @bind:after="SearchAsync" />
                </div>
                <div class="filter-field">
                    <label for="reports-doc-to">To</label>
                    <input id="reports-doc-to" type="date" @bind="documentsToFilter" @bind:after="SearchAsync" />
                </div>
                <div class="filter-field">
                    <label for="reports-doc-status">Status</label>
                    <select id="reports-doc-status" @bind="documentsStatusFilter" @bind:after="SearchAsync">
                        <option value="">All statuses</option>
                        @foreach (var status in DocumentStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="reports-filter-actions">
                    <button type="button" class="workspace-filter-reset" @onclick="ResetFiltersAsync" disabled="@isLoading">Reset</button>
                </div>
            </section>

            <div class="reports-results @(IsRefreshing ? "reports-refreshing" : null)" aria-busy="@(isLoading ? "true" : "false")">
                @if (IsRefreshing)
                {
                    <span class="visually-hidden" role="status">Updating report...</span>
                }

                @if (isLoading && !IsRefreshing)
                {
                    <LoadingState Message="Loading report..." />
                }
                else if (failure is not null && !failure.IsValidation)
                {
                    <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
                }
                else if (documentsRows.Count == 0)
                {
                    <EmptyState Title="No records match your filters" Message="Widen the date range or clear a filter." />
                }
                else
                {
                    <div class="reports-table-scroll">
                        <table class="reports-table">
                            <caption class="visually-hidden">Documents expiring on or before the selected range</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Number</th>
                                    <th scope="col">Vessel</th>
                                    <th scope="col">Document type</th>
                                    <th scope="col">Issuing authority</th>
                                    <th scope="col">Issue date</th>
                                    <th scope="col">Expiry date</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="reports-num">Days left</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in documentsRows)
                                {
                                    <tr @key="row.DocumentId">
                                        <td><div class="reports-identity"><span class="bi bi-file-earmark-text" aria-hidden="true"></span><strong>@row.Number</strong></div></td>
                                        <td>@VesselDisplayName(row.VesselId)</td>
                                        <td class="reports-muted reports-wrap">@row.DocumentTypeName</td>
                                        <td class="reports-muted reports-wrap">@row.IssuingAuthority</td>
                                        <td class="reports-muted">@row.IssueDate.ToString("dd MMM yyyy")</td>
                                        <td>@row.ExpiryDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="reports-status @DocumentStatusClass(row)">@DocumentStatusLabel(row)</span>
                                        </td>
                                        <td class="reports-num">@DaysUntilExpiryLabel(row)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if ((!isLoading || IsRefreshing) && documentsRows.Count > 0)
                {
                    <div class="reports-pagination">
                        <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount records</span>
                        <div class="reports-pages">
                            <button type="button" @onclick="PreviousPageAsync" disabled="@(isLoading || pageNumber <= 1)">Previous</button>
                            <span class="reports-page-indicator">Page @pageNumber of @TotalPages</span>
                            <button type="button" @onclick="NextPageAsync" disabled="@(isLoading || pageNumber >= TotalPages)">Next</button>
                        </div>
                    </div>
                }
            </div>
        </section>

        @if (overview is { } chartSummary && totalCount > 0)
        {
            var busiestMonth = chartSummary.Months.Max(month => month.Count);

            <section class="reports-charts reports-charts-below reports-charts-full" aria-label="Documents expiry charts">
                <div class="reports-card reports-chart-card">
                    <div class="reports-chart-heading">
                        <div><span class="reports-section-label">Next 12 months</span><h2>Expiries over the next 12 months</h2></div>
                        <span class="reports-muted">Documents expiring each month</span>
                    </div>
                    <svg class="reports-area-chart" viewBox="0 0 1160 240" role="img" aria-label="Documents expiring per month over the next 12 months">
                        <line class="reports-chart-axis" x1="30" y1="205" x2="1160" y2="205"></line>
                        <path class="reports-chart-area" d="@ChartAreaPath(chartSummary.Months)"></path>
                        <path class="reports-chart-line" d="@ChartLinePath(chartSummary.Months)"></path>
                        @for (var index = 0; index < chartSummary.Months.Count; index++)
                        {
                            var month = chartSummary.Months[index];
                            var x = ChartX(index).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                            var y = ChartY(month.Count, busiestMonth);

                            <g>
                                <circle class="reports-chart-point" cx="@x" cy="@y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" r="4"></circle>
                                <text class="reports-chart-value" x="@x" y="@((y - 10).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="middle">@month.Count</text>
                                <text class="reports-chart-label" x="@x" y="228" text-anchor="middle">@month.Month.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture)</text>
                            </g>
                        }
                    </svg>
                </div>
            </section>
        }
    }
</section>
