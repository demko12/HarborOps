@page "/reports/maintenance-backlog"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessReports")]
@using HarborOps.Web.Api.Fleet
@using HarborOps.Web.Api.Reports
@implements IDisposable
@inject ReportsApiClient ReportsApi
@inject FleetApiClient FleetApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Maintenance backlog report | HarborOps</PageTitle>

<section class="reports-page">
    <header class="reports-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/reports">Reporting</a><span aria-hidden="true">/</span><span>Maintenance backlog</span></nav>
            <h1>Maintenance backlog</h1>
            <p>Review maintenance work orders and their overdue status.</p>
        </div>
    </header>

    <ReportsNavigation />

    @if (!AuthorizationState.CanAccessMaintenance)
    {
        <section class="reports-card">
            <EmptyState Title="Report not available" Message="Your account does not have permission to view the maintenance backlog report." />
        </section>
    }
    else
    {
        @if (filterValidationMessage is not null)
        {
            <div class="reports-validation" role="alert">
                <strong>Check the filters</strong>
                <ul>
                    <li>@filterValidationMessage</li>
                </ul>
            </div>
        }

        <div class="reports-kpis" aria-label="Report summary">
            <div class="reports-kpi"><div><span class="reports-kpi-label">Open work orders</span><strong>@(overview?.Open.ToString() ?? "—")</strong><span class="reports-kpi-note">Open and in progress</span></div><span class="reports-kpi-icon bi bi-tools" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Overdue</span><strong>@(overview?.Overdue.ToString() ?? "—")</strong><span class="reports-kpi-note">Past their due date</span></div><span class="reports-kpi-icon bi bi-alarm" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Critical priority</span><strong>@(overview?.Critical.ToString() ?? "—")</strong><span class="reports-kpi-note">@(overview is { } critical ? $"{critical.CriticalOverdue} of them overdue" : "Open and in progress")</span></div><span class="reports-kpi-icon bi bi-exclamation-octagon" aria-hidden="true"></span></div>
            <div class="reports-kpi"><div><span class="reports-kpi-label">Average overdue</span><strong>@(overview?.AverageOverdueDays is { } days ? $"{days} d" : "—")</strong><span class="reports-kpi-note">@(overview?.AverageIsSampled == true ? $"Across the {OverdueSampleSize} most overdue" : "Across overdue work orders")</span></div><span class="reports-kpi-icon bi bi-hourglass-split" aria-hidden="true"></span></div>
        </div>

        <section class="reports-card" aria-labelledby="reports-list-title">
            <div class="reports-card-heading">
                <div class="reports-register-heading">
                    <span class="reports-register-icon bi bi-bar-chart" aria-hidden="true"></span>
                    <div><span class="reports-section-label">Report results</span><h2 id="reports-list-title">Maintenance backlog register</h2><p>@totalCount records as of @reportAsOf.ToString("dd MMM yyyy")</p></div>
                </div>
                <a class="reports-download-button" href="@BuildDownloadUrl()">
                    <span class="bi bi-download" aria-hidden="true"></span> Download CSV
                </a>
            </div>

            <section class="reports-filters" aria-label="Report filters">
                <div class="filter-field">
                    <label for="reports-as-of">As of</label>
                    <input id="reports-as-of" type="date" @bind="asOfFilter" @bind:after="SearchAsync" />
                </div>
                <div class="filter-field filter-field-wide">
                    <label for="reports-vessel">Vessel</label>
                    <VesselPicker @key="vesselPickerResetToken" Value="vesselIdFilter" ValueChanged="OnVesselFilterChangedAsync" Placeholder="All vessels" />
                </div>
                <div class="filter-field">
                    <label for="reports-priority">Priority</label>
                    <select id="reports-priority" @bind="maintenancePriorityFilter" @bind:after="SearchAsync">
                        <option value="">All priorities</option>
                        @foreach (var priority in MaintenancePriorities)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="reports-status">Status</label>
                    <select id="reports-status" @bind="maintenanceStatusFilter" @bind:after="SearchAsync">
                        <option value="">All statuses</option>
                        @foreach (var status in MaintenanceStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="reports-overdue">Overdue</label>
                    <select id="reports-overdue" @bind="maintenanceOverdueSelection" @bind:after="SearchAsync">
                        <option value="">All</option>
                        <option value="true">Overdue only</option>
                        <option value="false">Not overdue</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="reports-due-from">Due from</label>
                    <input id="reports-due-from" type="date" @bind="maintenanceDueFromFilter" @bind:after="SearchAsync" />
                </div>
                <div class="filter-field">
                    <label for="reports-due-to">Due to</label>
                    <input id="reports-due-to" type="date" @bind="maintenanceDueToFilter" @bind:after="SearchAsync" />
                </div>

                <div class="reports-filter-actions">
                    <button type="button" class="workspace-filter-reset" @onclick="ResetFiltersAsync" disabled="@isLoading">Reset</button>
                </div>
            </section>

            <div class="reports-results @(IsRefreshing ? "reports-refreshing" : null)" aria-busy="@(isLoading ? "true" : "false")">
                @if (IsRefreshing)
                {
                    <span class="visually-hidden" role="status">Updating report...</span>
                }

                @if (isLoading && !IsRefreshing)
                {
                    <LoadingState Message="Loading report..." />
                }
                else if (failure is not null && !failure.IsValidation)
                {
                    <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
                }
                else if (maintenanceRows.Count == 0)
                {
                    <EmptyState Title="No records match your filters" Message="Widen the date range or clear a filter." />
                }
                else
                {
                    <div class="reports-table-scroll">
                        <table class="reports-table">
                            <caption class="visually-hidden">Maintenance work orders and their overdue status</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Title</th>
                                    <th scope="col">Vessel</th>
                                    <th scope="col">Priority</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Due date</th>
                                    <th scope="col">Overdue</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in maintenanceRows)
                                {
                                    <tr @key="row.WorkOrderId">
                                        <td class="reports-wrap"><div class="reports-identity"><span class="bi bi-tools" aria-hidden="true"></span><strong>@row.Title</strong></div></td>
                                        <td>@VesselDisplayName(row.VesselId)</td>
                                        <td><span class="reports-status @MaintenancePriorityClass(row.Priority)">@row.Priority</span></td>
                                        <td><span class="reports-status @MaintenanceStatusClass(row.Status)">@row.Status</span></td>
                                        <td>@row.DueUtc.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (row.IsOverdue)
                                            {
                                                <span class="reports-status is-expired">Overdue</span>
                                            }
                                            else
                                            {
                                                <span class="reports-status reports-status-valid">On track</span>
                                            }
                                        </td>
                                        <td class="reports-muted">@row.CreatedUtc.ToString("dd MMM yyyy")</td>
                                        <td class="reports-muted">@(row.CompletedUtc?.ToString("dd MMM yyyy") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if ((!isLoading || IsRefreshing) && maintenanceRows.Count > 0)
                {
                    <div class="reports-pagination">
                        <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount records</span>
                        <div class="reports-pages">
                            <button type="button" @onclick="PreviousPageAsync" disabled="@(isLoading || pageNumber <= 1)">Previous</button>
                            <span class="reports-page-indicator">Page @pageNumber of @TotalPages</span>
                            <button type="button" @onclick="NextPageAsync" disabled="@(isLoading || pageNumber >= TotalPages)">Next</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</section>
