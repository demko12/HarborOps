@page "/compliance/psc-inspections/{InspectionId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCompliance")]
@using HarborOps.Web.Api.Compliance
@using HarborOps.Web.Api.Fleet
@using HarborOps.Web.Api.Voyages
@inject ComplianceApiClient ComplianceApi
@inject FleetApiClient FleetApi
@inject VoyagesApiClient VoyagesApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>PSC inspection follow-up | HarborOps</PageTitle>

<section class="psc-detail-page">
    <header class="psc-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/compliance">Compliance operations</a><span aria-hidden="true">/</span><span>PSC follow-up</span></nav>
            <h1>PSC inspection #@InspectionId</h1>
            @if (inspection is not null)
            {
                <p class="psc-identity">
                    <span class="psc-port-chip"><span class="bi bi-geo-alt" aria-hidden="true"></span><strong>@(portName ?? "Unknown port")</strong></span>
                    <span>@(vesselName ?? "Unknown vessel")</span>
                    <span aria-hidden="true">·</span>
                    <span>@inspection.InspectingAuthority</span>
                    <span aria-hidden="true">·</span>
                    <span>@inspection.InspectionDate.ToString("dd MMM yyyy")</span>
                </p>
            }
            else
            {
                <p>Reconcile every reported deficiency and record detention decisions before vessel release.</p>
            }
        </div>
        @if (inspection is not null)
        {
            <span class="psc-state @DetentionStateClass(inspection.DetentionState)">@DetentionStateLabel(inspection.DetentionState)</span>
        }
    </header>

    @if (isLoading)
    {
        <LoadingState Message="Loading PSC inspection..." />
    }
    else if (failure is not null)
    {
        <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="LoadAsync" />
    }
    else if (inspection is not null)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var overdueCount = deficiencies.Count(item => IsOverdue(item, today));

        <section class="psc-card psc-steps" aria-label="Path to release">
            <ol>
                @foreach (var step in ReleaseSteps(inspection, overdueCount))
                {
                    <li class="psc-step @step.State" @key="step.Title">
                        <span class="psc-step-dot" aria-hidden="true">
                            @if (step.State == StepDone)
                            {
                                <span class="bi bi-check-lg"></span>
                            }
                            else
                            {
                                @step.Number
                            }
                        </span>
                        <span class="psc-step-text">
                            <strong>@step.Title</strong>
                            <small>@step.Note</small>
                        </span>
                    </li>
                }
            </ol>
        </section>

        <section class="psc-summary" aria-label="Inspection summary">
            <article class="psc-kpi">
                <p class="psc-kpi-label">Reported deficiencies</p>
                <p class="psc-kpi-value">@inspection.ReportedDeficiencyCount</p>
                <p class="psc-kpi-note">@(inspection.HasDeficiencyCountMismatch ? $"{inspection.RegisteredDeficiencyCount} registered · counts do not match" : $"All {inspection.RegisteredDeficiencyCount} registered")</p>
            </article>
            <article class="psc-kpi @(inspection.OpenDeficiencyCount > 0 ? "attention" : null)">
                <p class="psc-kpi-label">Open</p>
                <p class="psc-kpi-value">@inspection.OpenDeficiencyCount</p>
                <p class="psc-kpi-note">@(overdueCount == 0 ? "None past its deadline" : $"{overdueCount} past its deadline")</p>
            </article>
            <article class="psc-kpi psc-kpi-closed">
                <p class="psc-kpi-label">Closed</p>
                <p class="psc-kpi-value">@inspection.ClosedDeficiencyCount</p>
                @if (deficiencies.Count > 0)
                {
                    <div class="psc-kpi-progress" role="img" aria-label="@($"{inspection.ClosedDeficiencyCount} of {deficiencies.Count} closed")">
                        @foreach (var item in deficiencies.OrderBy(item => DeficiencyOrder(item, today)))
                        {
                            <span class="@DeficiencyStateClass(item, today)" @key="item.NonConformityId"></span>
                        }
                    </div>
                }
            </article>
            <article class="psc-kpi">
                <p class="psc-kpi-label">Detention</p>
                <p class="psc-kpi-value">@DetentionSummary(inspection, today)</p>
                <p class="psc-kpi-note">@DetentionNote(inspection)</p>
            </article>
        </section>

        @if (inspection.HasDeficiencyCountMismatch)
        {
            <p class="psc-blocking-message">Release is blocked: the reported and registered deficiency counts do not match.</p>
        }
        @if (inspection.OpenDeficiencyCount > 0)
        {
            <p class="psc-blocking-message">Release is blocked: @inspection.OpenDeficiencyCount linked finding(s) still require closure.</p>
        }

        <section class="psc-card">
            <div class="psc-section-heading"><div><span class="psc-kicker">Corrective actions</span><h2>Deficiencies</h2><p>Register each reported finding, then continue its corrective-action workflow.</p></div></div>
            @if (AuthorizationState.CanManageCompliance)
            {
                <form class="psc-form-grid psc-deficiency-form" @onsubmit="RegisterDeficiencyAsync" @onsubmit:preventDefault>
                    <label><span>Deficiency code</span><input @bind="deficiencyCode" @bind:event="oninput" placeholder="e.g. 10101" aria-label="PSC deficiency code" /></label>
                    <label><span>Description</span><input @bind="deficiencyDescription" @bind:event="oninput" placeholder="Describe the finding" aria-label="PSC deficiency description" /></label>
                    <label><span>Severity</span><select @bind="deficiencySeverity" aria-label="Severity"><option>Minor</option><option>Major</option><option>Critical</option></select></label>
                    <label><span>Corrective action due</span><input type="date" @bind="deficiencyDeadline" aria-label="Corrective action deadline" /></label>
                    <label><span>Evidence document <em>Optional</em></span><input @bind="deficiencyEvidenceId" placeholder="Document ID" aria-label="Evidence document ID" /></label>
                    <button class="psc-primary-button" type="submit" disabled="@(isSaving || string.IsNullOrWhiteSpace(deficiencyCode) || string.IsNullOrWhiteSpace(deficiencyDescription) || !deficiencyDeadline.HasValue)"><span class="bi bi-plus-lg" aria-hidden="true"></span>Add deficiency</button>
                </form>
            }
            @if (deficiencies.Count == 0) { <EmptyState Title="No deficiencies registered" Message="Register the reported PSC findings to reconcile this inspection." /> }
            else
            {
                var axis = DeadlineAxis(inspection.InspectionDate, deficiencies, today);
                <div class="psc-deadlines" aria-label="Corrective action deadlines">
                    <div class="psc-deadlines-ticks" aria-hidden="true">
                        @foreach (var tick in axis.Ticks)
                        {
                            <span style="left: @FormatPercent(tick.LeftPercent)">@tick.Label</span>
                        }
                    </div>
                    <div class="psc-deadlines-track" style="--psc-days: @axis.DayCount">
                        @foreach (var item in deficiencies)
                        {
                            <span class="psc-deadline-dot @DeficiencyStateClass(item, today)"
                                  style="left: @FormatPercent(axis.Percent(item.CorrectiveActionDeadline))"
                                  title="@($"{item.DeficiencyCode} · {item.CorrectiveActionDeadline:dd MMM yyyy} · {DeficiencyStateLabel(item, today)}")"
                                  @key="item.NonConformityId"></span>
                        }
                        @if (axis.TodayPercent is { } todayPercent)
                        {
                            <span class="psc-deadlines-today" style="left: @FormatPercent(todayPercent)" aria-hidden="true"><span>Today</span></span>
                        }
                    </div>
                </div>

                <div class="psc-deficiency-list">
                    @foreach (var item in deficiencies.OrderBy(item => DeficiencyOrder(item, today)).ThenBy(item => item.CorrectiveActionDeadline))
                    {
                        <a class="psc-deficiency-row @DeficiencyStateClass(item, today)" href="/compliance/non-conformities?selected=@item.NonConformityId" @key="item.NonConformityId">
                            <span class="psc-deficiency-icon bi @DeficiencyIcon(item, today)" aria-hidden="true"></span>
                            <div><span>Code</span><strong class="psc-code">@item.DeficiencyCode</strong></div>
                            <div><span>Description</span><strong>@item.Description</strong></div>
                            <div><span>Severity</span><span class="psc-severity @SeverityClass(item.Severity)">@item.Severity</span></div>
                            <div><span>Corrective action due</span><strong class="psc-due">@item.CorrectiveActionDeadline.ToString("dd MMM yyyy")<small>@DueLabel(item, today)</small></strong></div>
                            <div><span>Status</span><span class="psc-status @DeficiencyStateClass(item, today)">@DeficiencyStateLabel(item, today)</span></div>
                            <span class="psc-row-action">Open <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                        </a>
                    }
                </div>
            }
        </section>

        @if (AuthorizationState.CanManageCompliance)
        {
            <section class="psc-card">
                <div class="psc-section-heading"><div><span class="psc-kicker">Port state control</span><h2>Detention decision</h2><p>Decisions are permanent and attributed to the signed-in user.</p></div></div>
                @if (inspection.DetentionState == "NotDetained")
                {
                    <form class="psc-form-grid psc-decision-form" @onsubmit="DetainAsync" @onsubmit:preventDefault>
                        <label><span>Authority reference</span><input @bind="detainAuthorityReference" @bind:event="oninput" placeholder="Reference from authority" aria-label="Detention authority reference" /></label>
                        <label><span>Reason</span><input @bind="detainReason" @bind:event="oninput" placeholder="Reason for detention" aria-label="Detention reason" /></label>
                        <button class="psc-danger-button" type="submit" disabled="@(isSaving || string.IsNullOrWhiteSpace(detainAuthorityReference) || string.IsNullOrWhiteSpace(detainReason))">Confirm detention</button>
                    </form>
                }
                else if (inspection.DetentionState == "Detained")
                {
                    <form class="psc-form-grid psc-decision-form psc-release-form" @onsubmit="ReleaseAsync" @onsubmit:preventDefault>
                        <label><span>Authority reference</span><input @bind="releaseAuthorityReference" placeholder="Release authority reference" aria-label="Release authority reference" /></label>
                        <label><span>Release date</span><input type="date" @bind="releaseDate" aria-label="Release date" /></label>
                        <label><span>Release document <em>Optional</em></span><input @bind="releaseDocumentId" placeholder="Document ID" aria-label="Release document ID" /></label>
                        <button class="psc-primary-button" type="submit" disabled="@(isSaving || inspection.HasDeficiencyCountMismatch || inspection.OpenDeficiencyCount > 0)">Confirm release</button>
                    </form>
                }
                else { <p class="psc-blocking-message">This inspection was released. It cannot be detained again.</p> }
                @if (actionFailure is not null) { <ApiErrorState Title="@actionFailure.Title" Message="@actionFailure.Message" OnRetry="LoadAsync" /> }
            </section>
        }

        <section class="psc-card"><div class="psc-section-heading"><div><span class="psc-kicker">Audit trail</span><h2>Detention history</h2><p>Newest decision first.</p></div></div>
            @if (inspection.DetentionHistory.Count == 0) { <EmptyState Title="No detention decisions" Message="This inspection has not been detained or released." /> }
            else
            {
                <ol class="psc-history">
                    @foreach (var eventItem in inspection.DetentionHistory)
                    {
                        <li class="@(eventItem.Decision == "Released" ? "released" : "detained")" @key="eventItem.Id">
                            <span class="psc-history-dot bi @(eventItem.Decision == "Released" ? "bi-unlock" : "bi-lock")" aria-hidden="true"></span>
                            <div>
                                <strong>@eventItem.Decision</strong>
                                <span>@eventItem.AuthorityReference · @eventItem.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(eventItem.Reason)) { <span class="psc-history-reason">@eventItem.Reason</span> }
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    }
</section>

@code {
    [Parameter] public int InspectionId { get; set; }
    private GetPscInspectionDetailResponse? inspection;
    private IReadOnlyList<PscDeficiencyItem> deficiencies = [];
    private ComplianceApiFailure? failure;
    private ComplianceApiFailure? actionFailure;
    private bool isLoading = true;
    private bool isSaving;
    private string? portName;
    private string? vesselName;
    private string? deficiencyCode, deficiencyDescription, deficiencyEvidenceId, detainAuthorityReference, detainReason, releaseAuthorityReference, releaseDocumentId;
    private string deficiencySeverity = "Minor";
    private DateOnly? deficiencyDeadline, releaseDate;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; failure = null;
        try
        {
            var detail = await ComplianceApi.GetPscInspectionAsync(InspectionId, CancellationToken.None);
            var items = await ComplianceApi.GetPscDeficienciesAsync(InspectionId, CancellationToken.None);
            inspection = detail.Value; deficiencies = items.Value?.Items ?? [];
            failure = detail.Failure ?? items.Failure;
            if (inspection is not null)
            {
                var ports = await VoyagesApi.LookupPortNamesAsync([inspection.PortId], CancellationToken.None);
                var vessels = await FleetApi.LookupVesselNamesAsync([inspection.VesselId], CancellationToken.None);
                portName = ports.TryGetValue(inspection.PortId, out var port) ? port : null;
                vesselName = vessels.TryGetValue(inspection.VesselId, out var vessel) ? vessel : null;
            }
        }
        finally { isLoading = false; }
    }

    private async Task RegisterDeficiencyAsync()
    {
        if (isSaving) return; isSaving = true; actionFailure = null;
        try
        {
            Guid.TryParse(deficiencyEvidenceId, out var evidenceId);
            var result = await ComplianceApi.RegisterPscDeficiencyAsync(InspectionId, new(deficiencyCode, deficiencyDescription, deficiencySeverity, deficiencyDeadline, evidenceId), CancellationToken.None);
            if (!result.IsSuccess) { actionFailure = result.Failure; return; }
            deficiencyCode = deficiencyDescription = deficiencyEvidenceId = null; deficiencyDeadline = null;
            await LoadAsync();
        }
        finally { isSaving = false; }
    }

    private async Task DetainAsync()
    {
        if (isSaving) return; isSaving = true; actionFailure = null;
        try { var result = await ComplianceApi.DetainPscInspectionAsync(InspectionId, new(detainAuthorityReference, detainReason), CancellationToken.None); if (!result.IsSuccess) actionFailure = result.Failure; else await LoadAsync(); }
        finally { isSaving = false; }
    }

    private async Task ReleaseAsync()
    {
        if (isSaving) return; isSaving = true; actionFailure = null;
        try { Guid? documentId = Guid.TryParse(releaseDocumentId, out var parsed) ? parsed : null; var result = await ComplianceApi.ReleasePscInspectionAsync(InspectionId, new(releaseAuthorityReference, releaseDate, documentId), CancellationToken.None); if (!result.IsSuccess) actionFailure = result.Failure; else await LoadAsync(); }
        finally { isSaving = false; }
    }
}
