@page "/compliance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCompliance")]
@using HarborOps.Web.Api.Compliance
@implements IDisposable
@inject ComplianceApiClient ComplianceApi
@inject CurrentUserAuthorizationState AuthorizationState
@inject NavigationManager Navigation

<PageTitle>Compliance | HarborOps</PageTitle>

<section class="compliance-page">
    <header class="compliance-header">
        <div>
            <p class="compliance-eyebrow">Compliance operations</p>
            <h1>Compliance, under control</h1>
            <p>Review certificates, inspections, and open non-conformities for a vessel.</p>
        </div>
    </header>

    <ComplianceNavigation />

    <section class="compliance-selector" aria-label="Vessel selection">
        <div class="compliance-selector-heading"><span class="bi bi-shield-check" aria-hidden="true"></span><div><h2>Vessel workspace</h2><p>Select a vessel to review its certificates, coverage, and findings.</p></div></div>
        <div class="compliance-field compliance-vessel-field">
            <label>Vessel</label>
            <VesselPicker Value="selectedVesselId" ValueChanged="SelectVesselAsync" Disabled="isOverviewLoading" />
        </div>
    </section>

    @if (surveyLookupFailureMessage is not null)
    {
        <section class="compliance-card"><div class="compliance-error" role="alert">@surveyLookupFailureMessage</div></section>
    }

    @if (selectedVesselId is null)
    {
        <section class="compliance-card"><EmptyState Title="Select a vessel" Message="Search by vessel name or IMO number to view its compliance overview." /></section>
    }
    else if (isOverviewLoading)
    {
        <section class="compliance-card"><LoadingState Message="Loading vessel compliance overview..." /></section>
    }
    else if (overviewFailure is not null)
    {
        <section class="compliance-card"><ApiErrorState Title="@overviewFailure.Title" Message="@overviewFailure.Message" OnRetry="RetryOverviewAsync" /></section>
    }
    else if (overview is not null)
    {
        <section class="compliance-summary" aria-label="Selected vessel compliance summary">
            <article><div><span>Valid certificates</span><strong>@overview.Certificates.Count(IsCurrent)</strong><small>@overview.Certificates.Count(IsUncoveredExpired) expired · @overview.Certificates.Count(IsRevoked) revoked</small></div><span class="bi bi-patch-check" aria-hidden="true"></span></article>
            <article><div><span>Insurance policies</span><strong>@overview.InsurancePolicies.Count</strong><small>Recorded for this vessel</small></div><span class="bi bi-shield-plus" aria-hidden="true"></span></article>
            <article><div><span>PSC inspections</span><strong>@overview.PscInspections.Count</strong><small>Recorded for this vessel</small></div><span class="bi bi-clipboard-check" aria-hidden="true"></span></article>
            <article><div><span>Open findings</span><strong>@overview.OpenNonConformities.Count</strong><small>Non-conformities to resolve</small></div><span class="bi bi-exclamation-diamond" aria-hidden="true"></span></article>
        </section>
        <div class="compliance-actions">
            @if (AuthorizationState.CanManageCompliance)
            {
                <button type="button" @onclick="OpenCertificateForm"><span class="bi bi-patch-check"></span> Register certificate</button>
                <button type="button" @onclick="OpenPscForm"><span class="bi bi-clipboard2-check"></span> Register PSC inspection</button>
            }
            @if (AuthorizationState.CanManageCompliance)
            {
                <button type="button" @onclick="OpenNonConformityForm"><span class="bi bi-exclamation-diamond"></span> Register non-conformity</button>
            }
            @if (AuthorizationState.CanManageCompliance)
            {
                <button type="button" @onclick="OpenInsurancePolicyForm"><span class="bi bi-shield-plus"></span> Register insurance policy</button>
            }
        </div>
        @if (operationSuccess is not null)
        {
            <div class="compliance-success" role="status">@operationSuccess</div>
        }

        @if (isCertificateFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="CloseCertificateForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="certificate-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="certificate-form-title">Register certificate</h2><p>Add a certificate for the selected vessel.</p></div></div>
                @if (certificateSuccess is not null) { <div class="compliance-success" role="status">@certificateSuccess</div> }
                @if (certificateError is not null) { <div class="compliance-error" role="alert">@certificateError</div> }
                <EditForm EditContext="certificateEditContext" OnSubmit="SubmitCertificateAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field"><label for="certificate-type">Certificate type</label><InputText id="certificate-type" @bind-Value="certificateModel.CertificateType" /><ValidationMessage For="() => certificateModel.CertificateType" /></div>
                        <div class="compliance-field"><label for="certificate-number">Certificate number</label><InputText id="certificate-number" @bind-Value="certificateModel.CertificateNumber" /><ValidationMessage For="() => certificateModel.CertificateNumber" /></div>
                        <div class="compliance-field"><label for="certificate-authority">Issuing authority</label><InputText id="certificate-authority" @bind-Value="certificateModel.IssuingAuthority" /><ValidationMessage For="() => certificateModel.IssuingAuthority" /></div>
                        <div class="compliance-field"><label for="certificate-issued">Issued on</label><InputDate id="certificate-issued" @bind-Value="certificateModel.IssuedOn" /><ValidationMessage For="() => certificateModel.IssuedOn" /></div>
                        <div class="compliance-field"><label for="certificate-expires">Expires on</label><InputDate id="certificate-expires" @bind-Value="certificateModel.ExpiresOn" /><ValidationMessage For="() => certificateModel.ExpiresOn" /></div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingCertificate">@(isSubmittingCertificate ? "Registering..." : "Register certificate")</button><button class="compliance-cancel" type="button" @onclick="CloseCertificateForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        @if (isPscFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="ClosePscForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="psc-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="psc-form-title">Register PSC inspection</h2><p>Record the port state control inspection for the selected vessel.</p></div></div>
                @if (pscSuccess is not null) { <div class="compliance-success" role="status">@pscSuccess</div> }
                @if (pscError is not null) { <div class="compliance-error" role="alert">@pscError</div> }
                <EditForm EditContext="pscEditContext" OnSubmit="SubmitPscAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field"><label for="psc-port">Port ID</label><InputText id="psc-port" @bind-Value="pscModel.PortIdText" /><ValidationMessage For="() => pscModel.PortIdText" /></div>
                        <div class="compliance-field"><label for="psc-date">Inspection date</label><InputDate id="psc-date" @bind-Value="pscModel.InspectionDate" /><ValidationMessage For="() => pscModel.InspectionDate" /></div>
                        <div class="compliance-field"><label for="psc-authority">Inspecting authority</label><InputText id="psc-authority" @bind-Value="pscModel.InspectingAuthority" /><ValidationMessage For="() => pscModel.InspectingAuthority" /></div>
                        <div class="compliance-field"><label for="psc-deficiencies">Deficiency count</label><InputNumber id="psc-deficiencies" @bind-Value="pscModel.DeficiencyCount" /><ValidationMessage For="() => pscModel.DeficiencyCount" /></div>
                        <div class="compliance-field"><label><InputCheckbox @bind-Value="pscModel.VesselDetained" /> Vessel detained</label></div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingPsc">@(isSubmittingPsc ? "Registering..." : "Register PSC inspection")</button><button class="compliance-cancel" type="button" @onclick="ClosePscForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        @if (isNonConformityFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="CloseNonConformityForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="non-conformity-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="non-conformity-form-title">Register non-conformity</h2><p>Record an open compliance issue for the selected vessel.</p></div></div>
                @if (nonConformitySuccess is not null) { <div class="compliance-success" role="status">@nonConformitySuccess</div> }
                @if (nonConformityError is not null) { <div class="compliance-error" role="alert">@nonConformityError</div> }
                <EditForm EditContext="nonConformityEditContext" OnSubmit="SubmitNonConformityAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field">
                            <label>Source</label>
                            <InputRadioGroup @bind-Value="nonConformityModel.SourceType" Name="nc-source">
                                <label class="compliance-radio"><InputRadio Value="@("Survey")" /> Survey</label>
                                <label class="compliance-radio"><InputRadio Value="@("Psc")" /> PSC inspection</label>
                            </InputRadioGroup>
                        </div>
                        @if (nonConformityModel.SourceType == "Survey")
                        {
                            <div class="compliance-field">
                                <label for="nc-survey">Survey audit</label>
                                <select id="nc-survey" class="compliance-select" @bind="nonConformityModel.SurveyId">
                                    <option value="">-- Select a survey audit --</option>
                                    @foreach (var survey in overview.SurveyAudits)
                                    {
                                        <option value="@survey.Id">@survey.Date.ToString("dd MMM yyyy") &mdash; @survey.Type (@survey.Result)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="compliance-field">
                                <label for="nc-psc">PSC inspection</label>
                                <select id="nc-psc" class="compliance-select" @bind="nonConformityModel.PscId">
                                    <option value="">-- Select a PSC inspection --</option>
                                    @foreach (var psc in overview.PscInspections)
                                    {
                                        <option value="@psc.Id">@psc.InspectionDate.ToString("dd MMM yyyy") &mdash; @psc.InspectingAuthority</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="compliance-field">
                            <label>Evidence document</label>
                            <DocumentPicker @key="nonConformityResetToken" VesselId="selectedVesselId" Value="nonConformityModel.EvidenceDocumentId" ValueChanged="@((Guid? id) => nonConformityModel.EvidenceDocumentId = id)" />
                            <ValidationMessage For="() => nonConformityModel.EvidenceDocumentId" />
                        </div>
                        <div class="compliance-field">
                            <label for="nc-severity">Severity</label>
                            <select id="nc-severity" class="compliance-select" @bind="nonConformityModel.Severity">
                                <option value="">-- Select severity --</option>
                                <option value="Minor">Minor</option>
                                <option value="Major">Major</option>
                                <option value="Critical">Critical</option>
                            </select>
                            <ValidationMessage For="() => nonConformityModel.Severity" />
                        </div>
                        <div class="compliance-field">
                            <label for="nc-deadline">Corrective action deadline</label>
                            <InputDate id="nc-deadline" @bind-Value="nonConformityModel.CorrectiveActionDeadline" />
                            <ValidationMessage For="() => nonConformityModel.CorrectiveActionDeadline" />
                        </div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingNonConformity">@(isSubmittingNonConformity ? "Registering..." : "Register non-conformity")</button><button class="compliance-cancel" type="button" @onclick="CloseNonConformityForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        @if (isInsurancePolicyFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="CloseInsurancePolicyForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="insurance-policy-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="insurance-policy-form-title">Register insurance policy</h2><p>Expiry dates must be today or later.</p></div></div>
                @if (insurancePolicyError is not null) { <div class="compliance-error" role="alert">@insurancePolicyError</div> }
                <EditForm EditContext="insurancePolicyEditContext" OnSubmit="SubmitInsurancePolicyAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field"><label for="insurance-insurer">Insurer</label><InputText id="insurance-insurer" @bind-Value="insurancePolicyModel.Insurer" /><ValidationMessage For="() => insurancePolicyModel.Insurer" /></div>
                        <div class="compliance-field"><label for="insurance-policy-number">Policy number</label><InputText id="insurance-policy-number" @bind-Value="insurancePolicyModel.PolicyNumber" /><ValidationMessage For="() => insurancePolicyModel.PolicyNumber" /></div>
                        <div class="compliance-field"><label for="insurance-coverage">Coverage</label><InputText id="insurance-coverage" @bind-Value="insurancePolicyModel.Coverage" /><ValidationMessage For="() => insurancePolicyModel.Coverage" /></div>
                        <div class="compliance-field"><label for="insurance-expiry">Expiry date</label><InputDate id="insurance-expiry" @bind-Value="insurancePolicyModel.ExpiryDate" /><ValidationMessage For="() => insurancePolicyModel.ExpiryDate" /></div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingInsurancePolicy">@(isSubmittingInsurancePolicy ? "Registering..." : "Register insurance policy")</button><button class="compliance-cancel" type="button" @onclick="CloseInsurancePolicyForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        <section class="compliance-card compliance-section certificate-register" aria-labelledby="certificate-register-title">
            <div class="certificate-register-heading">
                <div class="certificate-register-title">
                    <span class="compliance-section-icon bi bi-patch-check" aria-hidden="true"></span>
                    <div>
                        <h2 id="certificate-register-title">Certificates</h2>
                        <p>@overview.Certificates.Count @(overview.Certificates.Count == 1 ? "certificate" : "certificates") · Expiry order</p>
                    </div>
                </div>
                <div class="certificate-view-switch" role="group" aria-label="Certificate display">
                    <button type="button" aria-label="List view" aria-pressed="@((!certificateCardView).ToString().ToLowerInvariant())" class="@(!certificateCardView ? "selected" : "")" @onclick="() => certificateCardView = false"><span class="bi bi-list-ul" aria-hidden="true"></span> List</button>
                    <button type="button" aria-label="Card view" aria-pressed="@certificateCardView.ToString().ToLowerInvariant()" class="@(certificateCardView ? "selected" : "")" @onclick="() => certificateCardView = true"><span class="bi bi-grid" aria-hidden="true"></span> Cards</button>
                </div>
            </div>
            @if (overview.Certificates.Count == 0)
            {
                <EmptyState Title="No certificates recorded" Message="Records will appear here when they are added for this vessel." />
            }
            else if (certificateCardView)
            {
                <div class="certificate-tile-grid">
                    @foreach (var item in overview.Certificates)
                    {
                        <a @key="item.Id" class="certificate-tile @(IsAtRisk(item) ? "is-at-risk" : null)" href="@CertificateHref(item.Id)">
                            <div class="certificate-tile-head">
                                <span class="certificate-type-icon bi bi-patch-check" aria-hidden="true"></span>
                                <div class="certificate-tile-identity">
                                    <strong>@item.CertificateNumber</strong>
                                    <span>@item.CertificateType</span>
                                </div>
                                <span class="compliance-badge @CertificateStatusClass(item.Status, item.IsRenewalCovered)">@CertificateStatusLabel(item.Status, item.IsRenewalCovered)</span>
                            </div>
                            <div class="certificate-tile-validity">
                                <div><small>Issued</small><span>@item.IssuedOn.ToString("dd MMM yyyy")</span></div>
                                <i aria-hidden="true"></i>
                                <div><small>Expires</small><span>@item.ExpiresOn.ToString("dd MMM yyyy")</span></div>
                            </div>
                            <div class="certificate-tile-issuer"><small>Issued by</small><span>@item.IssuingAuthority</span></div>
                            @if (item.SuccessorCertificateId is not null)
                            {
                                <div class="certificate-renewal">@RenewalSummary(item)</div>
                            }
                            <span class="certificate-tile-open">Open certificate <span class="bi bi-chevron-right" aria-hidden="true"></span></span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="certificate-table-scroll">
                    <table class="certificate-table">
                        <thead>
                            <tr>
                                <th scope="col">Certificate</th>
                                <th scope="col">Issued by</th>
                                <th scope="col">Issued</th>
                                <th scope="col">Expires</th>
                                <th scope="col">Status</th>
                                <th scope="col">Renewal</th>
                                <th scope="col" class="col-chevron"><span class="visually-hidden">Open certificate</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in overview.Certificates)
                            {
                                <tr @key="item.Id"
                                    class="certificate-row @(IsAtRisk(item) ? "is-at-risk" : null)"
                                    role="link"
                                    tabindex="0"
                                    aria-label="@($"Open certificate {item.CertificateNumber}")"
                                    @onclick="() => OpenCertificate(item.Id)"
                                    @onkeydown="(args) => HandleCertificateRowKeyDown(args, item.Id)">
                                    <td><div class="certificate-identity">
                                        <span class="certificate-type-icon bi bi-patch-check" aria-hidden="true"></span>
                                        <span><a href="@CertificateHref(item.Id)" @onclick:stopPropagation="true">@item.CertificateNumber</a><small>@item.CertificateType</small></span>
                                    </div></td>
                                    <td>@item.IssuingAuthority</td>
                                    <td class="certificate-date">@item.IssuedOn.ToString("dd MMM yyyy")</td>
                                    <td class="certificate-date">@item.ExpiresOn.ToString("dd MMM yyyy")</td>
                                    <td><span class="compliance-badge @CertificateStatusClass(item.Status, item.IsRenewalCovered)">@CertificateStatusLabel(item.Status, item.IsRenewalCovered)</span></td>
                                    <td><div class="certificate-renewal">
                                        @if (item.SuccessorCertificateId is null)
                                        {
                                            <span class="certificate-renewal-none">Not renewed</span>
                                        }
                                        else
                                        {
                                            @RenewalSummary(item)
                                        }
                                    </div></td>
                                    <td class="col-chevron"><span class="bi bi-chevron-right" aria-hidden="true"></span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <ComplianceSection Icon="bi-shield-plus" Title="Insurance policies" EmptyTitle="No insurance policies recorded" IsEmpty="@(overview.InsurancePolicies.Count == 0)">
            @foreach (var item in overview.InsurancePolicies)
            {
                <article class="compliance-record certificate-card @(item.ExpiryClassification == "Expired" ? "is-expired" : null)">
                    <div class="record-identity"><span class="record-kicker">@item.Coverage</span><strong>@item.Insurer</strong><span class="record-reference">@item.PolicyNumber</span></div>
                    <div class="record-detail"><span class="record-label">Coverage</span><span>@item.Coverage</span></div>
                    <div class="record-status-block"><span class="compliance-badge @(item.ExpiryClassification == "Expired" ? "danger" : item.ExpiryClassification == "Expiring soon" ? "neutral" : "success")">@item.ExpiryClassification</span><span class="record-label">Expires</span><strong>@item.ExpiryDate.ToString("dd MMM yyyy")</strong></div>
                </article>
            }
        </ComplianceSection>
        <ComplianceSection Icon="bi-clipboard-check" Title="PSC inspections" EmptyTitle="No PSC inspections recorded" IsEmpty="@(overview.PscInspections.Count == 0)">
            @foreach (var item in overview.PscInspections)
            {
                <a class="compliance-record inspection-card @(item.VesselDetained ? "is-detained" : null)" href="/compliance/psc-inspections/@item.Id">
                    <div class="record-identity">
                        <span class="record-kicker">Inspection</span>
                        <strong>@item.InspectionDate.ToString("dd MMM yyyy")</strong>
                        <span class="record-reference">@item.InspectingAuthority</span>
                    </div>
                    <div class="inspection-metric">
                        <strong>@item.DeficiencyCount</strong>
                        <span>@(item.DeficiencyCount == 1 ? "Deficiency" : "Deficiencies")</span>
                    </div>
                    <div class="record-status-block">
                        <span class="compliance-badge @(item.VesselDetained ? "danger" : "success")">@(item.VesselDetained ? "Detained" : "Clear")</span>
                    </div>
                    <span class="inspection-open-action">Open PSC follow-up <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                    <div class="record-metadata"><span>Port ID</span><code>@item.PortId</code></div>
                </a>
            }
        </ComplianceSection>
        <ComplianceSection Icon="bi-exclamation-diamond" Title="Open non-conformities" EmptyTitle="No open non-conformities" IsEmpty="@(overview.OpenNonConformities.Count == 0)">
            @foreach (var item in overview.OpenNonConformities)
            {
                <article class="compliance-record issue-card @(IsCritical(item) ? "is-critical" : null)">
                    <div class="record-identity">
                        <span class="record-kicker">Outstanding issue</span>
                        <strong>@item.Severity severity</strong>
                        <span class="compliance-badge @(IsCritical(item) ? "danger" : "neutral")">@item.Severity</span>
                    </div>
                    <div class="deadline-block">
                        <span class="record-label">Corrective action due</span>
                        <strong>@item.CorrectiveActionDeadline.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="record-metadata"><span>Evidence document ID</span><code>@item.EvidenceDocumentId</code></div>
                </article>
            }
        </ComplianceSection>
    }
</section>

@code {
    private RenderFragment RenewalSummary(ComplianceCertificateItem item) => __builder =>
    {
        <span>@(item.SuccessorIsRevoked ? "Renewal revoked" : "Renewed by")</span>
        <code>@item.SuccessorCertificateNumber</code>
        <span>effective @item.SuccessorIssuedOn?.ToString("dd MMM yyyy")</span>
        @if (item.RenewalGapDays is > 0)
        {
            <span class="compliance-badge danger">Coverage gap: @item.RenewalGapDays @(item.RenewalGapDays == 1 ? "day" : "days")</span>
        }
    };
}
