@page "/compliance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCompliance")]
@using HarborOps.Web.Api.Compliance
@implements IDisposable
@inject ComplianceApiClient ComplianceApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Compliance | HarborOps</PageTitle>

<section class="compliance-page">
    <header class="compliance-header">
        <div>
            <p class="compliance-eyebrow">Compliance operations</p>
            <h1>Vessel compliance</h1>
            <p>Review certificates, inspections, and open non-conformities for a vessel.</p>
        </div>
        <a class="compliance-header-action" href="/compliance/surveys"><span class="bi bi-clipboard2-check"></span> Surveys and audits</a>
    </header>

    <section class="compliance-selector" aria-label="Vessel selection">
        <div class="compliance-field compliance-vessel-field">
            <label>Vessel</label>
            <VesselPicker Value="selectedVesselId" ValueChanged="SelectVesselAsync" Disabled="isOverviewLoading" />
        </div>
    </section>

    @if (selectedVesselId is null)
    {
        <section class="compliance-card"><EmptyState Title="Select a vessel" Message="Search by vessel name or IMO number to view its compliance overview." /></section>
    }
    else if (isOverviewLoading)
    {
        <section class="compliance-card"><LoadingState Message="Loading vessel compliance overview..." /></section>
    }
    else if (overviewFailure is not null)
    {
        <section class="compliance-card"><ApiErrorState Title="@overviewFailure.Title" Message="@overviewFailure.Message" OnRetry="RetryOverviewAsync" /></section>
    }
    else if (overview is not null)
    {
        <div class="compliance-actions">
            <button type="button" @onclick="OpenCertificateForm"><span class="bi bi-patch-check"></span> Register certificate</button>
            <button type="button" @onclick="OpenPscForm"><span class="bi bi-clipboard2-check"></span> Register PSC inspection</button>
            @if (AuthorizationState.CanManageCompliance)
            {
                <button type="button" @onclick="OpenNonConformityForm"><span class="bi bi-exclamation-diamond"></span> Register non-conformity</button>
            }
        </div>

        @if (isCertificateFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="CloseCertificateForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="certificate-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="certificate-form-title">Register certificate</h2><p>Add a certificate for the selected vessel.</p></div><button class="compliance-modal-close" type="button" @onclick="CloseCertificateForm"><span class="bi bi-x-lg"></span> Close</button></div>
                @if (certificateSuccess is not null) { <div class="compliance-success" role="status">@certificateSuccess</div> }
                @if (certificateError is not null) { <div class="compliance-error" role="alert">@certificateError</div> }
                <EditForm EditContext="certificateEditContext" OnSubmit="SubmitCertificateAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field"><label for="certificate-type">Certificate type</label><InputText id="certificate-type" @bind-Value="certificateModel.CertificateType" /><ValidationMessage For="() => certificateModel.CertificateType" /></div>
                        <div class="compliance-field"><label for="certificate-number">Certificate number</label><InputText id="certificate-number" @bind-Value="certificateModel.CertificateNumber" /><ValidationMessage For="() => certificateModel.CertificateNumber" /></div>
                        <div class="compliance-field"><label for="certificate-authority">Issuing authority</label><InputText id="certificate-authority" @bind-Value="certificateModel.IssuingAuthority" /><ValidationMessage For="() => certificateModel.IssuingAuthority" /></div>
                        <div class="compliance-field"><label for="certificate-issued">Issued on</label><InputDate id="certificate-issued" @bind-Value="certificateModel.IssuedOn" /><ValidationMessage For="() => certificateModel.IssuedOn" /></div>
                        <div class="compliance-field"><label for="certificate-expires">Expires on</label><InputDate id="certificate-expires" @bind-Value="certificateModel.ExpiresOn" /><ValidationMessage For="() => certificateModel.ExpiresOn" /></div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingCertificate">@(isSubmittingCertificate ? "Registering..." : "Register certificate")</button><button class="compliance-cancel" type="button" @onclick="CloseCertificateForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        @if (isPscFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="ClosePscForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="psc-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="psc-form-title">Register PSC inspection</h2><p>Record the port state control inspection for the selected vessel.</p></div><button class="compliance-modal-close" type="button" @onclick="ClosePscForm"><span class="bi bi-x-lg"></span> Close</button></div>
                @if (pscSuccess is not null) { <div class="compliance-success" role="status">@pscSuccess</div> }
                @if (pscError is not null) { <div class="compliance-error" role="alert">@pscError</div> }
                <EditForm EditContext="pscEditContext" OnSubmit="SubmitPscAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field"><label for="psc-port">Port ID</label><InputText id="psc-port" @bind-Value="pscModel.PortIdText" /><ValidationMessage For="() => pscModel.PortIdText" /></div>
                        <div class="compliance-field"><label for="psc-date">Inspection date</label><InputDate id="psc-date" @bind-Value="pscModel.InspectionDate" /><ValidationMessage For="() => pscModel.InspectionDate" /></div>
                        <div class="compliance-field"><label for="psc-authority">Inspecting authority</label><InputText id="psc-authority" @bind-Value="pscModel.InspectingAuthority" /><ValidationMessage For="() => pscModel.InspectingAuthority" /></div>
                        <div class="compliance-field"><label for="psc-deficiencies">Deficiency count</label><InputNumber id="psc-deficiencies" @bind-Value="pscModel.DeficiencyCount" /><ValidationMessage For="() => pscModel.DeficiencyCount" /></div>
                        <div class="compliance-field"><label><InputCheckbox @bind-Value="pscModel.VesselDetained" /> Vessel detained</label></div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingPsc">@(isSubmittingPsc ? "Registering..." : "Register PSC inspection")</button><button class="compliance-cancel" type="button" @onclick="ClosePscForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        @if (isNonConformityFormOpen)
        {
            <div class="compliance-modal-backdrop" role="presentation" @onclick="CloseNonConformityForm">
            <section class="compliance-card compliance-form-card compliance-registration-modal" role="dialog" aria-modal="true" aria-labelledby="non-conformity-form-title" @onclick:stopPropagation="true">
                <div class="compliance-modal-heading"><div><h2 id="non-conformity-form-title">Register non-conformity</h2><p>Record an open compliance issue for the selected vessel.</p></div><button class="compliance-modal-close" type="button" @onclick="CloseNonConformityForm"><span class="bi bi-x-lg"></span> Close</button></div>
                @if (nonConformitySuccess is not null) { <div class="compliance-success" role="status">@nonConformitySuccess</div> }
                @if (nonConformityError is not null) { <div class="compliance-error" role="alert">@nonConformityError</div> }
                <EditForm EditContext="nonConformityEditContext" OnSubmit="SubmitNonConformityAsync">
                    <DataAnnotationsValidator />
                    <div class="compliance-form-grid">
                        <div class="compliance-field">
                            <label>Source</label>
                            <InputRadioGroup @bind-Value="nonConformityModel.SourceType" Name="nc-source">
                                <label class="compliance-radio"><InputRadio Value="@("Survey")" /> Survey</label>
                                <label class="compliance-radio"><InputRadio Value="@("Psc")" /> PSC inspection</label>
                            </InputRadioGroup>
                        </div>
                        @if (nonConformityModel.SourceType == "Survey")
                        {
                            <div class="compliance-field">
                                <label for="nc-survey">Survey audit</label>
                                <select id="nc-survey" class="compliance-select" @bind="nonConformityModel.SurveyId">
                                    <option value="">-- Select a survey audit --</option>
                                    @foreach (var survey in overview.SurveyAudits)
                                    {
                                        <option value="@survey.Id">@survey.Date.ToString("dd MMM yyyy") &mdash; @survey.Type (@survey.Result)</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="compliance-field">
                                <label for="nc-psc">PSC inspection</label>
                                <select id="nc-psc" class="compliance-select" @bind="nonConformityModel.PscId">
                                    <option value="">-- Select a PSC inspection --</option>
                                    @foreach (var psc in overview.PscInspections)
                                    {
                                        <option value="@psc.Id">@psc.InspectionDate.ToString("dd MMM yyyy") &mdash; @psc.InspectingAuthority</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="compliance-field">
                            <label>Evidence document</label>
                            <DocumentPicker @key="nonConformityResetToken" VesselId="selectedVesselId" Value="nonConformityModel.EvidenceDocumentId" ValueChanged="@((Guid? id) => nonConformityModel.EvidenceDocumentId = id)" />
                            <ValidationMessage For="() => nonConformityModel.EvidenceDocumentId" />
                        </div>
                        <div class="compliance-field">
                            <label for="nc-severity">Severity</label>
                            <select id="nc-severity" class="compliance-select" @bind="nonConformityModel.Severity">
                                <option value="">-- Select severity --</option>
                                <option value="Minor">Minor</option>
                                <option value="Major">Major</option>
                                <option value="Critical">Critical</option>
                            </select>
                            <ValidationMessage For="() => nonConformityModel.Severity" />
                        </div>
                        <div class="compliance-field">
                            <label for="nc-deadline">Corrective action deadline</label>
                            <InputDate id="nc-deadline" @bind-Value="nonConformityModel.CorrectiveActionDeadline" />
                            <ValidationMessage For="() => nonConformityModel.CorrectiveActionDeadline" />
                        </div>
                    </div>
                    <div class="compliance-modal-actions"><button class="compliance-submit" type="submit" disabled="@isSubmittingNonConformity">@(isSubmittingNonConformity ? "Registering..." : "Register non-conformity")</button><button class="compliance-cancel" type="button" @onclick="CloseNonConformityForm">Cancel</button></div>
                </EditForm>
            </section>
            </div>
        }

        <ComplianceSection Title="Certificates" EmptyTitle="No certificates recorded" IsEmpty="@(overview.Certificates.Count == 0)">
            @foreach (var item in overview.Certificates)
            {
                <article class="compliance-record certificate-card @(IsExpired(item) ? "is-expired" : null)">
                    <div class="record-identity">
                        <span class="record-kicker">Certificate</span>
                        <strong>@item.CertificateType</strong>
                        <span class="record-reference">@item.CertificateNumber</span>
                    </div>
                    <div class="record-detail">
                        <span class="record-label">Issued by</span>
                        <span>@item.IssuingAuthority</span>
                        <small>Issued @item.IssuedOn.ToString("dd MMM yyyy")</small>
                    </div>
                    <div class="record-status-block">
                        <span class="compliance-badge @(IsExpired(item) ? "danger" : "success")">@(IsExpired(item) ? "Expired" : "Valid")</span>
                        <span class="record-label">Expires</span>
                        <strong>@item.ExpiresOn.ToString("dd MMM yyyy")</strong>
                    </div>
                </article>
            }
        </ComplianceSection>
        <ComplianceSection Title="PSC inspections" EmptyTitle="No PSC inspections recorded" IsEmpty="@(overview.PscInspections.Count == 0)">
            @foreach (var item in overview.PscInspections)
            {
                <article class="compliance-record inspection-card @(item.VesselDetained ? "is-detained" : null)">
                    <div class="record-identity">
                        <span class="record-kicker">Inspection</span>
                        <strong>@item.InspectionDate.ToString("dd MMM yyyy")</strong>
                        <span class="record-reference">@item.InspectingAuthority</span>
                    </div>
                    <div class="inspection-metric">
                        <strong>@item.DeficiencyCount</strong>
                        <span>@(item.DeficiencyCount == 1 ? "Deficiency" : "Deficiencies")</span>
                    </div>
                    <div class="record-status-block">
                        <span class="compliance-badge @(item.VesselDetained ? "danger" : "success")">@(item.VesselDetained ? "Detained" : "Clear")</span>
                    </div>
                    <div class="record-metadata"><span>Port ID</span><code>@item.PortId</code></div>
                </article>
            }
        </ComplianceSection>
        <ComplianceSection Title="Open non-conformities" EmptyTitle="No open non-conformities" IsEmpty="@(overview.OpenNonConformities.Count == 0)">
            @foreach (var item in overview.OpenNonConformities)
            {
                <article class="compliance-record issue-card @(IsCritical(item) ? "is-critical" : null)">
                    <div class="record-identity">
                        <span class="record-kicker">Outstanding issue</span>
                        <strong>@item.Severity severity</strong>
                        <span class="compliance-badge @(IsCritical(item) ? "danger" : "neutral")">@item.Severity</span>
                    </div>
                    <div class="deadline-block">
                        <span class="record-label">Corrective action due</span>
                        <strong>@item.CorrectiveActionDeadline.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="record-metadata"><span>Evidence document ID</span><code>@item.EvidenceDocumentId</code></div>
                </article>
            }
        </ComplianceSection>
    }
</section>
