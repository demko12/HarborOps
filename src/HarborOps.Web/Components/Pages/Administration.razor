@page "/administration"
@implements IDisposable
@inject IdentityAdministrationApiClient AdministrationApi
@inject CurrentUserAuthorizationState AuthorizationState

<PageTitle>Administration | HarborOps</PageTitle>

@if (!AuthorizationState.CanManageAdministration)
{
    <section class="administration-page administration-denied" aria-labelledby="administration-denied-title">
        <div class="administration-denied-card" role="alert">
            <span class="bi bi-shield-lock-fill" aria-hidden="true"></span>
            <p class="administration-eyebrow">Restricted area</p>
            <h1 id="administration-denied-title">Administrator access required</h1>
            <p>This area is available only to administrators with user and role management permissions.</p>
        </div>
    </section>
}
else
{
<section class="administration-page">
    <header class="administration-header">
        <div>
            <p class="administration-eyebrow">Access control</p>
            <h1>Administration</h1>
            <p>Manage HarborOps accounts, roles, and capability permissions.</p>
        </div>
    </header>

    @if (forbidden)
    {
        <div class="administration-forbidden" role="alert">
            <span class="bi bi-shield-lock"></span>
            <div><strong>Access denied</strong><p>Your current access does not permit this administration operation.</p></div>
        </div>
    }

    <div class="administration-grid">
        <section class="administration-card administration-users" aria-labelledby="users-title">
            <div class="card-heading">
                <div><h2 id="users-title">Users</h2><p>Assign roles to existing accounts.</p></div>
                <span class="bi bi-people" aria-hidden="true"></span>
            </div>
            <form class="administration-search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <div class="input-shell">
                    <span class="bi bi-search" aria-hidden="true"></span>
                    <input @bind="search" placeholder="Search by email address" aria-label="Search users by email" />
                </div>
                <button class="admin-button admin-button-secondary" type="submit" disabled="@isLoadingUsers">Search</button>
            </form>
            @if (isLoadingUsers)
            {
                <LoadingState Message="Loading users..." />
            }
            else if (usersFailure is not null)
            {
                <ApiErrorState Title="@usersFailure.Title" Message="@usersFailure.Message" OnRetry="LoadUsersAsync" />
            }
            else if (users.Count == 0)
            {
                <EmptyState Title="No users found" Message="Try a different search, or create a new account." />
            }
            else
            {
                <div class="user-list">
                    @foreach (var user in users)
                    {
                        <button type="button" class="user-row @(selectedUser?.Id == user.Id ? "selected" : string.Empty)" @onclick="() => SelectUser(user)">
                            <span><strong>@user.Email</strong><small>@(user.Roles.Count == 0 ? "No roles assigned" : string.Join(", ", user.Roles))</small></span>
                            <span class="bi bi-chevron-right" aria-hidden="true"></span>
                        </button>
                    }
                </div>
                <div class="pagination">
                    <span>Showing @users.Count of @totalUsers</span>
                    <div><button type="button" @onclick="PreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button><button type="button" @onclick="NextPageAsync" disabled="@(pageNumber * pageSize >= totalUsers)">Next</button></div>
                </div>
            }
        </section>

        <section class="administration-card" aria-labelledby="create-user-title">
            <div class="card-heading"><div><h2 id="create-user-title">Create user</h2><p>Provide a temporary password directly to the account holder.</p></div><span class="bi bi-person-plus"></span></div>
            <EditForm Model="newUser" OnValidSubmit="CreateUserAsync" class="admin-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-field">
                    <label for="new-user-email">Email address</label>
                    <div class="input-shell"><span class="bi bi-envelope" aria-hidden="true"></span><InputText id="new-user-email" @bind-Value="newUser.Email" type="email" autocomplete="email" placeholder="name@company.com" /></div>
                </div>
                <div class="form-field">
                    <label for="new-user-password">Temporary password</label>
                    <div class="input-shell"><span class="bi bi-key" aria-hidden="true"></span><InputText id="new-user-password" @bind-Value="newUser.TemporaryPassword" type="password" autocomplete="new-password" /></div>
                    <small>Share this securely. It is cleared after submission.</small>
                </div>
                <div class="form-field">
                    <label for="new-user-confirmation">Confirm temporary password</label>
                    <div class="input-shell"><span class="bi bi-check2-circle" aria-hidden="true"></span><InputText id="new-user-confirmation" @bind-Value="newUser.Confirmation" type="password" autocomplete="new-password" /></div>
                </div>
                @if (userFormMessage is not null) { <p class="form-message @userFormMessageClass">@userFormMessage</p> }
                <button class="admin-button" type="submit" disabled="@isCreatingUser">@(isCreatingUser ? "Creating..." : "Create user")</button>
            </EditForm>
        </section>

        <section class="administration-card" aria-labelledby="roles-title">
            <div class="card-heading"><div><h2 id="roles-title">Roles</h2><p>Create and configure reusable access roles.</p></div><span class="bi bi-person-badge"></span></div>
            <form class="create-role" @onsubmit="CreateRoleAsync" @onsubmit:preventDefault="true"><div class="input-shell"><span class="bi bi-person-badge" aria-hidden="true"></span><input @bind="newRoleName" placeholder="e.g. Port operations" aria-label="New role name" /></div><button class="admin-button" type="submit" disabled="@isCreatingRole">Create role</button></form>
            @if (roleFormMessage is not null) { <p class="form-message @roleFormMessageClass">@roleFormMessage</p> }
            @if (isLoadingRoles) { <LoadingState Message="Loading roles..." /> }
            else if (rolesFailure is not null) { <ApiErrorState Title="@rolesFailure.Title" Message="@rolesFailure.Message" OnRetry="LoadRolesAsync" /> }
            else if (roles.Count == 0) { <EmptyState Title="No roles yet" Message="Create a role to begin assigning access." /> }
            else { <div class="role-list">@foreach (var role in roles) { <button type="button" class="role-row @(selectedRole?.Id == role.Id ? "selected" : string.Empty)" @onclick="() => SelectRole(role)"><strong>@role.Name</strong><small>@role.Permissions.Count permissions</small></button> }</div> }
        </section>

        <section class="administration-card administration-editor" aria-labelledby="editor-title">
            @if (selectedUser is not null)
            {
                <div class="card-heading"><div><h2 id="editor-title">User roles</h2><p>@selectedUser.Email</p></div><span class="bi bi-shield-check"></span></div>
                <p class="editor-note">Saving replaces every role currently assigned to this user.</p>
                @foreach (var role in roles)
                {
                    <label class="choice"><input type="checkbox" checked="@selectedRoleNames.Contains(role.Name)" @onchange="e => ToggleRole(role.Name, e.Value)" /> <span>@role.Name</span></label>
                }
                @if (roles.Count == 0) { <EmptyState Title="No roles available" Message="Create a role before assigning it." /> }
                @if (editorMessage is not null) { <p class="form-message @editorMessageClass">@editorMessage</p> }
                @if (confirmUserRoles) { <div class="confirmation"><strong>Replace user roles?</strong><p>This will remove any unselected roles.</p><button class="admin-button" @onclick="SaveUserRolesAsync">Confirm replacement</button><button class="admin-button-link" @onclick="() => confirmUserRoles = false">Cancel</button></div> }
                else { <button class="admin-button" disabled="@(isSaving || roles.Count == 0)" @onclick="() => confirmUserRoles = true">Replace roles</button> }
            }
            else if (selectedRole is not null)
            {
                <div class="card-heading"><div><h2 id="editor-title">Role permissions</h2><p>@selectedRole.Name</p></div><span class="bi bi-key"></span></div>
                <p class="editor-note">Saving replaces every permission assigned to this role.</p>
                @foreach (var capability in PermissionCatalog.GroupBy(permission => permission.Capability))
                {
                    <fieldset><legend>@capability.Key</legend>@foreach (var permission in capability) { <label class="choice"><input type="checkbox" checked="@selectedPermissions.Contains(permission.Name)" @onchange="e => TogglePermission(permission.Name, e.Value)" /> <span>@permission.Action</span></label> }</fieldset>
                }
                @if (editorMessage is not null) { <p class="form-message @editorMessageClass">@editorMessage</p> }
                @if (confirmRolePermissions) { <div class="confirmation"><strong>Replace role permissions?</strong><p>This can immediately change administrator access.</p><button class="admin-button" @onclick="SaveRolePermissionsAsync">Confirm replacement</button><button class="admin-button-link" @onclick="() => confirmRolePermissions = false">Cancel</button></div> }
                else { <button class="admin-button" disabled="@isSaving" @onclick="() => confirmRolePermissions = true">Replace permissions</button> }
            }
            else { <EmptyState Title="Select a user or role" Message="Choose an item to manage its access." /> }
        </section>
    </div>
</section>
}

