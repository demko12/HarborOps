@page "/cargo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessCargo")]
@using HarborOps.Web.Api.Cargo
@implements IDisposable
@inject CargoBookingsApiClient CargoApi
@inject CurrentUserAuthorizationState AuthorizationState
@inject NavigationManager Navigation

<PageTitle>Cargo bookings | HarborOps</PageTitle>

<section class="cargo-page">
    <header class="cargo-header">
        <div>
            <p class="cargo-eyebrow">Cargo operations</p>
            <h1>Your cargo, in motion</h1>
            <p>Bookings, handling requirements, and shipment progress across your operations.</p>
        </div>
        <span class="cargo-utc" aria-label="All times are shown in UTC">UTC</span>
    </header>

    <section class="cargo-summary" aria-label="Booking summary">
        <article class="cargo-summary-card">
            <div>
                <span>Total bookings</span>
                <strong>@totalCount</strong>
                <small>Matching the current filters</small>
            </div>
            <span class="summary-icon summary-icon-orange" aria-hidden="true"><span class="bi bi-box-seam-fill"></span></span>
        </article>
        <article class="cargo-summary-card">
            <div>
                <span>Hazardous bookings</span>
                <strong>@hazardousCount</strong>
                <small>Matching the current filters</small>
            </div>
            <span class="summary-icon summary-icon-amber" aria-hidden="true"><span class="bi bi-exclamation-triangle-fill"></span></span>
        </article>
        <article class="cargo-summary-card">
            <div>
                <span>Cargo weight</span>
                <strong>@((rows.Sum(row => row.WeightKg) / 1000m).ToString("N1", System.Globalization.CultureInfo.InvariantCulture)) <em>t</em></strong>
                <small>On this page · @rows.Count bookings</small>
            </div>
            <span class="summary-icon summary-icon-neutral" aria-hidden="true"><span class="bi bi-speedometer2"></span></span>
        </article>
        <article class="cargo-summary-card">
            <div>
                <span>Packages</span>
                <strong>@(rows.Sum(row => (long)row.PackageCount).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</strong>
                <small>On this page · @rows.Count bookings</small>
            </div>
            <span class="summary-icon summary-icon-neutral" aria-hidden="true"><span class="bi bi-boxes"></span></span>
        </article>
    </section>

    @if (failure is { IsValidation: true, Errors.Count: > 0 })
    {
        <div class="cargo-validation" role="alert">
            <strong>@failure.Title</strong>
            <ul>
                @foreach (var entry in failure.Errors)
                {
                    @foreach (var message in entry.Value)
                    {
                        <li>@message</li>
                    }
                }
            </ul>
        </div>
    }

    <section class="cargo-card" aria-labelledby="cargo-list-title">
        <div class="cargo-card-heading">
            <div class="cargo-register-heading">
                <span class="cargo-card-icon" aria-hidden="true"><span class="bi bi-box-seam"></span></span>
                <div>
                    <span class="cargo-section-label">Shipment overview</span>
                    <h2 id="cargo-list-title">Booking register</h2>
                    <p>@totalCount bookings · Track cargo from registration to delivery</p>
                </div>
            </div>
            <div class="cargo-card-tools">
                @if (AuthorizationState.CanManageCargo)
                {
                    <button id="cargo-register-toggle"
                            class="cargo-register-button"
                            type="button"
                            @onclick="OpenRegisterDialog">
                        <span aria-hidden="true">+</span> Register booking
                    </button>
                }
            </div>
        </div>

        <div class="cargo-filters">
            <div class="filter-field filter-field-grow">
                <label for="cargo-search">Search</label>
                <div class="cargo-input-shell">
                    <span class="bi bi-search" aria-hidden="true"></span>
                    <input id="cargo-search" @bind="search" @bind:event="oninput" @bind:after="ApplyFiltersAsync" placeholder="Booking number or description"
                           aria-label="Search bookings by number or description" />
                </div>
            </div>

            <div class="filter-field">
                <label for="cargo-status">Status</label>
                <select id="cargo-status" @bind="status" @bind:after="ApplyFiltersAsync">
                    <option value="">All statuses</option>
                    @foreach (var option in CargoBookingFormat.Statuses)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <label for="cargo-page-size">Per page</label>
                <select id="cargo-page-size" @bind="pageSize" @bind:after="ApplyFiltersAsync">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <label class="cargo-hazard-toggle" for="cargo-hazardous">
                <input type="checkbox" id="cargo-hazardous" @bind="hazardousOnly" @bind:after="ApplyFiltersAsync" />
                <span class="cargo-placard" aria-hidden="true"></span>
                Hazardous only
            </label>

            <button class="cargo-reset" type="button" @onclick="ClearFiltersAsync" disabled="@isLoading">Reset</button>
        </div>

        @if (isLoading)
        {
            <LoadingState Message="Loading cargo bookings..." />
        }
        else if (failure is not null && !failure.IsValidation)
        {
            <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
        }
        else if (rows.Count == 0)
        {
            <EmptyState Title="No bookings match your filters"
                        Message="Clear the search or choose a different status." />
        }
        else
        {
            <div class="cargo-table-scroll">
                <table class="cargo-table">
                    <caption class="visually-hidden">Registered cargo bookings, newest first</caption>
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col" class="col-description">Description</th>
                            <th scope="col" class="col-type">Cargo type</th>
                            <th scope="col" class="cargo-num">Weight (kg)</th>
                            <th scope="col" class="cargo-num col-packages">Packages</th>
                            <th scope="col">Hazard</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="col-created">Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.CargoBookingId"
                                class="cargo-booking-row @(row.IsHazardous ? "cargo-hazard-row" : null)"
                                role="link"
                                tabindex="0"
                                aria-label="@($"Open {row.BookingNumber} booking details")"
                                @onclick="() => OpenBookingDetails(row.CargoBookingId)"
                                @onkeydown="(args) => HandleBookingRowKeyDown(args, row.CargoBookingId)">
                                <td>
                                    <div class="cargo-identity">
                                        <span class="cargo-row-icon bi @(row.IsHazardous ? "bi-exclamation-triangle-fill" : "bi-box-seam")" aria-hidden="true"></span>
                                        <div>
                                            <a class="cargo-booking-no" href="@DetailsHref(row.CargoBookingId)">@row.BookingNumber</a>
                                            <span class="cargo-voyage">Voyage @CargoBookingFormat.ShortVoyage(row.VoyageId)</span>
                                            @if (row.IsHazardous)
                                            {
                                                <span class="cargo-hazard-flag">Hazardous cargo</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="col-description"><span class="cargo-desc" title="@row.Description">@row.Description</span></td>
                                <td class="cargo-muted col-type"><span class="cargo-type">@row.CargoType</span></td>
                                <td class="cargo-num">@CargoBookingFormat.WeightKg(row.WeightKg)</td>
                                <td class="cargo-num col-packages">@CargoBookingFormat.PackageCount(row.PackageCount)</td>
                                <td>
                                    @if (row.IsHazardous)
                                    {
                                        <span class="cargo-hazard-chip">
                                            <span class="cargo-placard" aria-hidden="true"></span>
                                            @CargoBookingFormat.HazardousLabel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cargo-no-hazard">
                                            <span aria-hidden="true">&mdash;</span>
                                            <span class="visually-hidden">@CargoBookingFormat.NotHazardousLabel</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="cargo-status @CargoBookingFormat.StatusModifier(row.Status)">@row.Status</span>
                                    <span class="cargo-track @CargoBookingFormat.StatusModifier(row.Status)"
                                          role="img"
                                          aria-label="@($"Step {CargoBookingFormat.LifecycleStep(row.Status)} of {CargoBookingFormat.Statuses.Count}")">
                                        @for (var step = 1; step <= CargoBookingFormat.Statuses.Count; step++)
                                        {
                                            <i class="@(step <= CargoBookingFormat.LifecycleStep(row.Status) ? "on" : null)"></i>
                                        }
                                    </span>
                                </td>
                                <td class="cargo-muted col-created">
                                    <span class="cargo-stamp-date">@CargoBookingFormat.CreatedUtcDate(row.CreatedUtc)</span>
                                    <span class="cargo-stamp-time">@CargoBookingFormat.CreatedUtcTime(row.CreatedUtc)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cargo-pagination">
                <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount bookings</span>
                <div class="cargo-pages">
                    <button type="button" @onclick="PreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
                    <span class="cargo-page-indicator">Page @pageNumber of @TotalPages</span>
                    <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
                </div>
            </div>
        }
    </section>

    @if (isRegisterOpen)
    {
        <div class="cargo-modal-backdrop" @onclick="CloseRegisterDialog">
            <section class="cargo-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="cargo-register-title"
                     @onclick:stopPropagation="true">
                <div class="cargo-card-heading">
                    <div>
                        <h2 id="cargo-register-title">Register a booking</h2>
                        <p>Attach cargo to a planned voyage before it sails.</p>
                    </div>
                    <button class="cargo-modal-close"
                            type="button"
                            @onclick="CloseRegisterDialog"
                            disabled="@isRegistering"
                            aria-label="Close register booking dialog">
                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                    </button>
                </div>

                <EditForm EditContext="registerEditContext" OnValidSubmit="SubmitRegistrationAsync">
                    <DataAnnotationsValidator />

                    @if (registerError is not null)
                    {
                        <div class="cargo-register-error" role="alert">@registerError</div>
                    }

                    <div class="cargo-register-grid">
                        <div class="filter-field">
                            <label for="cargo-booking-number">Booking number</label>
                            <InputText id="cargo-booking-number" @bind-Value="registerModel.BookingNumber" />
                            <ValidationMessage For="() => registerModel.BookingNumber" />
                        </div>

                        <div class="filter-field cargo-register-voyage">
                            <label for="cargo-voyage">Voyage</label>
                            <VoyagePicker @ref="voyagePicker"
                                          InputId="cargo-voyage"
                                          Value="registerModel.VoyageId"
                                          ValueChanged="@((Guid? voyageId) => registerModel.VoyageId = voyageId)" />
                            <ValidationMessage For="() => registerModel.VoyageId" />
                        </div>

                        <div class="filter-field filter-field-grow">
                            <label for="cargo-description">Description</label>
                            <InputText id="cargo-description" @bind-Value="registerModel.Description" />
                            <ValidationMessage For="() => registerModel.Description" />
                        </div>

                        <div class="filter-field">
                            <label for="cargo-cargo-type">Cargo type</label>
                            <InputText id="cargo-cargo-type" @bind-Value="registerModel.CargoType" />
                            <ValidationMessage For="() => registerModel.CargoType" />
                        </div>

                        <div class="filter-field">
                            <label for="cargo-weight">Weight (kg)</label>
                            <InputNumber id="cargo-weight" @bind-Value="registerModel.WeightKg" />
                            <ValidationMessage For="() => registerModel.WeightKg" />
                        </div>

                        <div class="filter-field">
                            <label for="cargo-packages">Packages</label>
                            <InputNumber id="cargo-packages" @bind-Value="registerModel.PackageCount" />
                            <ValidationMessage For="() => registerModel.PackageCount" />
                        </div>

                        <label class="cargo-hazard-toggle" for="cargo-is-hazardous">
                            <InputCheckbox id="cargo-is-hazardous" @bind-Value="registerModel.IsHazardous" />
                            <span class="cargo-placard" aria-hidden="true"></span>
                            Hazardous cargo
                        </label>
                    </div>

                    <div class="cargo-modal-actions">
                        <button class="cargo-register-submit" type="submit" disabled="@isRegistering">
                            @(isRegistering ? "Registering..." : "Register booking")
                        </button>
                        <button class="cargo-modal-cancel" type="button" @onclick="CloseRegisterDialog" disabled="@isRegistering">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    }
</section>
