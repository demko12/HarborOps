@page "/cargo"
@using HarborOps.Web.Api.Cargo
@implements IDisposable
@inject CargoBookingsApiClient CargoApi

<PageTitle>Cargo bookings | HarborOps</PageTitle>

<section class="cargo-page">
    <header class="cargo-header">
        <div>
            <p class="cargo-eyebrow">Cargo operations</p>
            <h1>Cargo bookings</h1>
            <p>Search registered bookings and spot hazardous cargo that needs prioritized handling.</p>
        </div>
    </header>

    <div class="cargo-summary">
        <div class="cargo-tile">
            <span class="cargo-tile-label">Total bookings</span>
            <span class="cargo-tile-value">@totalCount</span>
            <span class="cargo-tile-note">Matching the current filters</span>
        </div>
        <div class="cargo-tile cargo-tile-hazard">
            <span class="cargo-tile-label"><span class="cargo-placard" aria-hidden="true"></span> Hazardous on this page</span>
            <span class="cargo-tile-value">@rows.Count(row => row.IsHazardous)</span>
            <span class="cargo-tile-note">Require IMDG handling</span>
        </div>
    </div>

    <div class="cargo-panel">
        <form class="cargo-filters" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault="true">
            <div class="cargo-field cargo-field-grow">
                <label for="cargo-search">Search</label>
                <div class="input-shell">
                    <span class="bi bi-search" aria-hidden="true"></span>
                    <input id="cargo-search" @bind="search" placeholder="Booking number or description"
                           aria-label="Search bookings by number or description" />
                </div>
            </div>

            <div class="cargo-field">
                <label for="cargo-status">Status</label>
                <select id="cargo-status" @bind="status">
                    <option value="">All statuses</option>
                    @foreach (var option in CargoBookingFormat.Statuses)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>

            <div class="cargo-field">
                <label for="cargo-page-size">Per page</label>
                <select id="cargo-page-size" @bind="pageSize">
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>

            <label class="cargo-toggle" for="cargo-hazardous">
                <input type="checkbox" id="cargo-hazardous" @bind="hazardousOnly" />
                <span class="cargo-placard" aria-hidden="true"></span>
                Hazardous only
            </label>

            <button class="cargo-button" type="submit" disabled="@isLoading">Apply</button>
            <button class="cargo-button-link" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
        </form>

        @if (failure is not null && failure.IsValidation)
        {
            <div class="cargo-validation" role="alert">
                <strong>@failure.Title</strong>
                <ul>
                    @foreach (var error in failure.Errors)
                    {
                        @foreach (var message in error.Value)
                        {
                            <li>@message</li>
                        }
                    }
                </ul>
            </div>
        }

        <div class="cargo-panel-head">
            <h2>Results</h2>
            <span class="cargo-count">@totalCount bookings · page @pageNumber of @TotalPages</span>
        </div>

        @if (isLoading)
        {
            <LoadingState Message="Loading cargo bookings..." />
        }
        else if (failure is not null && !failure.IsValidation)
        {
            <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
        }
        else if (rows.Count == 0)
        {
            <EmptyState Title="No bookings match your filters"
                        Message="Clear the search or choose a different status." />
        }
        else
        {
            <div class="cargo-table-scroll">
                <table class="cargo-table">
                    <caption class="visually-hidden">Registered cargo bookings, newest first</caption>
                    <thead>
                        <tr>
                            <th scope="col">Booking</th>
                            <th scope="col">Description</th>
                            <th scope="col">Cargo type</th>
                            <th scope="col" class="cargo-num">Weight (kg)</th>
                            <th scope="col" class="cargo-num">Packages</th>
                            <th scope="col">Hazard</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr class="@(row.IsHazardous ? "cargo-hazard-row" : null)">
                                <td>
                                    <span class="cargo-booking-no">@row.BookingNumber</span>
                                    <span class="cargo-voyage">voyage @CargoBookingFormat.ShortVoyage(row.VoyageId)</span>
                                </td>
                                <td><span class="cargo-desc" title="@row.Description">@row.Description</span></td>
                                <td class="cargo-muted">@row.CargoType</td>
                                <td class="cargo-num">@CargoBookingFormat.WeightKg(row.WeightKg)</td>
                                <td class="cargo-num">@CargoBookingFormat.PackageCount(row.PackageCount)</td>
                                <td>
                                    @if (row.IsHazardous)
                                    {
                                        <span class="cargo-hazard-chip">
                                            <span class="cargo-placard" aria-hidden="true"></span>
                                            @CargoBookingFormat.HazardousLabel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cargo-no-hazard">
                                            <span aria-hidden="true">—</span>
                                            <span class="visually-hidden">@CargoBookingFormat.NotHazardousLabel</span>
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="cargo-status @StatusModifier(row.Status)">
                                        <span class="cargo-status-name">@row.Status</span>
                                        <span class="cargo-track" aria-hidden="true">
                                            @for (var step = 1; step <= CargoBookingFormat.Statuses.Count; step++)
                                            {
                                                <i class="@(step <= CargoBookingFormat.LifecycleStep(row.Status) ? "on" : null)"></i>
                                            }
                                        </span>
                                    </span>
                                </td>
                                <td class="cargo-muted cargo-num">@CargoBookingFormat.CreatedUtc(row.CreatedUtc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cargo-pager">
                <span class="cargo-range">Showing @FirstRowNumber–@LastRowNumber of @totalCount bookings</span>
                <div class="cargo-pages">
                    <button type="button" @onclick="PreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
                    <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
                </div>
            </div>
        }
    </div>
</section>
