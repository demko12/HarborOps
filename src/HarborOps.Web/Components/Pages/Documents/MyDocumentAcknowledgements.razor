@page "/documents/acknowledgements"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessDocuments")]
@using HarborOps.Web.Api.Documents
@inject DocumentsApiClient DocumentsApi

<PageTitle>My document acknowledgements | HarborOps</PageTitle>

<section class="documents-page acknowledgement-page">
    <header class="documents-header">
        <div>
            <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/documents">Documents operations</a><span aria-hidden="true">/</span><span>Acknowledgements</span></nav>
            <h1>My document acknowledgements</h1>
            <p>Review the issued document, then explicitly acknowledge the exact version shown.</p>
        </div>
    </header>

    <section class="documents-filters" aria-label="Acknowledgement filters">
        <div class="filter-field"><label for="ack-state">State</label><select id="ack-state" @bind="state" @bind:after="LoadAsync"><option value="">All states</option><option>Pending</option><option>Acknowledged</option><option>Obsolete</option><option>Cancelled</option></select></div>
        <label class="ack-overdue"><input type="checkbox" @bind="overdueOnly" @bind:after="LoadAsync" /> Overdue only</label>
    </section>

    @if (failure is not null) { <div class="acknowledgement-feedback"><ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="LoadAsync" /></div> }
    @if (isLoading) { <section class="documents-card"><LoadingState Message="Loading acknowledgements..." /></section> }
    else if (items.Count == 0) { <section class="documents-card"><EmptyState Title="No document acknowledgements" Message="Documents issued to you will appear here." /></section> }
    else
    {
        <section class="acknowledgement-list" aria-labelledby="ack-list-title">
            <div class="acknowledgement-list-heading"><h2 id="ack-list-title">Issued documents</h2><p>@totalCount issue(s)</p></div>
            <div class="acknowledgement-grid">
                @foreach (var item in items)
                {
                    <article class="acknowledgement-card">
                        <div class="ack-card-top">
                            <p class="documents-eyebrow">@item.DocumentType</p>
                            <span class="status-badge @StateClass(item.State)">@item.State</span>
                        </div>
                        <h3>@item.DocumentNumber</h3>
                        <p class="ack-due">Due @item.DueDate.ToString("dd MMM yyyy") @if (item.IsOverdue) { <span class="status-badge status-danger">Overdue</span> }</p>
                        @if (!string.IsNullOrWhiteSpace(item.Instruction)) { <p class="ack-instruction">@item.Instruction</p> }
                        @if (!string.IsNullOrWhiteSpace(item.StateReason)) { <p class="ack-reason">@item.StateReason</p> }
                        <div class="ack-actions"><a class="button-secondary" href="/documents">Open document</a>@if (item.State == "Pending") { <button class="button-primary" @onclick="() => confirmIssueId = item.IssueId">Acknowledge</button> }</div>
                    </article>
                }
            </div>
        </section>
    }

    @if (confirmIssueId is { } confirmId)
    {
        var confirmItem = items.FirstOrDefault(item => item.IssueId == confirmId);
        <div class="acknowledgement-modal-backdrop" role="presentation" @onclick="CloseConfirmation">
            <section class="acknowledgement-modal" role="dialog" aria-modal="true" aria-labelledby="ack-confirm-title" @onclick:stopPropagation="true">
                <div class="acknowledgement-modal-header">
                    <div>
                        <h2 id="ack-confirm-title">Confirm acknowledgement</h2>
                        @if (confirmItem is not null) { <p>@confirmItem.DocumentNumber — @confirmItem.DocumentType</p> }
                    </div>
                    <button type="button" class="acknowledgement-modal-close" aria-label="Close acknowledgement dialog" disabled="@isAcknowledging" @onclick="CloseConfirmation">&times;</button>
                </div>
                <p class="acknowledgement-modal-text">You confirm that you reviewed the current issued document. This action is recorded with your account and server time.</p>
                <div class="modal-actions"><button type="button" class="button-primary" disabled="@isAcknowledging" @onclick="AcknowledgeAsync">@(isAcknowledging ? "Acknowledging…" : "Confirm acknowledgement")</button><button type="button" class="button-secondary" disabled="@isAcknowledging" @onclick="CloseConfirmation">Cancel</button></div>
            </section>
        </div>
    }
</section>

@code {
    private IReadOnlyList<DocumentDistributionInboxItemDto> items = [];
    private DocumentsApiFailure? failure;
    private bool isLoading = true, isAcknowledging, overdueOnly;
    private string? state;
    private Guid? confirmIssueId;
    private int totalCount;
    protected override Task OnInitializedAsync() => LoadAsync();
    private static string StateClass(string state) => state switch
    {
        "Pending" => "status-warning",
        "Acknowledged" => "status-success",
        _ => "status-neutral",
    };
    private async Task LoadAsync()
    {
        isLoading = true; failure = null;
        var result = await DocumentsApi.GetMyAcknowledgementsAsync(new DocumentDistributionInboxQuery(state, overdueOnly ? true : null, 1, 100), CancellationToken.None);
        if (result.IsSuccess && result.Value is not null) { items = result.Value.Items; totalCount = result.Value.TotalCount; } else { items = []; failure = result.Failure; }
        isLoading = false;
    }
    private void CloseConfirmation()
    {
        if (!isAcknowledging) confirmIssueId = null;
    }
    private async Task AcknowledgeAsync()
    {
        if (confirmIssueId is not { } issueId) return;
        isAcknowledging = true; failure = null;
        var result = await DocumentsApi.AcknowledgeAsync(issueId, CancellationToken.None);
        isAcknowledging = false;
        if (result.IsSuccess) { confirmIssueId = null; await LoadAsync(); } else failure = result.Failure;
    }
}
