@page "/documents"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AccessDocuments")]
@using HarborOps.Web.Api.Documents
@using HarborOps.Web.Api.Fleet
@implements IDisposable
@inject DocumentsApiClient DocumentsApi
@inject FleetApiClient VesselLookupApi
@inject CurrentUserAuthorizationState AuthorizationState
@inject FleetApiClient FleetApi

<PageTitle>Documents | HarborOps</PageTitle>

<section class="documents-page">
    <header class="documents-header">
        <div>
            <p class="documents-eyebrow">Documents operations</p>
            <h1>Your documents, in order</h1>
            <p>Review vessel documents due to expire within the selected date range.</p>
        </div>
        <div class="documents-header-actions">
            <a class="workspace-tab" href="/documents/acknowledgements">
                <span class="bi bi-check2-square" aria-hidden="true"></span> My acknowledgements
            </a>
        </div>
    </header>

    <DocumentsNavigation />

    <section class="documents-summary" aria-label="Document summary">
        <article class="documents-kpi">
            <div>
                <p class="documents-kpi-label">Matching documents</p>
                <p class="documents-kpi-value">@totalCount</p>
                <p class="documents-kpi-note">Across the current filters</p>
            </div>
            <span class="documents-kpi-icon kpi-icon-info" aria-hidden="true"><span class="bi bi-files"></span></span>
        </article>
        <article class="documents-kpi">
            <div>
                <p class="documents-kpi-label">Expired</p>
                <p class="documents-kpi-value">@rows.Count(row => row.DaysUntilExpiry < 0)</p>
                <p class="documents-kpi-note">On this page</p>
            </div>
            <span class="documents-kpi-icon kpi-icon-danger" aria-hidden="true"><span class="bi bi-calendar-x"></span></span>
        </article>
        <article class="documents-kpi">
            <div>
                <p class="documents-kpi-label">Due within 30 days</p>
                <p class="documents-kpi-value">@rows.Count(row => row.DaysUntilExpiry >= 0 && row.DaysUntilExpiry <= 30)</p>
                <p class="documents-kpi-note">On this page</p>
            </div>
            <span class="documents-kpi-icon kpi-icon-warning" aria-hidden="true"><span class="bi bi-calendar-event"></span></span>
        </article>
        <article class="documents-kpi">
            <div>
                <p class="documents-kpi-label">Pending review</p>
                <p class="documents-kpi-value">@rows.Count(row => row.ReviewStatus == "PendingReview")</p>
                <p class="documents-kpi-note">On this page</p>
            </div>
            <span class="documents-kpi-icon kpi-icon-warning" aria-hidden="true"><span class="bi bi-hourglass-split"></span></span>
        </article>
    </section>



    @if (filterValidationMessage is not null)
    {
        <div class="documents-validation" role="alert">
            <strong>Check the filters</strong>
            <ul>
                <li>@filterValidationMessage</li>
            </ul>
        </div>
    }

    @if (failure is { IsValidation: true, Errors.Count: > 0 })
    {
        <div class="documents-validation" role="alert">
            <strong>@failure.Title</strong>
            <ul>
                @foreach (var entry in failure.Errors)
                {
                    @foreach (var message in entry.Value)
                    {
                        <li>@message</li>
                    }
                }
            </ul>
        </div>
    }

    <section class="documents-card documents-register" aria-labelledby="documents-list-title">
        <div class="documents-card-heading">
            <div class="documents-register-heading">
                <span class="documents-card-icon" aria-hidden="true"><span class="bi bi-file-earmark-text"></span></span>
                <div>
                    <span class="documents-section-label">Document overview</span>
                    <h2 id="documents-list-title">Expiring document register</h2>
                    <p>@totalCount documents found · Within the selected date range</p>
                </div>
            </div>
            <div class="documents-card-tools">
                <button id="documents-register-type-button" type="button" class="documents-register-button" @onclick="ToggleRegisterTypeForm">
                    <span aria-hidden="true">+</span> Register type
                </button>
                <button id="documents-register-document-button" type="button" class="documents-register-button" @onclick="ToggleRegisterDocumentForm">
                    <span aria-hidden="true">+</span> Register document
                </button>
            </div>
        </div>

    <section class="documents-filters documents-register-filters" aria-label="Document filters">
        <div class="filter-field filter-field-wide">
            <label>Vessel</label>
            <VesselPicker @key="filterVesselPickerResetToken"
                          Value="vesselIdFilter"
                          ValueChanged="SelectFilterVesselAsync"
                          Placeholder="Search vessels by name or IMO..."
                          Disabled="isLoading" />
        </div>
        <div class="filter-field">
            <label for="documents-from">From</label>
            <input id="documents-from" type="date" @bind="fromFilter" @bind:after="ScheduleFilterSearchAsync" />
        </div>
        <div class="filter-field">
            <label for="documents-to">To</label>
            <input id="documents-to" type="date" @bind="toFilter" @bind:after="ScheduleFilterSearchAsync" />
        </div>
        <div class="filter-field">
            <label for="documents-review-status">Review status</label>
            <select id="documents-review-status" @bind="pendingReviewStatus" @bind:after="ScheduleFilterSearchAsync">
                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="PendingReview">Pending review</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <button class="documents-filter-reset" type="button" @onclick="ClearFiltersAsync" disabled="@isLoading">Reset</button>
    </section>

        @if (isLoading)
        {
            <LoadingState Message="Loading expiring documents..." />
        }
        else if (failure is not null && !failure.IsValidation)
        {
            <ApiErrorState Title="@failure.Title" Message="@failure.Message" OnRetry="RetryAsync" />
        }
        else if (rows.Count == 0)
        {
            <EmptyState Title="No documents match your filters"
                        Message="Widen the date range or clear the vessel selection." />
        }
        else
        {
            <div class="documents-table-scroll">
                <table class="documents-table">
                    <caption class="visually-hidden">Documents expiring within the selected date range</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="col-number">Number</th>
                            <th scope="col" class="col-vessel">Vessel</th>
                            <th scope="col" class="col-type">Document type</th>
                            <th scope="col" class="col-authority">Issuing authority</th>
                            <th scope="col" class="col-issue">Issue date</th>
                            <th scope="col" class="col-expiry">Expiry date</th>
                            <th scope="col" class="col-status">Status</th>
                            <th scope="col" class="documents-num col-days">Days left</th>
                            <th scope="col" class="col-file">File</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.DocumentId">
                                <td class="col-number"><div class="documents-identity"><span class="bi bi-file-earmark-text" aria-hidden="true"></span><strong>@row.Number</strong></div></td>
                                <td class="col-vessel">@row.VesselDisplayName</td>
                                <td class="documents-muted col-type">@row.DocumentTypeName</td>
                                <td class="documents-muted col-authority">@row.IssuingAuthority</td>
                                <td class="documents-muted col-issue">@row.IssueDate.ToString("dd MMM yyyy")</td>
                                <td class="col-expiry">@row.ExpiryDate.ToString("dd MMM yyyy")</td>
                                <td class="col-status">
                                    <span class="documents-status @GetDocumentStatusClass(row.Status)">@row.Status</span>
                                    <span class="documents-review-status @GetReviewStatusClass(row.ReviewStatus)">@row.ReviewStatus</span>
                                </td>
                                <td class="documents-num col-days">@row.DaysUntilExpiry</td>
                                <td class="col-file">
                                    <button type="button" class="documents-file-toggle"
                                            @onclick="() => OpenFilePanel(row.DocumentId)">
                                        File
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="documents-pagination">
                <span>Showing @FirstRowNumber&ndash;@LastRowNumber of @totalCount documents</span>
                <div class="documents-pages">
                    <button type="button" @onclick="PreviousPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
                    <span class="documents-page-indicator">Page @pageNumber of @TotalPages</span>
                    <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
                </div>
            </div>
        }
    </section>

    @if (expandedDocumentId is { } fileDocumentId)
    {
        <DocumentFilePanel @key="fileDocumentId"
                           DocumentId="fileDocumentId"
                           DocumentTypeOptions="documentTypeOptions"
                           OnClose="CloseFilePanel"
                           OnDocumentChanged="LoadAsync" />
    }

    @if (isRegisterTypeFormOpen)
    {
    <div class="documents-modal-backdrop" role="presentation" @onclick="CloseRegisterTypeForm">
    <section class="documents-type-form-card documents-modal" role="dialog" aria-modal="true" aria-labelledby="documents-type-form-title" @onclick:stopPropagation="true">
        <div class="documents-inline-form-header">
            <h2 id="documents-type-form-title">Register document type</h2>
        </div>

        @if (registerTypeConflictMessage is not null)
        {
            <div class="documents-type-conflict" role="alert">@registerTypeConflictMessage</div>
        }

        @if (registerTypeGeneralError is not null)
        {
            <div class="documents-type-inline-error" role="alert">@registerTypeGeneralError</div>
        }

        @if (registerTypeUnmappedErrors.Count > 0)
        {
            <ul class="documents-type-field-errors" role="alert">
                @foreach (var message in registerTypeUnmappedErrors)
                {
                    <li>@message</li>
                }
            </ul>
        }

        @if (registerTypeSuccessMessage is not null)
        {
            <div class="documents-type-success" role="status">@registerTypeSuccessMessage</div>
        }

        <EditForm EditContext="registerTypeEditContext" OnSubmit="SubmitDocumentTypeAsync" class="documents-type-form">
            <DataAnnotationsValidator />

            <div class="documents-type-form-grid">
                <div class="filter-field">
                    <label for="type-name">Name</label>
                    <InputText id="type-name" @bind-Value="registerTypeModel.Name" maxlength="200" />
                    <ValidationMessage For="() => registerTypeModel.Name" />
                </div>
                <div class="filter-field">
                    <label for="type-issuing-authority">Issuing authority</label>
                    <InputText id="type-issuing-authority" @bind-Value="registerTypeModel.IssuingAuthority" maxlength="200" />
                    <ValidationMessage For="() => registerTypeModel.IssuingAuthority" />
                </div>
                <div class="filter-field">
                    <label for="type-validity-days">Mandatory validity period (days)</label>
                    <InputNumber id="type-validity-days" @bind-Value="registerTypeModel.MandatoryValidityPeriodDays" min="1" max="3650" />
                    <ValidationMessage For="() => registerTypeModel.MandatoryValidityPeriodDays" />
                </div>
                <div class="filter-field">
                    <label id="type-requires-survey-label">Requires survey</label>
                    <div class="documents-type-radio-group" role="group" aria-labelledby="type-requires-survey-label">
                        <InputRadioGroup @bind-Value="registerTypeModel.RequiresSurvey" Name="requires-survey">
                            <label class="documents-type-radio"><InputRadio Value="true" /> Yes</label>
                            <label class="documents-type-radio"><InputRadio Value="false" /> No</label>
                        </InputRadioGroup>
                    </div>
                    <ValidationMessage For="() => registerTypeModel.RequiresSurvey" />
                </div>
            </div>

            <div class="documents-modal-actions">
                <button type="submit" class="documents-search-button" disabled="@isRegisteringType">
                    @(isRegisteringType ? "Registering..." : "Register type")
                </button>
                <button type="button" class="documents-modal-cancel" @onclick="CloseRegisterTypeForm" disabled="@isRegisteringType">Cancel</button>
            </div>
        </EditForm>
    </section>
    </div>
    }

    @if (isRegisterDocumentFormOpen)
    {
        <RegisterDocumentForm DocumentTypeOptions="documentTypeOptions"
                              IsLoadingDocumentTypes="isLoadingDocumentTypes"
                              OnClose="CloseRegisterDocumentForm"
                              OnRegistered="OnDocumentRegisteredAsync" />
    }
</section>
