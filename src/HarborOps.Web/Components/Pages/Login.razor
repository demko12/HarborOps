@page "/login"
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<PageTitle>Sign in | HarborOps</PageTitle>

<section class="login-page">
    <aside class="login-introduction" aria-label="HarborOps">
        <div class="login-wordmark" role="img" aria-label="HarborOps">
<svg viewBox="0 0 190 50" class="logo-svg logo-dark" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="loginStarGradDark" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="rgba(255,255,255,1)" />
					<stop offset="60%" stop-color="rgba(186,220,255,0.95)" />
					<stop offset="100%" stop-color="rgba(96,165,250,0.85)" />
				</linearGradient>
			</defs>
			<path transform="translate(95,13)"
				  d="M0,-12 L0.84,-2.03 L5.3,-5.3 L2.03,-0.84 L12,0 L2.03,0.84 L5.3,5.3 L0.84,2.03 L0,12 L-0.84,2.03 L-5.3,5.3 L-2.03,0.84 L-12,0 L-2.03,-0.84 L-5.3,-5.3 L-0.84,-2.03 Z"
				  fill="url(#loginStarGradDark)" />
			<text x="95" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" letter-spacing="1">
				<tspan font-weight="600" fill="rgba(255,255,255,0.97)">Harbor</tspan><tspan font-weight="400" fill="rgba(147,197,253,0.9)">Ops</tspan>
			</text>
		</svg>
<svg viewBox="0 0 190 50" class="logo-svg logo-light" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="loginStarGradLight" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="rgba(37,99,235,1)" />
					<stop offset="60%" stop-color="rgba(29,78,216,0.95)" />
					<stop offset="100%" stop-color="rgba(30,64,175,0.9)" />
				</linearGradient>
			</defs>
			<path transform="translate(95,13)"
				  d="M0,-12 L0.84,-2.03 L5.3,-5.3 L2.03,-0.84 L12,0 L2.03,0.84 L5.3,5.3 L0.84,2.03 L0,12 L-0.84,2.03 L-5.3,5.3 L-2.03,0.84 L-12,0 L-2.03,-0.84 L-5.3,-5.3 L-0.84,-2.03 Z"
				  fill="url(#loginStarGradLight)" />
			<text x="95" y="44" text-anchor="middle" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" letter-spacing="1">
				<tspan font-weight="600" fill="rgba(15,23,42,0.92)">Harbor</tspan><tspan font-weight="400" fill="rgba(37,99,235,0.95)">Ops</tspan>
			</text>
		</svg>
        </div>
        <div class="login-introduction-copy">
            <p class="login-eyebrow">Maritime operations</p>
            <h1>Your operations.<br />One workspace.</h1>
            <p>Coordinate your fleet, people, and cargo with a connected view of every operation.</p>
            <div class="login-capabilities" aria-label="Workspace capabilities">
                <div><span>01</span><p><strong>Fleet & voyages</strong><small>Vessels, schedules, and port calls.</small></p></div>
                <div><span>02</span><p><strong>People & cargo</strong><small>Crew readiness and shipment oversight.</small></p></div>
                <div><span>03</span><p><strong>Maintenance & compliance</strong><small>Work orders, certificates, and records.</small></p></div>
            </div>
        </div>
        <p class="login-introduction-footer">HarborOps <span>Operations management</span></p>
    </aside>

    <div class="login-access">
        @if (isCompletingLogin)
        {
            <div class="login-state-card"><LoginProgress SessionEstablished="true" /></div>
        }
        else
        {
            <form id="login-form" class="login-card" method="post" action="/session/login" data-enhance="false" onsubmit="document.getElementById('login-pending-state').hidden = false; this.hidden = true; this.setAttribute('aria-busy', 'true'); this.querySelector('button[type=submit]').disabled = true;">
                <input type="hidden" name="@antiforgeryToken.FormFieldName" value="@antiforgeryToken.RequestToken" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <p class="login-access-label">Workspace access</p>
                <h2>Sign in to HarborOps</h2>
                <p class="login-copy">Enter your work account details to continue.</p>
                @if (error is not null)
                {
                    <div class="login-error" role="alert">@error</div>
                }
                <label for="login-email">Email address</label>
                <input id="login-email" name="email" type="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="name@company.com" required />
                <label for="login-password">Password</label>
                <input id="login-password" name="password" type="password" autocomplete="current-password" required />
                <button type="submit">Sign in <span aria-hidden="true">→</span></button>
                <p class="login-help">Need access or help signing in?<br />Contact your workspace administrator.</p>
            </form>
            <div id="login-pending-state" class="login-pending-state login-state-card" hidden>
                <LoginProgress />
            </div>
        }
        <p class="login-access-footer"><span class="bi bi-lock" aria-hidden="true"></span> HarborOps account access</p>
    </div>
</section>

@code {
    private string returnUrl = "/";
    private string? error;
    private bool isCompletingLogin;
    private Microsoft.AspNetCore.Antiforgery.AntiforgeryTokenSet antiforgeryToken = default!;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("An HTTP request is required to render the sign-in form.");
        antiforgeryToken = Antiforgery.GetAndStoreTokens(httpContext);
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        returnUrl = WebAuthenticationEndpoints.SafeReturnUrl(query.TryGetValue("returnUrl", out var value) ? value.ToString() : null);
        isCompletingLogin = query.TryGetValue("success", out var success) && success.ToString() == "1";
        error = query.TryGetValue("error", out var code) ? code.ToString() switch
        {
            "invalid" => "The email or password is incorrect.",
            "required" => "Enter your email and password.",
            "unavailable" => "Sign-in is temporarily unavailable. Please try again.",
            "throttled" => "Too many sign-in attempts. Please wait a moment and try again.",
            _ => null,
        } : null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && isCompletingLogin)
        {
            Navigation.NavigateTo(returnUrl, forceLoad: true);
        }
    }
}
