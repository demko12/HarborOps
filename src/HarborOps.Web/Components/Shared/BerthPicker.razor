@using HarborOps.Web.Api.Voyages
@inject VoyagesApiClient VoyagesApi

<div class="berth-picker">
    <span class="bi bi-search berth-picker-search-icon" aria-hidden="true"></span>
    <input class="berth-picker-input"
           id="@InputId"
           type="text"
           value="@displayText"
           placeholder="@(Placeholder ?? DefaultPlaceholder)"
           disabled="@Disabled"
           autocomplete="off"
           role="combobox"
           aria-expanded="@(isDropdownOpen ? "true" : "false")"
           aria-autocomplete="list"
           @oninput="OnInputAsync"
           @onfocus="OnFocusAsync"
           @onblur="OnBlurAsync" />

    @if (isDropdownOpen)
    {
        <ul class="berth-picker-dropdown" role="listbox">
            @if (isSearching)
            {
                <li class="berth-picker-status">Searching...</li>
            }
            else if (searchFailed)
            {
                <li class="berth-picker-status berth-picker-error">Unable to search berths right now</li>
            }
            else if (results.Count == 0)
            {
                <li class="berth-picker-status">No berths found</li>
            }
            else
            {
                @foreach (var berth in results)
                {
                    <li role="option" @key="berth.BerthId">
                        <button class="berth-picker-option" type="button" @onclick="() => SelectBerthAsync(berth)">
                            <strong>@berth.Name</strong>
                            <span class="berth-picker-meta">@berth.Status</span>
                        </button>
                    </li>
                }
            }
        </ul>
    }
</div>
