@inject FleetApiClient FleetApi

<div class="vessel-picker">
    <span class="bi bi-search vessel-picker-search-icon" aria-hidden="true"></span>
    <input class="vessel-picker-input"
           type="text"
           value="@displayText"
           placeholder="@(Placeholder ?? DefaultPlaceholder)"
           disabled="@Disabled"
           autocomplete="off"
           role="combobox"
           aria-expanded="@(isDropdownOpen ? "true" : "false")"
           aria-autocomplete="list"
           @oninput="OnInputAsync"
           @onfocus="OnFocus"
           @onblur="OnBlurAsync" />

    @if (isDropdownOpen)
    {
        <ul class="vessel-picker-dropdown" role="listbox">
            @if (isSearching)
            {
                <li class="vessel-picker-status">Searching...</li>
            }
            else if (searchFailed)
            {
                <li class="vessel-picker-status vessel-picker-error">Unable to search vessels right now</li>
            }
            else if (results.Count == 0)
            {
                <li class="vessel-picker-status">No vessels found</li>
            }
            else
            {
                @foreach (var vessel in results)
                {
                    <li role="option">
                        <button class="vessel-picker-option" type="button" @onclick="() => SelectVessel(vessel)">
                            <strong>@vessel.Name</strong><span class="vessel-picker-imo">IMO @vessel.ImoNumber &middot; @vessel.FlagState</span>
                        </button>
                    </li>
                }
            }
        </ul>
    }
</div>
